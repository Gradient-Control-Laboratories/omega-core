// Scene Size: 20
// Scene Grid: 10

// A bevel pair carries motion around a corner. Both pitch cones share one
// apex at the origin, so shaftAngle is the angle between the shafts and the
// two pitch angles always add up to it. Drag it and the pair stays in mesh --
// and the gears change size, because a bevel gear's cone distance is fixed by
// its teeth, module and pitch angle rather than being free the way a spur
// gear's thickness is. That is why faceWidth here is a fraction of the cone
// distance instead of a length.

animate = mod(time, 1);

numTeeth1 = 16;
numTeeth1.min = 14;
numTeeth1.max = 30;
numTeeth2 = 24;
numTeeth2.min = 14;
numTeeth2.max = 30;
moduleVal = 0.5;
moduleVal.min = 0.2;
moduleVal.max = 1.0;
pressureAngle = 0.35;
pressureAngle.min = 0.2;
pressureAngle.max = 0.5;

// A right angle by default, but nothing here needs one. The range stops short
// of the shaft angle that would drive the slower gear's pitch cone out toward
// a flat crown, where the back-cone approximation these teeth are built on
// gives out.
shaftAngle = 1.5707963;
shaftAngle.min = 0.9;
shaftAngle.max = 1.75;

// The angle the tooth trace makes with the cone element: 0 is a straight
// bevel, anything else a spiral bevel. Gear 2 is given the opposite hand
// automatically -- a same-hand pair collides instead of meshing.
spiralAngle = 0.5;
spiralAngle.min = -1.0;
spiralAngle.max = 1.0;

// Face width as a fraction of the cone distance; gear practice keeps it
// under about a third.
faceFraction = 0.3;
faceFraction.min = 0.1;
faceFraction.max = 0.4;

// The teeth run out on the two cones normal to the pitch cone, and each of
// those is cut by a flat face set this far along the axis from that end's
// outer tooth-tip corner. Take crownToBack to zero and the back face flattens
// out level with the tips; open it and the face stands proud with the tooth
// heels stepping down to it. recess does the mirror at the small end,
// setting the face back so the teeth project toward the mate.
crownToBack = 0.4;
crownToBack.min = 0.0;
crownToBack.max = 1.5;
recess = 0.4;
recess.min = 0.0;
recess.max = 1.5;

// The hub, which on a bevel gear rides the heel: standoffHeight is what it
// projects past the back face, so zero (with the chamfer taken to zero too)
// is a bare blank.
standoffHeight = 1.2;
standoffHeight.min = 0.0;
standoffHeight.max = 2.5;
standoffDiam1 = 3.0;
standoffDiam2 = 3.6;
standoffChamfer = 0.1;

backlash = 0.025;
boreDiam1 = 1.5;
boreDiam2 = 2.0;
dedendumClearance = 0.25;
kSmall = 0.025;

pitchAngle1 = gears.bevelPitchAngle(numTeeth1, numTeeth2, shaftAngle);
outerCone = numTeeth1 * moduleVal / (2 * sin(pitchAngle1));
faceWidth = outerCone * faceFraction;

g1, g2 = gears.bevelPair(numTeeth1, numTeeth2, moduleVal, pressureAngle, shaftAngle, spiralAngle, faceWidth, crownToBack, recess, backlash, standoffDiam1, standoffDiam2, standoffHeight, standoffChamfer, boreDiam1, boreDiam2, dedendumClearance, kSmall, animate);

return g1, g2;

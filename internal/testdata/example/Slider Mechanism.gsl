// Scene Size: 20
// Scene Grid: 10

slideRadius = 6.00;
slideRadius.min = 4;
slideRadius.max = 8;
baseRadius = 4.00;
baseRadius.min = 2;
baseRadius.max = 6;

slideOffset = 4;

slidePos = 2.02;
slidePos.min = abs(slideRadius - baseRadius) - slideOffset;
slidePos.max = slideRadius + baseRadius - slideOffset;
slidePos.period = 10;

shaftRadius = 0.5;
shaftHalfLen = 6.5;
shaftOffsetX = 3.3;
shaftOffsetY = 1.7;
zSlabHalf = 16;
baseCenterX = -1.7;
baseCenterY = -4;
slideCenterX = -1.7;
markerRadius = 0.3;
armHalfWidth = 0.7;
armHalfThick = 0.8;
shaftCenterX = -3.3;
couplerHeight = 1.6;
couplerWidth = 1.4;

cylinder_y(radius, halfLen) {
  return max(cylinderY(vector.zero, radius), abs(p.y) - halfLen);
}

zSlab = abs(p.z) - zSlabHalf;

shaft = remap(cylinder_y(shaftRadius, shaftHalfLen), [p.x + shaftOffsetX, p.y - shaftOffsetY, p.z]);

baseCenter = [baseCenterX, baseCenterY];
r1 = baseRadius;

slideCenterF(v) {
  return [slideCenterX, v];
}

slideCenter = remap(slideCenterF(slidePos), p - [0, 0, slidePos]);
r2 = slideRadius;

cylBase = length(p.xy - baseCenter) - r1;
cylSlide = length(p.xy - slideCenter - [0, p.z]) - r2;
cyls = min(cylBase, cylSlide);
dist, angle = normalizeCurve(cylBase, cylSlide);
cylpath = dist - 0.02;

infCyl = max(abs(cyls) - 0.02, zSlab) * 0.5;

dx_c = slideCenter.x - baseCenter.x;
dy_c = slideCenter.y - baseCenter.y;
d = sqrt(dx_c * dx_c + dy_c * dy_c);

a = (r1 * r1 - r2 * r2 + d * d) / (2 * d);
h = sqrt(r1 * r1 - a * a);

mx = baseCenter.x + a * (dx_c / d);
my = baseCenter.y + a * (dy_c / d);

perpX = -(dy_c / d);
perpY = (dx_c / d);

intPt = [mx - h * perpX, my - h * perpY];

intersectionMarker = remap(sphere(markerRadius), [p.x - intPt.x, p.y - intPt.y, p.z]);

arm(ax, ay, bx, by, halfWidth, halfThick) {
  va = [ax, ay];
  vb = [bx, by];
  ab = vb - va;
  ap = p.xy - va;
  t = clamp(dot(ap, ab) / dot(ab, ab), 0, 1);
  np = va + t * ab;
  d2d = length(p.xy - np);
  dPerp = d2d - halfWidth;
  dZ = abs(p.z) - halfThick;
  return max(dPerp, dZ);
}

// 3D distance to a line segment (capsule), diameter = height
coupler(x0, x1, y, height, width) {
  va = [x0, y, 0];
  vb = [x1, y, 0];
  ab = vb - va;
  ap = p - va;
  t = clamp(dot(ap, ab) / dot(ab, ab), 0, 1);
  np = va + t * ab;
  cap0 = length(p.xy - np.xy) - width/ 2;
  cap1 = length(p.zx - np.zx) - height/ 2;
  slab0 = abs(p.z) - height / 2;
  slab1 = abs(p.y - y) - width / 2;
  return t > 0.5 ? max(cap0, slab0) : max(cap1, slab1);
}

lowerArm = arm(baseCenter.x, baseCenter.y, intPt.x, intPt.y, armHalfWidth, armHalfThick);
upperArm = arm(slideCenter.x, slideCenter.y, intPt.x, intPt.y, armHalfWidth, armHalfThick);

shaftCenter = [shaftCenterX, 0];
couplerArmBase = coupler(shaftCenter.x, baseCenter.x, baseCenter.y, couplerHeight, couplerWidth);
couplerArmSlider = coupler(shaftCenter.x, baseCenter.x, slideCenter.y, couplerHeight, couplerWidth);

return shaft, intersectionMarker, lowerArm, upperArm, couplerArmSlider, couplerArmBase, cylpath; //, infCyl;
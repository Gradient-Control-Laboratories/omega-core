// Scene Size: 20
// Scene Grid: 10

// Kirchhoff-Love vibrating plate simulation
plateW = 3.00;
plateW.min = 2.0;
plateW.max = 6.0;
plateW.period = 12;
plateD = 5.00;
plateD.min = 2.0;
plateD.max = 6.0;
plateD.period = 11;
plateH = 0.05;

// Edge boundary conditions: 0 = free, 1 = fixed (pinned)
// Left = -X edge, Right = +X edge, Front = -Y edge, Back = +Y edge
fixLeft = 1.0;
fixRight = 0.0;
fixFront = 1.0;
fixBack = 0.0;

plate(hw, hd, hh) {
  q = [abs(p.x) - hw, abs(p.y) - hd, abs(p.z) - hh];
  return length(max(q, [0,0,0])) + min(max(q.x, max(q.y, q.z)), 0);
}

// --- Sphere primitive ---

// --- Boundary condition capsules on edges ---
// Left edge: x = -plateW, runs along Y from -plateD to +plateD
rLeft = fixLeft * plateH;
leftCyl = cylinderRounded([-plateW, -plateD, 0], [-plateW, plateD, 0], rLeft);

// Right edge: x = +plateW, runs along Y
rRight = fixRight * plateH;
rightCyl = cylinderRounded([plateW, -plateD, 0], [plateW, plateD, 0], rRight);

// Front edge: y = -plateD, runs along X from -plateW to +plateW
rFront = fixFront * plateH;
frontCyl = cylinderRounded([-plateW, -plateD, 0], [plateW, -plateD, 0], rFront);

// Back edge: y = +plateD, runs along X
rBack = fixBack * plateH;
backCyl = cylinderRounded([-plateW, plateD, 0], [plateW, plateD, 0], rBack);

// Union of all boundary capsules
theBoundaryCylinders = min(leftCyl, rightCyl, frontCyl, backCyl);

ballR = 0.3;
bounceRate = 0.9;

// Repeating local time 0..1 for each bounce cycle
tLocal = fract(bounceRate * time);

// Parabolic vertical trajectory
u = 2.0 * tLocal - 1.0;
minZ = plateH + ballR;
bounceH = 3.5;
ballZ = minZ + bounceH * (1.0 - u * u);

// Horizontal X movement: triangle wave sweeping between -plateW and +plateW
horizRateX = 0.23;
horizPhaseX = fract(horizRateX * time);
triWaveX = abs(2.0 * horizPhaseX - 1.0);
ballX = plateW * (2.0 * triWaveX - 1.0);

// Horizontal Y movement: triangle wave sweeping between -plateD and +plateD
horizRateY = 0.17;
horizPhaseY = fract(horizRateY * time);
triWaveY = abs(2.0 * horizPhaseY - 1.0);
ballY = plateD * (2.0 * triWaveY - 1.0);

ballPos = [ballX, ballY, ballZ];
ballShape = sphere(ballR);
theBall = remap(ballShape, p - ballPos);

// --- Compute strike position (where ball was at start of this bounce) ---
bounceStartTime = (time - tLocal / bounceRate);
horizPhaseXAtHit = fract(horizRateX * bounceStartTime);
triWaveXAtHit = abs(2.0 * horizPhaseXAtHit - 1.0);
hitX = plateW * (2.0 * triWaveXAtHit - 1.0);

horizPhaseYAtHit = fract(horizRateY * bounceStartTime);
triWaveYAtHit = abs(2.0 * horizPhaseYAtHit - 1.0);
hitY = plateD * (2.0 * triWaveYAtHit - 1.0);

// --- Kirchhoff-Love natural frequencies ---
a = 2.0 * plateW;
b = 2.0 * plateD;
baseCoeff = 3227.0;

freq(m, n) {
  return (pi / 2.0) * (m * m / (a * a) + n * n / (b * b)) * baseCoeff;
}

// --- Per-edge basis functions ---
// X basis: accounts for fixLeft (-X) and fixRight (+X) independently
// normalized coordinate: 0 at left edge, 1 at right edge
basisX(m) {
  nx = (p.x + a / 2.0) / a;
  // Both fixed: sin(m*pi*nx) vanishes at 0 and 1
  bothFixed = sin(m * pi * nx);
  // Left fixed, right free: sin((m - 0.5)*pi*nx) vanishes at 0
  leftOnly = sin((m - 0.5) * pi * nx);
  // Right fixed, left free: sin((m - 0.5)*pi*(1.0 - nx)) vanishes at 1
  rightOnly = sin((m - 0.5) * pi * (1.0 - nx));
  // Both free: cos(m*pi*nx)
  bothFree = cos(m * pi * nx);
  return fixLeft * fixRight * bothFixed + fixLeft * (1.0 - fixRight) * leftOnly + (1.0 - fixLeft) * fixRight * rightOnly + (1.0 - fixLeft) * (1.0 - fixRight) * bothFree;
}

basisY(n) {
  ny = (p.y + b / 2.0) / b;
  bothFixed = sin(n * pi * ny);
  frontOnly = sin((n - 0.5) * pi * ny);
  backOnly = sin((n - 0.5) * pi * (1.0 - ny));
  bothFree = cos(n * pi * ny);
  return fixFront * fixBack * bothFixed + fixFront * (1.0 - fixBack) * frontOnly + (1.0 - fixFront) * fixBack * backOnly + (1.0 - fixFront) * (1.0 - fixBack) * bothFree;
}

basisXatHit(m) {
  nx = (hitX + a / 2.0) / a;
  bothFixed = sin(m * pi * nx);
  leftOnly = sin((m - 0.5) * pi * nx);
  rightOnly = sin((m - 0.5) * pi * (1.0 - nx));
  bothFree = cos(m * pi * nx);
  return fixLeft * fixRight * bothFixed + fixLeft * (1.0 - fixRight) * leftOnly + (1.0 - fixLeft) * fixRight * rightOnly + (1.0 - fixLeft) * (1.0 - fixRight) * bothFree;
}

basisYatHit(n) {
  ny = (hitY + b / 2.0) / b;
  bothFixed = sin(n * pi * ny);
  frontOnly = sin((n - 0.5) * pi * ny);
  backOnly = sin((n - 0.5) * pi * (1.0 - ny));
  bothFree = cos(n * pi * ny);
  return fixFront * fixBack * bothFixed + fixFront * (1.0 - fixBack) * frontOnly + (1.0 - fixFront) * fixBack * backOnly + (1.0 - fixFront) * (1.0 - fixBack) * bothFree;
}

modeWeight(m, n) {
  return basisXatHit(m) * basisYatHit(n);
}

// Audio frequencies (physical)
f11 = freq(1, 1);
f21 = freq(2, 1);
f12 = freq(1, 2);
f31 = freq(3, 1);
f22 = freq(2, 2);
f13 = freq(1, 3);
f41 = freq(4, 1);
fr32 = freq(3, 2);
f23 = freq(2, 3);
f51 = freq(5, 1);
f42 = freq(4, 2);
f33 = freq(3, 3);
f14 = freq(1, 4);
f52 = freq(5, 2);
f43 = freq(4, 3);

// --- Visual frequencies (halved) ---
invA2 = 1.0 / (a * a);
invB2 = 1.0 / (b * b);
baseRatio = invA2 + invB2;

vfreq(m, n) {
  return 0.5 * bounceRate * (m * m * invA2 + n * n * invB2) / baseRatio;
}

vf11 = vfreq(1, 1);
vf21 = vfreq(2, 1);
vf12 = vfreq(1, 2);
vf31 = vfreq(3, 1);
vf22 = vfreq(2, 2);
vf13 = vfreq(1, 3);
vf41 = vfreq(4, 1);
vf32 = vfreq(3, 2);
vf23 = vfreq(2, 3);
vf51 = vfreq(5, 1);
vf42 = vfreq(4, 2);
vf33 = vfreq(3, 3);
vf14 = vfreq(1, 4);
vf52 = vfreq(5, 2);
vf43 = vfreq(4, 3);

w11 = modeWeight(1, 1);
w21 = modeWeight(2, 1);
w12 = modeWeight(1, 2);
w31 = modeWeight(3, 1);
w22 = modeWeight(2, 2);
w13 = modeWeight(1, 3);
w41 = modeWeight(4, 1);
w32 = modeWeight(3, 2);
w23 = modeWeight(2, 3);
w51 = modeWeight(5, 1);
w42 = modeWeight(4, 2);
w33 = modeWeight(3, 3);
w14 = modeWeight(1, 4);
w52 = modeWeight(5, 2);
w43 = modeWeight(4, 3);

// Time since last strike
tEnv = tLocal / bounceRate;

// Decay envelopes
decayTau = 0.25;
decay1 = exp(-tEnv / decayTau);
decay2 = exp(-tEnv / (decayTau * 0.6));
decay3 = exp(-tEnv / (decayTau * 0.35));
decay4 = exp(-tEnv / (decayTau * 0.22));
decay5 = exp(-tEnv / (decayTau * 0.15));

// --- Plate surface displacement ---
modeShape(m, n) {
  return basisX(m) * basisY(n);
}

dispAmp = -5;

ms11 = modeShape(1, 1);
ms21 = modeShape(2, 1);
ms12 = modeShape(1, 2);
ms31 = modeShape(3, 1);
ms22 = modeShape(2, 2);
ms13 = modeShape(1, 3);
ms41 = modeShape(4, 1);
ms32 = modeShape(3, 2);
ms23 = modeShape(2, 3);
ms51 = modeShape(5, 1);
ms42 = modeShape(4, 2);
ms33 = modeShape(3, 3);
ms14 = modeShape(1, 4);
ms52 = modeShape(5, 2);
ms43 = modeShape(4, 3);

d11 = 0.35 * w11 * decay1 * sin(tau * vf11 * tEnv) * ms11;
d21 = 0.28 * w21 * decay1 * sin(tau * vf21 * tEnv) * ms21;
d12 = 0.28 * w12 * decay1 * sin(tau * vf12 * tEnv) * ms12;
d31 = 0.22 * w31 * decay2 * sin(tau * vf31 * tEnv) * ms31;
d22 = 0.20 * w22 * decay2 * sin(tau * vf22 * tEnv) * ms22;
d13 = 0.20 * w13 * decay2 * sin(tau * vf13 * tEnv) * ms13;
d41 = 0.15 * w41 * decay3 * sin(tau * vf41 * tEnv) * ms41;
d32 = 0.14 * w32 * decay3 * sin(tau * vf32 * tEnv) * ms32;
d23 = 0.14 * w23 * decay3 * sin(tau * vf23 * tEnv) * ms23;
d51 = 0.10 * w51 * decay4 * sin(tau * vf51 * tEnv) * ms51;
d42 = 0.10 * w42 * decay4 * sin(tau * vf42 * tEnv) * ms42;
d33 = 0.10 * w33 * decay4 * sin(tau * vf33 * tEnv) * ms33;
d14 = 0.08 * w14 * decay4 * sin(tau * vf14 * tEnv) * ms14;
d52 = 0.06 * w52 * decay5 * sin(tau * vf52 * tEnv) * ms52;
d43 = 0.06 * w43 * decay5 * sin(tau * vf43 * tEnv) * ms43;

disp = dispAmp * (d11 + d21 + d12 + d31 + d22 + d13 + d41 + d32 + d23 + d51 + d42 + d33 + d14 + d52 + d43);

// Displace plate
thePlate = remap(plate(plateW, plateD, plateH), [p.x, p.y, p.z - disp]);

// --- Nodal line visualization ---
nodalThreshold = 0.015;
nodalHeight = 0.12;
nodalHalfH = nodalHeight / 2.0;

nodalSlab(hw, hd, hh) {
  q = [abs(p.x) - hw, abs(p.y) - hd, abs(p.z) - hh];
  return length(max(q, [0,0,0])) + min(max(q.x, max(q.y, q.z)), 0);
}

nodalBase = remap(nodalSlab(plateW, plateD, nodalHalfH), [p.x, p.y, p.z - disp - plateH - nodalHalfH]);

nodalMask = abs(disp) - nodalThreshold;

overallEnvelope = decay1;
activeNodalMask = abs(disp) / (max(overallEnvelope, 0.01)) - nodalThreshold;

theNodalLines = max(nodalBase, activeNodalMask);

// --- Audio synthesis ---
s11 = 0.35 * w11 * decay1 * sin(tau * f11 * tEnv);
s21 = 0.28 * w21 * decay1 * sin(tau * f21 * tEnv);
s12 = 0.28 * w12 * decay1 * sin(tau * f12 * tEnv);
s31 = 0.22 * w31 * decay2 * sin(tau * f31 * tEnv);
s22 = 0.20 * w22 * decay2 * sin(tau * f22 * tEnv);
s13 = 0.20 * w13 * decay2 * sin(tau * f13 * tEnv);
s41 = 0.15 * w41 * decay3 * sin(tau * f41 * tEnv);
s32 = 0.14 * w32 * decay3 * sin(tau * fr32 * tEnv);
s23 = 0.14 * w23 * decay3 * sin(tau * f23 * tEnv);
s51 = 0.10 * w51 * decay4 * sin(tau * f51 * tEnv);
s42 = 0.10 * w42 * decay4 * sin(tau * f42 * tEnv);
s33 = 0.10 * w33 * decay4 * sin(tau * f33 * tEnv);
s14 = 0.08 * w14 * decay4 * sin(tau * f14 * tEnv);
s52 = 0.06 * w52 * decay5 * sin(tau * f52 * tEnv);
s43 = 0.06 * w43 * decay5 * sin(tau * f43 * tEnv);

signal = (s11 + s21 + s12 + s31 + s22 + s13 + s41 + s32 + s23 + s51 + s42 + s33 + s14 + s52 + s43) * 0.5;

// --- Stereo ---
audioShift = 0.003;
t2 = time - audioShift;
tLocal2 = (t2 > 0.0) ? fract(bounceRate * t2) : 0.0;
tEnv2 = tLocal2 / bounceRate;

decay1b = exp(-tEnv2 / decayTau);
decay2b = exp(-tEnv2 / (decayTau * 0.6));
decay3b = exp(-tEnv2 / (decayTau * 0.35));
decay4b = exp(-tEnv2 / (decayTau * 0.22));
decay5b = exp(-tEnv2 / (decayTau * 0.15));

s11b = 0.35 * w11 * decay1b * sin(tau * f11 * tEnv2);
s21b = 0.28 * w21 * decay1b * sin(tau * f21 * tEnv2);
s12b = 0.28 * w12 * decay1b * sin(tau * f12 * tEnv2);
s31b = 0.22 * w31 * decay2b * sin(tau * f31 * tEnv2);
s22b = 0.20 * w22 * decay2b * sin(tau * f22 * tEnv2);
s13b = 0.20 * w13 * decay2b * sin(tau * f13 * tEnv2);
s41b = 0.15 * w41 * decay3b * sin(tau * f41 * tEnv2);
s32b = 0.14 * w32 * decay3b * sin(tau * fr32 * tEnv2);
s23b = 0.14 * w23 * decay3b * sin(tau * f23 * tEnv2);
s51b = 0.10 * w51 * decay4b * sin(tau * f51 * tEnv2);
s42b = 0.10 * w42 * decay4b * sin(tau * f42 * tEnv2);
s33b = 0.10 * w33 * decay4b * sin(tau * f33 * tEnv2);
s14b = 0.08 * w14 * decay4b * sin(tau * f14 * tEnv2);
s52b = 0.06 * w52 * decay5b * sin(tau * f52 * tEnv2);
s43b = 0.06 * w43 * decay5b * sin(tau * f43 * tEnv2);

signalR = (s11b + s21b + s12b + s31b + s22b + s13b + s41b + s32b + s23b + s51b + s42b + s33b + s14b + s52b + s43b) * 0.5;

panL = 0.5 - hitX / (2.0 * plateW);
panR = 0.5 + hitX / (2.0 * plateW);

return thePlate, theBall, theNodalLines, theBoundaryCylinders, audio(signal * panL, signalR * panR);

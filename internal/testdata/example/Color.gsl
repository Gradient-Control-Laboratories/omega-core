// Scene Size: 20
// Scene Grid: 10

height = 0.7;
height.min = -5;
height.max = 5;
height.period = 3;
ballrad = 1.3;
ballrad.min = 0;
ballrad.max = 5;
// ballrad.period = 3;

flr = p.z;
period = 2;
checkerboard = map.triangleWave(p.x, period) * map.triangleWave(p.y, period);
flr.color = checkerboard ? color.gray : color.lightGray ;

cellular = noise.cellularEdges(1);
ball = sphere(5);
ball.color = color.viridis(cellular * 1.2);

ballSpike = ball + cellular * 0.2;
ballRot = remap(ballSpike, map.rotateZX(p, time * 0.5));
ballTrans = remap(ballRot, p - height * vector.dirZ);

ball2 = sphere([6, 0, 2], 2);
balls = unionRound([ballTrans, ball2], ballrad);
body = unionRound([balls, flr], ballrad);

bodyAlt = unionRound([ballTrans, ball2, flr], ballrad);

return body;

// Scene Size: 120
// Scene Grid: 10

// A sample board of holes, one to a tile. Each is written the way a drawing
// calls one out: a list of features, every depth measured from the face the
// hole opens onto rather than from the feature above it, so the numbers here
// are the numbers on the print and the order of the list does not change the
// geometry. Omitting a depth means THRU.
//
// Drag holeDia and the through-holes, the keyway that is cut from one, and the
// spline minor all follow it, because each feature is given the diameter it
// actually needs rather than inheriting one.
//
// Everything drill returns is a VOID SOLID — the material to remove — so each
// tile is max(tile, -drill.hole(...)). A screw's hole from fastener is one of
// these holes, sized by the screw instead of by a drawing.

holeDia = 9.0;
holeDia.min = 6.0;
holeDia.max = 12.0;

// COUNTERBORE: a socket head sits in the pocket, the undercut relieves its
// corner, and the lower chamfer leads into the bore at the pocket floor --
// which is why it is chamferAt and not chamfer. A chamfer belongs to the face
// its bore starts on.
counterbored = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.chamfer(16.0, 0.6),
                            drill.bore(16.0, 5.0),
                            drill.undercut(17.4, 4.0, 5.0),
                            drill.chamferAt(holeDia, 0.5, 5.0),
                            drill.thru(holeDia)], 0.0)));
}(), [p.x + 39.0, p.y - 13.0, p.z]);
counterbored.color = [0.62, 0.64, 0.68];

// COUNTERSINK: diameter and included angle, as a drawing spells it. The depth
// is derived and is never called out.
countersunk = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.countersink(17.0, radians(90.0)),
                            drill.thru(holeDia)], 0.0)));
}(), [p.x + 13.0, p.y - 13.0, p.z]);
countersunk.color = [0.55, 0.58, 0.64];

// TAPPED: the drill and the thread are two separate lines on a callout, so
// they are two features here. drill.tap bores at the thread's basic MINOR
// diameter — the tapped hole at maximum material, the geometry every proof
// sees — and the thread itself is a displacement on the tile's material,
// thread.femaleRelief, which only the renderer reads. The relief is set before
// the tile is placed, so it moves with it.
tappedTile = max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
                 neg(drill.hole([drill.chamfer(9.0, 0.7),
                                drill.tap(8.0, 1.25, 10.0),
                                drill.blind(6.8, 12.0)], 0.0)));
tappedTile.material = material.withDisplacement(material.standard,
                                                thread.femaleRelief(8.0, 1.25, 0.0, -10.0));
tappedTile.color = thread.reliefColor([0.48, 0.52, 0.58],
                                     thread.femaleRelief(8.0, 1.25, 0.0, -10.0), 1.25);
tapped = remap(tappedTile, [p.x - 13.0, p.y - 13.0, p.z]);

// HEX: six half-planes, sized ACROSS FLATS as a socket is. A broached hex, a
// hex drive, or a nut pocket.
hexed = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.chamfer(14.0, 0.5),
                            drill.hexSocket(12.0, 6.0),
                            drill.thru(holeDia)], 0.0)));
}(), [p.x - 39.0, p.y - 13.0, p.z]);
hexed.color = [0.42, 0.46, 0.54];

// D-FLAT: a bore with one flat, the internal counterpart to a D-shaft and the
// usual anti-rotation feature for a knob. acrossFlat runs from the flat to the
// far side of the bore.
dFlatted = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.chamfer(14.0, 0.5),
                            drill.dFlat(12.0, 9.6)], 0.0)));
}(), [p.x + 39.0, p.y + 13.0, p.z]);
dFlatted.color = [0.66, 0.62, 0.56];

// SPLINE: DIN 5463 parallel sides. The grooves are their own feature, so the
// bore they are cut from reads as its own line -- the way the drawing has a
// spline table beside the hole rather than inside it. Cut THROUGH, like the
// bore: a groove stopped at exactly the far face would leave an infinitely
// thin web there.
splined = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.chamfer(holeDia + 3.0, 0.5),
                            drill.thru(holeDia),
                            drill.spline(6.0, holeDia + 3.6, 2.6)], 0.0)));
}(), [p.x + 13.0, p.y + 13.0, p.z]);
splined.color = [0.60, 0.56, 0.50];

// KEYWAY: one slot, not a symmetric pair, cut radially outward from the bore
// it belongs to, and through, for the same reason the spline is. It is given
// that bore's diameter because a keyway is dimensioned on its own detail
// rather than stacked on the callout.
keyed = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.chamfer(holeDia + 3.0, 0.5),
                            drill.thru(holeDia),
                            drill.keyway(3.6, 1.8, holeDia)], 0.0)));
}(), [p.x - 13.0, p.y + 13.0, p.z]);
keyed.color = [0.52, 0.50, 0.46];

// SLOT: an obround, dimensioned by the distance between its end centres as a
// drawing does, not by overall length. Its chamfer FOLLOWS it: a round chamfer
// on a slot breaks the edge at the two ends and cuts a crescent out of the
// face along the straight, which is not an edge break at all.
slotted = remap(() {
  return max(boxCentered([0.0, 0.0, -7.0], [24.0, 24.0, 14.0]),
             neg(drill.hole([drill.slotChamfer(holeDia, 10.0, 0.0, 0.4),
                            drill.slot(holeDia, 10.0, 0.0)], 0.0)));
}(), [p.x - 39.0, p.y + 13.0, p.z]);
slotted.color = [0.70, 0.68, 0.64];

return counterbored, countersunk, tapped, hexed,
       dFlatted, splined, keyed, slotted;

// Scene Size: 40
// Scene Grid: 20
// The symmetry maps in the `map` library. An asymmetric motif at the origin is
// replicated two ways: patternPolarXY (N-fold rotation about Z, left) and
// patternRectangularXY (mirror-tiled grid, right). Because the motif is
// asymmetric you can read the rotational and mirror symmetries directly.

folds = 8;        // rotational symmetry order for the rosette
cell = 6;         // grid pitch for the tiling

// An off-center bar + dot, extruded a little through Z.
motif() {
  bar = rectangleXYCentered([1.6, 0], [3, 0.7]);
  blob = circleXY([0, 2.2], 0.7);
  flat = min(bar, blob);
  return max(flat, abs(p.z) - 0.5);
}

// N-fold polar rosette, placed to the left and clipped to a disk.
rosette = remap(motif(), map.patternPolarXY(folds));
rosetteDisk = max(rosette, length(p.xy) - 11);
rosettePlaced = remap(rosetteDisk, [p.x + 13, p.y, p.z]);

// Mirror-tiled grid, placed to the right and clipped to a square block.
tiled = remap(motif(), map.patternRectangularXY([cell, cell]));
tiledBlock = max(tiled, boxCentered([0, 0, 0], [22, 22, 1.2]));
tiledPlaced = remap(tiledBlock, [p.x - 13, p.y, p.z]);

return rosettePlaced, tiledPlaced;
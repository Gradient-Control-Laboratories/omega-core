// Scene Size: 50
// Scene Grid: 10
import "lattice";
import "lattice/spinodoid";

// A 30 mm spinodoid block whose cell size is set by a few control points on
// its surface. Each point carries a Gaussian radial basis function with its
// own weight: a negative weight refines the cells around the point, a positive
// one coarsens them. The weighted sum modulates the local scale (1 where no
// point reaches), clamped to stay positive and below the 1.5 past which a
// packet holds under two waves.
block = box([-15, -15, -15], [15, 15, 15]);

// The control points, and each one's weight.
points = [
  [0, 0, 15],       // top face: finer
  [15, 0, 0],       // +x face: coarser
  [-15, -15, -15],  // corner: finer
  [0, -15, 5]       // -y face: coarser
];
weights = [-0.5, 0.4, -0.4, 0.3];

reach = 8;
bump(center, weight) {
  r = p - center;
  return weight * exp(-dot(r, r) / (2 * reach * reach));
}

bumps = map((center, i) { return bump(center, weights[i]); }, points);
refine = clamp(reduce(1, (sum, b) { return sum + b; }, bumps), 0.4, 1.4);

upright = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
isotropic = spinodoid.gaborGraded(6, [pi / 2, pi / 2, pi / 2], refine, upright);
specimen = max(block, lattice.solidify(isotropic, 0, 0.6));

// A second body showing the control points: their union, offset to small balls.
markers = reduce(1e9, (nearest, center) { return min(nearest, length(p - center)); }, points) - 1.5;

return specimen, markers;

// Scene Size: 500
// Scene Grid: 50

// A 3D printer's gantry: aluminum T-slot extrusions joined by plates and M5
// screws, with a hotend on a carriage riding the X beam.
//
// The frame is 20-series extrusion. A 2020 is 20 mm a side with a slot down
// the middle of every face, a 6.2 mm opening behind a 1.8 mm lip that a T-nut
// turns into, and a 4.2 mm bore through the core that an M5 tap threads for a
// screw driven into the end. A 2040 is two of them side by side. A base of
// 2020 carries two 2040 uprights, a 2020 beam spans their tops, and the X
// gantry, another 2020, rides between them at the height `lift` sets.
//
// Every joint is a 5 mm plate and M5 button head screws into the slots behind
// it. The front and back base beams are held the way printer frames usually
// are, by an M5 x 30 cap screw through the side rail into the beam's end bore.
//
// THE SCREWS AND PLATES ARE THE SMALL PARTS. Each is its own named part, and a
// part is as small as its thinnest side, so pull the view back and the 5 mm
// plates thin away first, then the screws, and the 20 mm extrusions last;
// Render > Small parts at Keep draws every one of them whole at any size. Only five objects are painted, the frame, the plates, the
// screws, the hotend and its nozzle, since a colour on each of forty-odd parts
// is what makes a shader too big to compile.

// The floor, and the two sliders: how high the gantry rides above it, and
// where the carriage is along it.

aluminumMat, aluminumColor = metal.aluminum();
steelMat, steelColor = metal.steel();
brassMat, brassColor = metal.brass();

z0 = -200.0;
lift = 180.0;
lift.min = 60.0;
lift.max = 300.0;
travel = 0.0;
travel.min = -110.0;
travel.max = 110.0;
gz = z0 + lift;

// =========================================================
// T-slot extrusion
// =========================================================

// slot: one T-slot, as a solid to take away. `u` is the distance from the core
// toward the face (the face is at u = 10) and `v` runs along it.
slot(u, v) {
  opening = max(abs(u - 9.35) - 1.15, abs(v) - 3.1);
  cavity = max(abs(u - 6.05) - 2.15, abs(v) - 5.5);
  return min(opening, cavity);
}

// section2020: a 2020's section in the coordinates (a, b) across it.
section2020(a, b) {
  return max(abs(a) - 10.0, abs(b) - 10.0,
             -slot(abs(a), b), -slot(abs(b), a),
             2.1 - length([a, b]));
}

// section2040: a 2040's section, 20 mm across a and 40 mm across b: two 2020
// cores at b = -10 and b = 10, two slots on each wide face and one on each
// narrow face.
section2040(a, b) {
  c = abs(b) - 10.0;
  return max(abs(a) - 10.0, abs(b) - 20.0,
             -slot(abs(a), c), -slot(abs(b) - 10.0, a),
             2.1 - length([a, c]));
}

// beam2020 and beam2040: the section run from t = 0 to t = span.
beam2020(a, b, t, span) {
  return max(section2020(a, b), abs(t - span / 2.0) - span / 2.0);
}

beam2040(a, b, t, span) {
  return max(section2040(a, b), abs(t - span / 2.0) - span / 2.0);
}

// The base: side rails along y, front and back beams along x between them.
leftRail = beam2020(p.x + 200.0, p.z - (z0 + 10.0), p.y + 210.0, 420.0);
rightRail = beam2020(p.x - 200.0, p.z - (z0 + 10.0), p.y + 210.0, 420.0);
frontBeam = beam2020(p.y + 200.0, p.z - (z0 + 10.0), p.x + 190.0, 380.0);
backBeam = beam2020(p.y - 200.0, p.z - (z0 + 10.0), p.x + 190.0, 380.0);

// The uprights stand on the rails, their wide faces outward; the top beam lies
// across their tops; the gantry beam runs between their inner faces, flush with
// their fronts.
leftUpright = beam2040(p.x + 200.0, p.y, p.z - (z0 + 20.0), 360.0);
rightUpright = beam2040(p.x - 200.0, p.y, p.z - (z0 + 20.0), 360.0);
topBeam = beam2020(p.y, p.z - (z0 + 390.0), p.x + 210.0, 420.0);
gantryBeam = beam2020(p.y + 10.0, p.z - gz, p.x + 190.0, 380.0);

// =========================================================
// Plates
// =========================================================

// A gusset on each outer face ties an upright to its rail, another ties it to
// the top beam, and an end plate on the front carries each end of the gantry.
lowPlateL = box([-215.0, -40.0, z0], [-210.0, 40.0, z0 + 85.0]);
lowPlateR = box([210.0, -40.0, z0], [215.0, 40.0, z0 + 85.0]);
topPlateL = box([-215.0, -20.0, z0 + 330.0], [-210.0, 20.0, z0 + 400.0]);
topPlateR = box([210.0, -20.0, z0 + 330.0], [215.0, 20.0, z0 + 400.0]);
gantryPlateL = box([-210.0, -25.0, gz - 30.0], [-150.0, -20.0, gz + 30.0]);
gantryPlateR = box([150.0, -25.0, gz - 30.0], [210.0, -20.0, gz + 30.0]);
carriagePlate = box([travel - 30.0, -26.0, gz - 30.0], [travel + 30.0, -20.0, gz + 30.0]);

// =========================================================
// Screws
// =========================================================

// ISO 7380 M5 x 10 button heads for the plates, and ISO 4762 M5 x 30 cap
// screws for the blind joints. A screw's head is above its seat at z = 0 and
// its shank below, so each is turned to point into the face it seats on.
m5 = fastener.button(5.0, 10.0);
m5long = fastener.shcs(5.0, 30.0);

// Seated at `seat` on a face that looks along -x, +x or -y.
facingLeft(s, seat) {
  return transform.translate(transform.rotateY(s, -pi / 2.0), seat);
}
facingRight(s, seat) {
  return transform.translate(transform.rotateY(s, pi / 2.0), seat);
}
facingFront(s, seat) {
  return transform.translate(transform.rotateX(s, pi / 2.0), seat);
}

// Low gussets: two into the rail's slot, four into the upright's two slots.
lowL1 = facingLeft(m5, [-215.0, -25.0, z0 + 10.0]);
lowL2 = facingLeft(m5, [-215.0, 25.0, z0 + 10.0]);
lowL3 = facingLeft(m5, [-215.0, -10.0, z0 + 45.0]);
lowL4 = facingLeft(m5, [-215.0, 10.0, z0 + 45.0]);
lowL5 = facingLeft(m5, [-215.0, -10.0, z0 + 70.0]);
lowL6 = facingLeft(m5, [-215.0, 10.0, z0 + 70.0]);
lowR1 = facingRight(m5, [215.0, -25.0, z0 + 10.0]);
lowR2 = facingRight(m5, [215.0, 25.0, z0 + 10.0]);
lowR3 = facingRight(m5, [215.0, -10.0, z0 + 45.0]);
lowR4 = facingRight(m5, [215.0, 10.0, z0 + 45.0]);
lowR5 = facingRight(m5, [215.0, -10.0, z0 + 70.0]);
lowR6 = facingRight(m5, [215.0, 10.0, z0 + 70.0]);

// Top gussets: four into the upright, one into the top beam's end bore.
topL1 = facingLeft(m5, [-215.0, -10.0, z0 + 345.0]);
topL2 = facingLeft(m5, [-215.0, 10.0, z0 + 345.0]);
topL3 = facingLeft(m5, [-215.0, -10.0, z0 + 365.0]);
topL4 = facingLeft(m5, [-215.0, 10.0, z0 + 365.0]);
topL5 = facingLeft(m5, [-215.0, 0.0, z0 + 390.0]);
topR1 = facingRight(m5, [215.0, -10.0, z0 + 345.0]);
topR2 = facingRight(m5, [215.0, 10.0, z0 + 345.0]);
topR3 = facingRight(m5, [215.0, -10.0, z0 + 365.0]);
topR4 = facingRight(m5, [215.0, 10.0, z0 + 365.0]);
topR5 = facingRight(m5, [215.0, 0.0, z0 + 390.0]);

// Gantry end plates: two into the upright's front slot, two into the beam's.
gantryL1 = facingFront(m5, [-200.0, -25.0, gz - 20.0]);
gantryL2 = facingFront(m5, [-200.0, -25.0, gz + 20.0]);
gantryL3 = facingFront(m5, [-180.0, -25.0, gz]);
gantryL4 = facingFront(m5, [-160.0, -25.0, gz]);
gantryR1 = facingFront(m5, [200.0, -25.0, gz - 20.0]);
gantryR2 = facingFront(m5, [200.0, -25.0, gz + 20.0]);
gantryR3 = facingFront(m5, [180.0, -25.0, gz]);
gantryR4 = facingFront(m5, [160.0, -25.0, gz]);

// The carriage plate's four corners.
carriage1 = facingFront(m5, [travel - 22.0, -26.0, gz - 22.0]);
carriage2 = facingFront(m5, [travel + 22.0, -26.0, gz - 22.0]);
carriage3 = facingFront(m5, [travel - 22.0, -26.0, gz + 22.0]);
carriage4 = facingFront(m5, [travel + 22.0, -26.0, gz + 22.0]);

// Blind joints: through each side rail into a base beam's end.
blindL1 = facingLeft(m5long, [-210.0, -200.0, z0 + 10.0]);
blindL2 = facingLeft(m5long, [-210.0, 200.0, z0 + 10.0]);
blindR1 = facingRight(m5long, [210.0, -200.0, z0 + 10.0]);
blindR2 = facingRight(m5long, [210.0, 200.0, z0 + 10.0]);

// =========================================================
// Hotend
// =========================================================

// A mount off the carriage plate, the heatsink, the heater block under it and
// the nozzle under that.
mount = box([travel - 14.0, -30.0, gz - 12.0], [travel + 14.0, -26.0, gz + 12.0]);
heatsink = cylinderCapped([travel, -40.0, gz - 38.0], [travel, -40.0, gz - 8.0], 11.0);
heaterBlock = box([travel - 8.0, -48.0, gz - 50.0], [travel + 8.0, -32.0, gz - 38.0]);
nozzle = coneCapped([travel, -40.0, gz - 50.0], [travel, -40.0, gz - 56.0], 3.5, 0.6);

// =========================================================
// Assembly
// =========================================================

lowBoltsL = min(lowL1, lowL2, lowL3, lowL4, lowL5, lowL6);
lowBoltsR = min(lowR1, lowR2, lowR3, lowR4, lowR5, lowR6);
topBoltsL = min(topL1, topL2, topL3, topL4, topL5);
topBoltsR = min(topR1, topR2, topR3, topR4, topR5);
gantryBolts = min(gantryL1, gantryL2, gantryL3, gantryL4, gantryR1, gantryR2, gantryR3, gantryR4);
carriageBolts = min(carriage1, carriage2, carriage3, carriage4);
blindBolts = min(blindL1, blindL2, blindR1, blindR2);

frame = min(leftRail, rightRail, frontBeam, backBeam,
            leftUpright, rightUpright, topBeam, gantryBeam);
frame.material = aluminumMat;
frame.color = aluminumColor;

plates = min(lowPlateL, lowPlateR, topPlateL, topPlateR,
             gantryPlateL, gantryPlateR, carriagePlate);
plates.material = material.withRoughness(aluminumMat, 0.5);   // black anodized
plates.color = [0.08, 0.08, 0.09];

bolts = min(lowBoltsL, lowBoltsR, topBoltsL, topBoltsR,
            gantryBolts, carriageBolts, blindBolts);
bolts.material = material.withRoughness(steelMat, 0.55);      // black oxide
bolts.color = [0.22, 0.22, 0.24];

hotend = min(mount, heatsink, heaterBlock);
hotend.material = aluminumMat;
hotend.color = aluminumColor;

nozzle.material = brassMat;
nozzle.color = brassColor;

return frame, plates, bolts, hotend, nozzle;

// Scene Size: 20
// Scene Grid: 10


// =========================================================
// MODEL PARAMETERS
// =========================================================

flangeDia = 6;
flangeHeight = 0.5;

yokeHeight = 4;
yokeBaseWidth = 2.5;
yokeBaseHeight = 0.5;
yokeSpan = 2.5;
yokeThickness = 0.5;
yokeRound = 0.5;
yokeEdge = 0.03;

yokeHoleRadius = 0.5;
yokeHoleHeight = 3;
yokeHolePosition = [0, 0, yokeHoleHeight + flangeHeight];
yokeHoleFlangeRadial = 0.25;
yokeHoleFlangeHeight = 0.125;
yokeHoleChamfer = 0.06;

boltCircleRadius = 2.5;
boltHoleRadius = 0.25;
numBolts = 6;

// Shaft parameters
shaftRadius = 0.4;
shaftLength = 5;

// =========================================================
// YOKE & FLANGE CONSTRUCTION
// =========================================================

yokeSide() {
  side = plane([yokeSpan * 0.5 + yokeThickness, 0, 0], [1, 0, 0]);
  reinforce = cylinderX(yokeHolePosition, yokeHoleRadius + yokeHoleFlangeRadial);
  reinforceCap = side - yokeHoleFlangeHeight;
  return unionRound(intersectChamfer(reinforce, reinforceCap, yokeEdge), side, yokeEdge);
}

boltHole(angle) {
  cx = boltCircleRadius * cos(angle);
  cy = boltCircleRadius * sin(angle);
  return cylinderZ([cx, cy, 0], boltHoleRadius);
}

flangeHoles4() {
  h0 = boltHole(0);
  h1 = boltHole(radians(90));
  h2 = boltHole(radians(180));
  h3 = boltHole(radians(270));
  return min(min(h0, h1), min(h2, h3));
}

flangeHoles6() {
  h0 = boltHole(0);
  h1 = boltHole(radians(60));
  h2 = boltHole(radians(120));
  h3 = boltHole(radians(180));
  h4 = boltHole(radians(240));
  h5 = boltHole(radians(300));
  return min(min(unionSharp(h0, h1), min(h2, h3)), min(h4, h5));
}

yokeHole() {
  return cylinderX(yokeHolePosition, yokeHoleRadius);
}

castPart() {
  flangeCyl = cylinderZ(vector.zero, flangeDia * 0.5);
  basePlane = plane(vector.zero, [0, 0, -1]);
  flangePlane = plane([0, 0, flangeHeight], [0, 0, 1]);

  yokeCutMirrored = remap(unionRound(
    plane([yokeSpan * 0.5, 0, 0], [-1, 0, 0]),
    plane([0, 0, yokeBaseHeight + flangeHeight], [0, 0, 1]),
    yokeRound), [abs(p.x), p.y, p.z]);

  yokeBossTop = remap(intersectRound(
    plane([0, yokeBaseWidth * 0.5, flangeHeight], [0, 1, 0.1]),
    plane([0, 0, yokeHeight + flangeHeight], [0, 0, 1]),
    yokeRound), [p.x, abs(p.y), p.z]);

  yokeBossTopBot = unionRound(yokeBossTop, flangePlane, yokeRound);

  yokeSideMirrored = remap(yokeSide(), [abs(p.x), abs(p.y), p.z]);
  yokeBossSides = unionRound(yokeSideMirrored, flangePlane, yokeEdge);

  yokeOuter = intersectChamfer(yokeBossSides, yokeBossTopBot, yokeEdge);
  yoke = intersectChamfer(yokeOuter, yokeCutMirrored, yokeEdge);

  flangeBody = max(flangeCyl, basePlane);
  flangeWithHoles = max(flangeBody, neg(flangeHoles4()));

  body = max(flangeWithHoles, yoke);

  result = intersectChamfer(body, neg(yokeHole()), yokeHoleChamfer);

  return result;
}

partPlacementShift = 5;

placePart(trans) {
  return remap(castPart(), [p.x, p.y - trans, -p.z]);
}

placedParts = remap(placePart(partPlacementShift), [p.x, abs(p.y), p.z]);

gateHeight = 1;
drainWidth = 1;
drainRadius = 0.75;
drainHeight = 3;
drainRectZ = -(yokeHeight + flangeHeight);
drainCircZ = drainRectZ - drainHeight;
gateCylinderHeight = 1;
gateCylinderRadius = 2.5;

sprueShaftDiameter = 3;
sprueBaseDiameter = sprueShaftDiameter * 0.5 + 2 * drainRadius;
sprueBaseHeight = 1;
sprueTopDiameter = 4;
sprueTopBaseZ = gateHeight + gateCylinderHeight + 0.5;
sprueTopZ = 8;
sprueTopChamfer = 0.5;
sprueHoleDiameter = 0.75;

placeGate(trans) {
  gates = intersectSharp(
  boxCentered([0, trans, gateHeight * 0.5], [yokeSpan + 2 * yokeThickness, yokeBaseWidth, gateHeight]),
  yokeSpan * 0.5 - abs(p.x)
  );

  gateTop = cylinderCapped([0, trans, gateHeight], [0, trans, gateHeight + gateCylinderHeight], gateCylinderRadius);

  gateSpan = boxCentered([0, 0, gateHeight + gateCylinderHeight * 0.5], [sprueShaftDiameter, 2 * trans, gateCylinderHeight]);

  return min(gates, gateTop, gateSpan);
}

placeDrain(trans) {
  center = [(yokeSpan + yokeThickness) * 0.5, trans];
  rect = rectangleXYCentered(center, [yokeThickness, drainWidth]);
  circ = circleXY(center, drainRadius);

  loft = linearMap(p.z, drainRectZ, drainCircZ, rect, circ);
  return intersectSharp(loft, p.z - drainRectZ, -p.z + drainCircZ);
}

shearDrain() {
  return remap(placeDrain(partPlacementShift),
  ease.interp(p.z, drainRectZ, drainCircZ, p,
  p - [-(yokeSpan + yokeThickness) * 0.5, -partPlacementShift + sprueBaseDiameter - drainRadius, 0], ease.quadratic)
  ) * 0.5;  // adjust lipschitz
}

gates = remap(placeGate(partPlacementShift), [p.x, abs(p.y), p.z]);
drain = remap(shearDrain(), [abs(p.x), abs(p.y), p.z]);

sprueBase = cylinderCapped([0, 0, drainCircZ - sprueBaseHeight], [0, 0, drainCircZ], sprueBaseDiameter);

sprueShaftBot = max(cylinderZ(vector.zero, ramp(p.z, sprueTopBaseZ, sprueTopZ, sprueShaftDiameter * 0.5, sprueTopDiameter)), -p.z + drainCircZ);
sprueShaft = max(intersectChamfer(sprueShaftBot, p.z - sprueTopZ, sprueTopChamfer), -circleXY(vector.zero.xy, sprueHoleDiameter * 0.5));

sprue = min(sprueBase, sprueShaft);

gateTopZ = gateHeight + gateCylinderHeight;
sprueMidZ = (sprueTopBaseZ + sprueTopZ) * 0.5;
ventRadius = 0.3;

ventStart = [0, partPlacementShift, gateTopZ];
ventEnd = [0, sprueTopDiameter - sprueTopChamfer * 2, sprueTopZ - sprueTopChamfer];
ventMid = [0, ventStart.y, mix(ventStart.z, ventEnd.z, 0.75)];

vent = remap(bezierQuadRound(ventStart, ventMid, ventEnd) - ventRadius, [p.x, abs(p.y), p.z]);

return placedParts, gates, drain, sprue, vent;

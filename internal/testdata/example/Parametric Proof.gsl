// Scene Size: 58

// A damper piston in a blind bore, with two design parameters. The point of
// this example: certify with overParams proves the piston NEVER touches the
// block — not at these slider values, at EVERY value in the declared ranges.
//
//   certify "max(block, piston)" >= 0.15 over a region containing both,
//   overParams: true
//
// proves 0.3 of clearance for every configuration. Widen stroke.max to 14
// and the same call returns a counterexample naming the failing ranges
// (the piston bottoms out on the bore floor once stroke passes ~13).
pistonR = 6.0;
pistonR.min = 4.0;
pistonR.max = 7.4;
stroke = 6.0;
stroke.min = 0.0;
stroke.max = 11.0;

cylZ(r, z0, z1) {
  return max(length(p.xy) - r, z0 - p.z, p.z - z1);
}

// Block: outer cylinder with a blind bore (radius 8, floor at z = -16).
block = max(cylZ(12.0, -18.0, 6.0), -cylZ(8.0, -16.0, 7.0));
block.color = [0.42, 0.48, 0.58];

// Piston: head riding in the bore, rod out through the mouth.
head = cylZ(pistonR, -4.0 - stroke, 4.0 - stroke);
rod = cylZ(2.5, 3.0 - stroke, 22.0);
piston = min(head, rod);
piston.color = [0.78, 0.62, 0.35];

return block, piston;

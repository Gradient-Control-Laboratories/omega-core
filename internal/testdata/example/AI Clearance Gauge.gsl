// Scene Size: 20
// Scene Grid: 10
// AI geometry tool-use demo — Clearance Gauge
//
// A block with a vertical bore, and a pin lying on its side beside it. The AI
// must place the pin in the bore, then PROVE non-interference and measure the
// fit with its extremum tool (certified global min/max). Open the AI chat and
// give it this task.
//
// TRY THIS PROMPT:
//   Stand the pin up in the bore: coaxial with it, fully inside the block's
//   height. Verify with the extremum tool that the placement does not
//   interfere with the housing, and report the radial clearance.
//
// What to watch: extremum of max(pin, housing) is negative iff the solids
// overlap; a positive minimum is half the clearance. bore r=6, pin r=5, so the
// radial fit is 1.0 mm.

box(x1, y1, z1, x2, y2, z2) {
  return max(
    x1 - p.x, p.x - x2,
    y1 - p.y, p.y - y2,
    z1 - p.z, p.z - z2,
  );
}

cyl(radius, halfLength) {
  return max(length(p.xy) - radius, abs(p.z) - halfLength);
}

boreRadius = 6.0;
housing = max(box(-15.0, -15.0, 0.0, 15.0, 15.0, 20.0),
              -(length(p.xy) - boreRadius));

pinRadius = 5.0;
pinOffset = p - [30.0, 0.0, 5.0];
pin = remap(() { return cyl(pinRadius, 8.0); }(), pinOffset.zyx);

return housing, pin;

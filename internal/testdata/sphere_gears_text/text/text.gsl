segmentDist(a, b) {
   pa = (access(p, xy) - a)
   ba = (b - a)
   h = clamp((dot(pa, ba) / dot(ba, ba)), 0, 1)

   return length((pa - (ba * h)));
}

arcDist(cx, cy, ra, mid, half) {
   dx = (access(p, x) - cx)
   dy = (access(p, y) - cy)
   rot = (1.5707963267948966 - mid)
   ca = cos(rot)
   sa = sin(rot)
   rx = ((dx * ca) - (dy * sa))
   ry = ((dx * sa) + (dy * ca))
   scx = sin(half)
   scy = cos(half)
   pxAbs = abs(rx)
   inside = ((scy * pxAbs) > (scx * ry))
   wx = (pxAbs - (ra * scx))
   wy = (ry - (ra * scy))
   dInside = length(collect(wx, wy))
   l = length(collect(pxAbs, ry))
   dOutside = abs((l - ra))

   return select(inside, dInside, dOutside);
}


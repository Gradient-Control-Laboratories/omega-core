import . "builtin";
import "vector";


// ==================
// Package: vector

import . "builtin";

zero = collect(0, 0, 0)
dirZ = collect(0, 0, 1)

addVector(a, b) {
   gsl_anon(x, i) {
      return (x + index(b, i));
   }

   return map(gsl_anon, a);
}

subtractVector(a, b) {
   gsl_anon(x, i) {
      return (x - index(b, i));
   }

   return map(gsl_anon, a);
}

multiplyScalar(v, s) {
   gsl_anon(x) {
      return (x * s);
   }

   return map(gsl_anon, v);
}

divideByScalar(v, s) {
   gsl_anon(x) {
      return (x / s);
   }

   return map(gsl_anon, v);
}


// ==================
// Package: builtin

sqrt2 = 1.4142135623730951

import vector "vector";

intersectRound(a, b, radius) {
   inset1 = max((a + radius), 0)
   inset2 = max((b + radius), 0)

   return (min(neg(radius), max(a, b)) + length(collect(inset1, inset2)));
}

unionRound(a, b, radius) {
   return neg(intersectRound(neg(a), neg(b), radius));
}

intersectChamfer(a, b, offset) {
   face = max(a, b)
   edge = ((a + b + offset) / sqrt2)

   return max(face, edge);
}

unionChamfer(a, b, offset) {
   return neg(intersectChamfer(neg(a), neg(b), offset));
}

differenceChamfer(target, tool, offset) {
   return intersectChamfer(target, neg(tool), offset);
}

intersectChamferNormalized(a, b, depth, normalA, normalB) {
   face = max(a, b)
   edge = (((a + b) / max(length(vector.addVector(normalA, normalB)), 1e-06)) + depth)

   return max(face, edge);
}



import vector "vector";

circleXY(center, radius) {
   return (length(vector.subtractVector(access(p, xy), center)) - radius);
}

import "vector";

sphere(radius) {
   return (length(p) - radius);
}

axis(center, direction) {
   offset = vector.subtractVector(p, center)
   unitDirection = normalize(direction)
   along = dot(offset, unitDirection)
   perp = vector.subtractVector(offset, vector.multiplyScalar(unitDirection, along))

   return length(perp);
}

cylinder(center, direction, radius) {
   return (axis(center, direction) - radius);
}

cylinderZ(center, radius) {
   return cylinder(center, vector.dirZ, radius);
}

shrinkToVanish(shape, min, max, solid) {
   return shape;
}

simplified(shape, proxy, min, max, size) {
   return shape;
}




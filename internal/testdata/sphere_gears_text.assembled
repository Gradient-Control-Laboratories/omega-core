// Package: mechanical/gears

import . "builtin";
import "vector";


// ==================
// Package: vector

import . "builtin";

zero = collect(0, 0, 0)
dirZ = collect(0, 0, 1)

subtractVector(a, b) {
   gsl_anon(x, i) {
      return (x - index(b, i));
   }

   return map(gsl_anon, a);
}

multiplyScalar(v, s) {
   gsl_anon(x) {
      return (x * s);
   }

   return map(gsl_anon, v);
}


// ==================
// Package: builtin

sqrt2 = 1.4142135623730951

intersectRound(d1, d2, radius) {
   inset1 = max((d1 + radius), 0)
   inset2 = max((d2 + radius), 0)

   return (min(neg(radius), max(d1, d2)) + length(collect(inset1, inset2)));
}

unionRound(d1, d2, radius) {
   return neg(intersectRound(neg(d1), neg(d2), radius));
}

intersectChamfer(d1, d2, setback) {
   face = max(d1, d2)
   edge = ((d1 + d2 + setback) / sqrt2)

   return max(face, edge);
}

unionChamfer(d1, d2, setback) {
   return neg(intersectChamfer(neg(d1), neg(d2), setback));
}

differenceChamfer(target, tool, setback) {
   return intersectChamfer(target, neg(tool), setback);
}



import vector "vector";

circleXY(center, radius) {
   return (length(vector.subtractVector(access(p, xy), center)) - radius);
}

import "vector";

sphere(radius) {
   return (length(p) - radius);
}

axis(center, direction) {
   offset = vector.subtractVector(p, center)
   unitDirection = normalize(direction)
   along = dot(offset, unitDirection)
   perp = vector.subtractVector(offset, vector.multiplyScalar(unitDirection, along))

   return length(perp);
}

cylinder(center, direction, radius) {
   return (axis(center, direction) - radius);
}

cylinderZ(center, radius) {
   return cylinder(center, vector.dirZ, radius);
}

shrinkToVanish(shape, low, high, solid) {
   return shape;
}



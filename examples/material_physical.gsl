@scene(500)

// Measured materials from the Physically Based database
// (physicallybased.info), on 50 mm balls. Top row: metals, whose
// colour is their measured reflectance. Bottom row: dielectrics and liquids,
// with measured IOR, transmission and absorption depth. Each preset also
// carries a density, so a shape's volume gives its mass:
// grams = volumeMM3 * physical.goldDensity * 1e-6.

goldMat, goldColor = physical.gold();
copperMat, copperColor = physical.copper();
brassMat, brassColor = physical.brass();
stainlessSteelMat, stainlessSteelColor = physical.stainlessSteel();
aluminumMat, aluminumColor = physical.aluminum();
castIronMat, castIronColor = physical.castIron();
porcelainMat, porcelainColor = physical.porcelain();
concreteMat, concreteColor = physical.concrete();
tireMat, tireColor = physical.tire();
glassSodaLimeMat, glassSodaLimeColor = physical.glassSodaLime();
waterMat, waterColor = physical.water();
wineRedMat, wineRedColor = physical.wineRed();

spacing = 75;

ball(x, y) {
  return transform.translate(sphere(25), [x * spacing, y * spacing, 0]);
}

gold = ball(-2.5, 0.5);
gold.material = goldMat;
gold.color = goldColor;

copper = ball(-1.5, 0.5);
copper.material = copperMat;
copper.color = copperColor;

brass = ball(-0.5, 0.5);
brass.material = brassMat;
brass.color = brassColor;

stainless = ball(0.5, 0.5);
stainless.material = stainlessSteelMat;
stainless.color = stainlessSteelColor;

aluminum = ball(1.5, 0.5);
aluminum.material = aluminumMat;
aluminum.color = aluminumColor;

castIron = ball(2.5, 0.5);
castIron.material = castIronMat;
castIron.color = castIronColor;

porcelain = ball(-2.5, -0.5);
porcelain.material = porcelainMat;
porcelain.color = porcelainColor;

concrete = ball(-1.5, -0.5);
concrete.material = concreteMat;
concrete.color = concreteColor;

tire = ball(-0.5, -0.5);
tire.material = tireMat;
tire.color = tireColor;

glass = ball(0.5, -0.5);
glass.material = glassSodaLimeMat;
glass.color = glassSodaLimeColor;

water = ball(1.5, -0.5);
water.material = waterMat;
water.color = waterColor;

wine = ball(2.5, -0.5);
wine.material = wineRedMat;
wine.color = wineRedColor;

return gold, copper, brass, stainless, aluminum, castIron, porcelain, concrete, tire, glass, water, wine;

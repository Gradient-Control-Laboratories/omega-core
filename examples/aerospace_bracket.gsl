@scene(200, 20)

// An aerospace mounting bracket: a flat four-cornered base plate with a bolt
// hole at each corner, and a clevis (a forked eye) rising from one edge to take
// a pin. The part was modelled from a STEP file, so its dimensions are fractions
// of one overall scale (the "s" below, in millimetres per unit), which makes it
// about 14 cm long. All lengths are in millimetres.
//
// Try the sliders: p0x/p0y move one base corner, p2x/p2y move the opposite
// one (each drifts on its own period when animated), and clevisAng swings the
// clevis about its base, in degrees.

// Overall scale: the bracket's dimensions below are multiples of s.
s = 1000;

// Offsets (mm) added to two corners of the base plate.
@range(-10, 10, 5) p0x = 0.00;
@range(-20, 20, 6) p0y = 16.80;
@range(-10, 10, 7) p2x = 1.30;
@range(-20, 20, 8) p2y = -20.00;

// All scaled dimensions (everything that was "* s" in the source data)
qzScaled         = -0.035 * s;
quadV0X          = -0.059 * s + p0x;
quadV0Y          =  0.015 * s + p0y;
quadV1X          = -0.059 * s;
quadV1Y          =  0.061 * s;
quadV2X          =  0.059 * s + p2x;
quadV2Y          =  0.061 * s + p2y;
quadV3X          =  0.059 * s;
quadV3Y          =  0.015 * s;
quadOffset       =  0.012 * s;
arcRScaled       =  0.014 * s;

thickness = 0.008 * s;
clevisDia = 0.015 * s;
boltHoleDia = 0.0042 * 2 * s;
clevisGap = 0.012 * s;
edgeSetback = 0.0005 * s;
@range(-30, 30) clevisAng = 0.0;

pt1X             =  0.0469999999999941 * s;
pt1Y             =  0.0730007453869977 * s;
pt1Z             = -0.026998363198379  * s;
pt2X             =  0.0145              * s;
pt2Y             =  0.00300038226336295 * s;
pt2Z             = -0.0138462814387861  * s;

// Quad polygon (rectangle) in its Z = -0.035 plane, scaled.
qz = qzScaled;
v0 = [quadV0X, quadV0Y];
v1 = [quadV1X, quadV1Y];
v2 = [quadV2X, quadV2Y];
v3 = [quadV3X, quadV3Y];

// Vertical cylindrical hole at a given 2D corner location.
boltHole(corner2D) {
  return cylinderZ([corner2D.x, corner2D.y, 0], boltHoleDia * 0.5);
}

quadThickness = 0.5;
bottomPlane = -(p.z - qz);
quadShape() {
  // Offset the 2D quad outward prior to capping
  d2d = quadXY(v0, v1, v2, v3) - quadOffset;
  solid = max(d2d, bottomPlane);

  // Drill bolt holes at each of the four quad corners.
  holes = min(boltHole(v0), boltHole(v1), boltHole(v2), boltHole(v3));
  return max(solid, -holes);
}

// Arc lies in a plane perpendicular to world X (i.e., parallel to YZ).
// Circle axis (local Z)   = (-1, 0, 0)
// Circle ref dir (local X) = (0, -0.6297, -0.7768) -- lies in YZ plane
// Local Y = cross(axis, refDir) = (0, -0.7768, 0.6297)
arcCenter = vector.zero;
arcR = arcRScaled;
halfAperture = (2.73965206631413 - 0.366031891219223) * 0.5;
arcMid = (2.73965206631413 + 0.366031891219223) * 0.5;
scArc = [sin(halfAperture), cos(halfAperture)];

// Local frame basis vectors (in world coords)
arcRefX = [0, -0.629698982019698, -0.776839231786961];
arcRefY = [0, -0.776839231786961, 0.629698982019698];
arcAxis = [-1, 0, 0];

arcShape() {
  d = p - arcCenter;
  // Project onto arc's local frame.
  lx = dot(d, arcRefX);
  ly = dot(d, arcRefY);
  lz = dot(d, arcAxis);
  // Rotate so arc midpoint angle maps to +Y.
  rot = pi * 0.5 - arcMid;
  rx = lx * cos(rot) - ly * sin(rot);
  ry = lx * sin(rot) + ly * cos(rot);

  arc = remap(arcExtendedXY(scArc, arcR), [rx, ry, lz]);
  hole = remap(circleXY(vector.zero.xy, clevisDia * 0.5), p.zyx);
  
  // Isolate the tangent plane distance corresponding to the more horizontal left-side endpoint
  horizPlane = -rx * scArc.x + ry * scArc.y - arcR;
  
  // Return shape and plane multireturn
  return max(arc, -hole), horizPlane;
}

// Two stray points rendered as small spheres.
pt1 = [pt1X, pt1Y, pt1Z];
pt2 = [pt2X, pt2Y, pt2Z];
ptRadius = 1.5;

point1 = transform.translate(sphere(ptRadius), pt1);
point2 = transform.translate(sphere(ptRadius), pt2);

// Creates a Z-parallel continuous plane passing rightward/forward matching two 2D points 
planeXY(p1, p2) {
  dDir = p2 - p1;
  n = normalize([-dDir.y, dDir.x]);
  return plane([p1.x, p1.y, 0], [n.x, n.y, 0]);
}

// Extrude constraints from the quad directly instead of the hardcoded points
rearPlane = planeXY(v1, v2) - quadOffset;
frontPlane = planeXY(v3, v0) - quadOffset;

clevisRot = map.rotateZX(p, radians(clevisAng));
clevisShape, horizPlane = remap(arcShape(), clevisRot);
eyeDraft = remap(plane(pt2, [0, -1, sqrt3]), clevisRot);
eyeSpan = remap((clevisGap * 0.25 + pt2.x * 0.5) - abs(p.x), clevisRot);
eyeStep = max(min(eyeSpan, eyeDraft + thickness), eyeDraft);

sideDraftNormal = normalize([1, 0, 1]);

unionTop = unionRoundExact(
  () { return p.z - (qz + thickness); },
  () { return remap(plane(pt1, sideDraftNormal), [abs(p.x), p.y, p.z]); },
  vector.dirZ,
  sideDraftNormal
);

topSurfs() {
  return intersectChamfer(
    intersectChamfer(unionTop, horizPlane, edgeSetback),
    intersectChamfer(frontPlane, eyeStep, edgeSetback),
    edgeSetback);
}

topSurf = topSurfs();

clevisSpan = remap(abs(p.x) - pt2.x, clevisRot);

clevis = max(
  intersectChamfer(clevisShape, clevisSpan,  edgeSetback), 
  bottomPlane, -topSurf, rearPlane);
  
clevisCut = max(min(-eyeStep - thickness, rearPlane), 
 remap(clevisGap * 0.5 - abs(p.x), clevisRot));

clevisFinal = intersectChamfer(clevis, clevisCut, edgeSetback);

base = max(intersectChamfer(quadShape(), topSurf, edgeSetback), -topSurf - thickness);
body = min(base, clevisFinal);

return body;

@scene(250, 25)

// A gallery of boolean blends, all lengths in millimetres. Each panel takes
// the same three overlapping spheres and combines them with a different blend:
// nine intersection-style blends (sharp, rounded, two Lp norms, exponential,
// and four chamfer variants) and three edge-fillet profiles (circle, diamond
// and square). Every blend is shown three ways, stacked along Z: the
// intersection of the three spheres on top, their union in the middle and the
// first sphere minus the other two on the bottom. The twelve stacks are laid
// out in a 3 x 4 grid, so the blends can be compared side by side.
//
// Each blend is a small kernel that takes the list of three sphere fields, and
// a generic stack() applies it to intersection, union and difference.

// Blend setback (mm) used by every kernel, the spacing between panels, and
// the three spheres: radius and how far they sit from the centre of a panel.
rad = 2.5;
offset = 50;
stackOffset = [0, 0, offset * 1.5];
sphereRadius = 20;
sphereOffset = 10;

// Three overlapping spheres, recomputed from p. A remap only re-evaluates p
// inside the function it wraps (not values passed into it), so anything we
// want to reposition must recompute its geometry from p — hence parts() and
// the p-using wrappers below rather than a pre-evaluated list.
parts() {
  return [
    sphere(vector.dirX * -sphereOffset, sphereRadius),
    sphere(vector.dirX * sphereOffset, sphereRadius),
    sphere(vector.dirZ * sqrt3 * sphereOffset, sphereRadius)
  ];
}

intersected(blend) {
  return blend(parts());
}

unioned(blend) {
  return neg(blend(map((value) {
    return neg(value);
  }, parts())));
}

differenced(blend) {
  return blend(map((value, index) {
    return (index == 0) ? value : neg(value);
  }, parts()));
}

// Intersection on top, union in the middle, difference on the bottom.
stack(blend) {
  return min(
    transform.translate(intersected(blend), stackOffset),
    unioned(blend),
    transform.translate(differenced(blend), -stackOffset)
  );
}

// Intersection-style blend kernels. Each binds its setbacks from rad.
sharpKernel(list)           { return intersectSharp(list); }
roundKernel(list)           { return intersectRound(list, rad); }
lpThinKernel(list)          { return intersectLp(list, rad, 1); }
lpFatKernel(list)           { return intersectLp(list, rad, 3); }
expKernel(list)             { return intersectExponential(list, rad); }
chamferEdgesKernel(list)    { return intersectChamferEdges(list, rad); }
chamferVerticesKernel(list) { return intersectChamferVertices(list, rad); }
chamferKernel(list)         { return intersectChamfer(list, [rad, 2 * rad]); }
chamferBlendKernel(list)    { return intersectChamferRound(list, [rad, 2 * rad], rad * 1.2); }

sharp  = stack(sharpKernel);
lpThin = stack(lpThinKernel);
rounded = stack(roundKernel);
lpFat  = stack(lpFatKernel);

chamferEdges    = stack(chamferEdgesKernel);
chamferVertices = stack(chamferVerticesKernel);
chamfer         = stack(chamferKernel);
chamferBlend    = stack(chamferBlendKernel);

exponential = stack(expKernel);

// Edge-coordinate fillets: build a fillet field from a 2D profile with
// remapEdges, then carve / add it through the same three-position layout.
// Each position recomputes its geometry from p so the remaps reposition it.
edgesIntersected(profile) {
  return max(intersectSharp(parts()), neg(remapEdges(parts(), profile)));
}

edgesUnioned(profile) {
  return min(unionSharp(parts()), remapEdges(parts(), profile));
}

edgesDifferenced(profile) {
  body = intersectSharp(map((value, index) {
    return (index == 0) ? value : neg(value);
  }, parts()));
  // Union the fillets, but keep only the ones lying on the difference body
  // (within a fillet-radius band of its surface) so the fillet between the
  // two subtracted spheres doesn't float free in the carved-away region.
  return min(body, max(remapEdges(parts(), profile), body - 2 * rad));
}

stackEdges(profile) {
  return min(
    transform.translate(edgesIntersected(profile), stackOffset),
    edgesUnioned(profile),
    transform.translate(edgesDifferenced(profile), -stackOffset)
  );
}

edgesCircle  = stackEdges(() { return circleXY(vector.zero.xy, rad); });
edgesDiamond = stackEdges(() { return max(abs(p.x), abs(p.y)) - rad; });
edgesSquare  = stackEdges(() { return max(abs(p.x + p.y) * 0.5, abs(p.x - p.y) * 2) / sqrt2 - rad; });

// Lay the twelve panels out in a 3 x 4 grid.
y0 = offset * -1.5;
y1 = offset * -0.5;
y2 = offset * 0.5;
y3 = offset * 1.5;

return
  transform.translate(sharp, [0, y0, 0]),
  transform.translate(lpThin, [0, y1, 0]),
  transform.translate(rounded, [0, y2, 0]),
  transform.translate(lpFat, [0, y3, 0]),

  transform.translate(chamferEdges, [neg(offset), y0, 0]),
  transform.translate(chamferVertices, [neg(offset), y1, 0]),
  transform.translate(chamfer, [neg(offset), y2, 0]),
  transform.translate(chamferBlend, [neg(offset), y3, 0]),

  transform.translate(edgesCircle, [offset, y0, 0]),
  transform.translate(edgesDiamond, [offset, y1, 0]),
  transform.translate(edgesSquare, [offset, y2, 0]),
  transform.translate(exponential, [offset, y3, 0]);

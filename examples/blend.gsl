@scene(8, 0.4)

// CSG Shapes Showcase: Smooth Booleans & Geometric Primitives
blend = 0.35;
blend.min = 0.05;
blend.max = 0.8;

sphere_radius = 1.3;
sphere_radius.min = 0.8;
sphere_radius.max = 2.0;

box_size = 1.0;
box_size.min = 0.5;
box_size.max = 1.5;

// Sphere primitive
d_sphere = sphere(sphere_radius);

// Box primitive, box_size from the center to each face
d_box = boxCentered(vector.zero, [2 * box_size, 2 * box_size, 2 * box_size]);

// Cross cylinders along X, Y, Z
d_cyl_z = cylinderZ(vector.zero, 0.55);
d_cyl_y = cylinderY(vector.zero, 0.55);
d_cyl_x = cylinderX(vector.zero, 0.55);
d_cross = min(min(d_cyl_x, d_cyl_y), d_cyl_z);

// Smooth boolean union between box and sphere
h = clamp(0.5 + 0.5 * (d_box - d_sphere) / blend, 0.0, 1.0);
d_smooth = (1.0 - h) * d_box + h * d_sphere - blend * h * (1.0 - h);

// Difference: subtract cross bore channels
return max(d_smooth, -d_cross);

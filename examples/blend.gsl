// CSG Shapes Showcase: Smooth Booleans & Geometric Primitives
blend = 0.35;
blend.min = 0.05;
blend.max = 0.8;

sphere_radius = 1.3;
sphere_radius.min = 0.8;
sphere_radius.max = 2.0;

box_size = 1.0;
box_size.min = 0.5;
box_size.max = 1.5;

// Sphere primitive
r_sphere = sqrt(p.x * p.x + p.y * p.y + p.z * p.z);
d_sphere = r_sphere - sphere_radius;

// Box primitive
d_box = max(max(abs(p.x) - box_size, abs(p.y) - box_size), abs(p.z) - box_size);

// Cross cylinders along X, Y, Z
d_cyl_z = sqrt(p.x * p.x + p.y * p.y) - 0.55;
d_cyl_y = sqrt(p.x * p.x + p.z * p.z) - 0.55;
d_cyl_x = sqrt(p.y * p.y + p.z * p.z) - 0.55;
d_cross = min(min(d_cyl_x, d_cyl_y), d_cyl_z);

// Smooth boolean union between box and sphere
h = clamp(0.5 + 0.5 * (d_box - d_sphere) / blend, 0.0, 1.0);
d_smooth = (1.0 - h) * d_box + h * d_sphere - blend * h * (1.0 - h);

// Difference: subtract cross bore channels
return max(d_smooth, -d_cross);

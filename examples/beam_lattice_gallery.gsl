@scene(550, 50)

// A gallery of strut lattices: fourteen beam networks side by side along X, each
// repeated through its own 28 mm cube. A strut lattice is returned infinitely
// thin (the distance to the skeleton of struts); lattice.solidify grows that
// into struts of the radius `bias`, and each cube is clipped to its box and
// returned as a separate object (comma-separated, no boolean). Compare how many
// struts meet at a joint and how each family fills its cube; the last three
// are columns that run straight through Z.

bias = 0.6;    // strut half-width, the radius (mm)
r = 14;        // specimen half-size (mm)
step = 34;     // spacing along X (mm)
s = [12, 12, 12]; // unit-cell size (mm)

// Solidify a thin strut field and clip it to a cube centered at x = off.
specimen(field, off) {
  return max(lattice.solidify(field, bias), boxCentered([off, 0, 0], [2 * r, 2 * r, 2 * r]));
}

// Left to right: the octet, truncated octahedral, BCC and FCC families, the
// truncated cubic, Kelvin, fluorite, isotruss and re-entrant cells, two cubic
// frames, and finally rectangular, triangular and hexagonal columns.
oct = specimen(beam.octet(s),                  -6.5 * step);
toc = specimen(beam.truncatedOctahedral(s),    -5.5 * step);
bcc = specimen(beam.bcc(s),                     -4.5 * step);
fcc = specimen(beam.fcc(s),                     -3.5 * step);
tcu = specimen(beam.truncatedCubic(s, 0.5),    -2.5 * step);
kel = specimen(beam.kelvinCell(s, 0.5),        -1.5 * step);
flu = specimen(beam.fluorite(s),               -0.5 * step);
iso = specimen(beam.isotruss(s),                0.5 * step);
ree = specimen(beam.reentrant(s, 0.3),          1.5 * step);
cub = specimen(beam.cubic(s, unionRound(0.4)),              2.5 * step);
cud = specimen(beam.cubicDouble(s),             3.5 * step);
colR = specimen(beam.columnRectangular(s),      4.5 * step);
colT = specimen(beam.columnTriangular(12),      5.5 * step);
colH = specimen(beam.columnHexagonal(8),        6.5 * step);

return oct, toc, bcc, fcc, tcu, kel, flu, iso, ree, cub, cud, colR, colT, colH;

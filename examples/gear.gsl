// Parametric Spur Gear Showcase
teeth = 18.0;
teeth.min = 6.0;
teeth.max = 40.0;

radius = 2.0;
radius.min = 1.0;
radius.max = 5.0;

bore = 0.5;
bore.min = 0.2;
bore.max = 1.0;

height = 0.8;
height.min = 0.2;
height.max = 2.0;

// Polar coordinates
angle = atan(p.y, p.x);
r = sqrt(p.x * p.x + p.y * p.y);

// Gear tooth profile modulation
tooth = 0.25 * sin(angle * teeth);

// 2D disk with tooth modulation and center bore hole
d_outer = r - (radius + tooth);
d_inner = bore - r;
d_2d = max(d_outer, d_inner);

// Extrude along Z
d_z = abs(p.z) - (height * 0.5);

return max(d_2d, d_z);

@scene(700, 7)

// Measured everyday surfaces from the physical library on 50 mm balls:
// building materials, paper and boards, ground cover, and the calibration
// extremes — Spectralon, the whitest diffuse reflector, beside Musou Black
// and MIT Black, among the darkest.

concreteMat, concreteColor = physical.concrete();
brickMat, brickColor = physical.brick();
asphaltFreshMat, asphaltFreshColor = physical.asphaltFresh();
clayMat, clayColor = physical.clay();
terracottaMat, terracottaColor = physical.terracotta();
porcelainMat, porcelainColor = physical.porcelain();
marbleMat, marbleColor = physical.marble();
cardboardMat, cardboardColor = physical.cardboard();
officePaperMat, officePaperColor = physical.officePaper();
toiletPaperMat, toiletPaperColor = physical.toiletPaper();
whiteboardMat, whiteboardColor = physical.whiteboard();
blackboardMat, blackboardColor = physical.blackboard();
grayCardMat, grayCardColor = physical.grayCard();
tonerBlackMat, tonerBlackColor = physical.tonerBlack();
sandMat, sandColor = physical.sand();
snowMat, snowColor = physical.snow();
grassMat, grassColor = physical.grass();
charcoalMat, charcoalColor = physical.charcoal();
boneMat, boneColor = physical.bone();
eggShellWhiteMat, eggShellWhiteColor = physical.eggShellWhite();
eggShellBrownMat, eggShellBrownColor = physical.eggShellBrown();
rustMat, rustColor = physical.rust();
tireMat, tireColor = physical.tire();
carPaintMat, carPaintColor = physical.carPaint();
toothpasteMat, toothpasteColor = physical.toothpaste();
spectralonMat, spectralonColor = physical.spectralon();
musouBlackMat, musouBlackColor = physical.musouBlack();
mitBlackMat, mitBlackColor = physical.mitBlack();

spacing = 75;

ball(x, y) {
  return transform.translate(sphere(25), [x * spacing, y * spacing, 0]);
}

concrete = ball(-3, 1.5);
concrete.material = concreteMat;
concrete.color = concreteColor;

brick = ball(-2, 1.5);
brick.material = brickMat;
brick.color = brickColor;

asphaltFresh = ball(-1, 1.5);
asphaltFresh.material = asphaltFreshMat;
asphaltFresh.color = asphaltFreshColor;

clay = ball(0, 1.5);
clay.material = clayMat;
clay.color = clayColor;

terracotta = ball(1, 1.5);
terracotta.material = terracottaMat;
terracotta.color = terracottaColor;

porcelain = ball(2, 1.5);
porcelain.material = porcelainMat;
porcelain.color = porcelainColor;

marble = ball(3, 1.5);
marble.material = marbleMat;
marble.color = marbleColor;

cardboard = ball(-3, 0.5);
cardboard.material = cardboardMat;
cardboard.color = cardboardColor;

officePaper = ball(-2, 0.5);
officePaper.material = officePaperMat;
officePaper.color = officePaperColor;

toiletPaper = ball(-1, 0.5);
toiletPaper.material = toiletPaperMat;
toiletPaper.color = toiletPaperColor;

whiteboard = ball(0, 0.5);
whiteboard.material = whiteboardMat;
whiteboard.color = whiteboardColor;

blackboard = ball(1, 0.5);
blackboard.material = blackboardMat;
blackboard.color = blackboardColor;

grayCard = ball(2, 0.5);
grayCard.material = grayCardMat;
grayCard.color = grayCardColor;

tonerBlack = ball(3, 0.5);
tonerBlack.material = tonerBlackMat;
tonerBlack.color = tonerBlackColor;

sand = ball(-3, -0.5);
sand.material = sandMat;
sand.color = sandColor;

snow = ball(-2, -0.5);
snow.material = snowMat;
snow.color = snowColor;

grass = ball(-1, -0.5);
grass.material = grassMat;
grass.color = grassColor;

charcoal = ball(0, -0.5);
charcoal.material = charcoalMat;
charcoal.color = charcoalColor;

bone = ball(1, -0.5);
bone.material = boneMat;
bone.color = boneColor;

eggShellWhite = ball(2, -0.5);
eggShellWhite.material = eggShellWhiteMat;
eggShellWhite.color = eggShellWhiteColor;

eggShellBrown = ball(3, -0.5);
eggShellBrown.material = eggShellBrownMat;
eggShellBrown.color = eggShellBrownColor;

rust = ball(-3, -1.5);
rust.material = rustMat;
rust.color = rustColor;

tire = ball(-2, -1.5);
tire.material = tireMat;
tire.color = tireColor;

carPaint = ball(-1, -1.5);
carPaint.material = carPaintMat;
carPaint.color = carPaintColor;

toothpaste = ball(0, -1.5);
toothpaste.material = toothpasteMat;
toothpaste.color = toothpasteColor;

spectralon = ball(1, -1.5);
spectralon.material = spectralonMat;
spectralon.color = spectralonColor;

musouBlack = ball(2, -1.5);
musouBlack.material = musouBlackMat;
musouBlack.color = musouBlackColor;

mitBlack = ball(3, -1.5);
mitBlack.material = mitBlackMat;
mitBlack.color = mitBlackColor;

return concrete, brick, asphaltFresh, clay, terracotta, porcelain, marble, cardboard, officePaper, toiletPaper, whiteboard, blackboard, grayCard, tonerBlack, sand, snow, grass, charcoal, bone, eggShellWhite, eggShellBrown, rust, tire, carPaint, toothpaste, spectralon, musouBlack, mitBlack;

@scene(700, 7)

// Measured plastics (top) and crystals (bottom) from the physical library on
// 50 mm balls: the database's IOR sets how strongly each one bends light,
// from polystyrene foam and PLA through quartz and sapphire to diamond. The
// balls rest on a checkerboard so there is something to refract: the higher
// the IOR, the smaller and more inverted the board seen through a ball.

plasticPLAMat, plasticPLAColor = physical.plasticPLA();
plasticPETMat, plasticPETColor = physical.plasticPET();
plasticPCMat, plasticPCColor = physical.plasticPC();
plasticPPMat, plasticPPColor = physical.plasticPP();
plasticPVCMat, plasticPVCColor = physical.plasticPVC();
plasticPURMat, plasticPURColor = physical.plasticPUR();
plasticAcrylicMat, plasticAcrylicColor = physical.plasticAcrylic();
polystyreneFoamMat, polystyreneFoamColor = physical.polystyreneFoam();
diamondMat, diamondColor = physical.diamond();
sapphireMat, sapphireColor = physical.sapphire();
quartzMat, quartzColor = physical.quartz();
glassBorosilicateMat, glassBorosilicateColor = physical.glassBorosilicate();
iceMat, iceColor = physical.ice();
saltMat, saltColor = physical.salt();
amberMat, amberColor = physical.amber();
pearlMat, pearlColor = physical.pearl();

spacing = 75;

board = boxCentered([0, 0, -27], [640, 170, 4]);
board.material = material.matte;
board.color = map.checkerXY(12) > 0 ? [0.85, 0.85, 0.85] : [0.12, 0.12, 0.12];

ball(x, y) {
  return remap(sphere(25), p - [x * spacing, y * spacing, 0]);
}

plasticPLA = ball(-3.5, 0.5);
plasticPLA.material = plasticPLAMat;
plasticPLA.color = plasticPLAColor;

plasticPET = ball(-2.5, 0.5);
plasticPET.material = plasticPETMat;
plasticPET.color = plasticPETColor;

plasticPC = ball(-1.5, 0.5);
plasticPC.material = plasticPCMat;
plasticPC.color = plasticPCColor;

plasticPP = ball(-0.5, 0.5);
plasticPP.material = plasticPPMat;
plasticPP.color = plasticPPColor;

plasticPVC = ball(0.5, 0.5);
plasticPVC.material = plasticPVCMat;
plasticPVC.color = plasticPVCColor;

plasticPUR = ball(1.5, 0.5);
plasticPUR.material = plasticPURMat;
plasticPUR.color = plasticPURColor;

plasticAcrylic = ball(2.5, 0.5);
plasticAcrylic.material = plasticAcrylicMat;
plasticAcrylic.color = plasticAcrylicColor;

polystyreneFoam = ball(3.5, 0.5);
polystyreneFoam.material = polystyreneFoamMat;
polystyreneFoam.color = polystyreneFoamColor;

diamond = ball(-3.5, -0.5);
diamond.material = diamondMat;
diamond.color = diamondColor;

sapphire = ball(-2.5, -0.5);
sapphire.material = sapphireMat;
sapphire.color = sapphireColor;

quartz = ball(-1.5, -0.5);
quartz.material = quartzMat;
quartz.color = quartzColor;

glassBorosilicate = ball(-0.5, -0.5);
glassBorosilicate.material = glassBorosilicateMat;
glassBorosilicate.color = glassBorosilicateColor;

ice = ball(0.5, -0.5);
ice.material = iceMat;
ice.color = iceColor;

salt = ball(1.5, -0.5);
salt.material = saltMat;
salt.color = saltColor;

amber = ball(2.5, -0.5);
amber.material = amberMat;
amber.color = amberColor;

pearl = ball(3.5, -0.5);
pearl.material = pearlMat;
pearl.color = pearlColor;

return board, plasticPLA, plasticPET, plasticPC, plasticPP, plasticPVC, plasticPUR, plasticAcrylic, polystyreneFoam, diamond, sapphire, quartz, glassBorosilicate, ice, salt, amber, pearl;

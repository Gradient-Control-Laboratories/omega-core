// Scene Size: 700
// Scene Grid: 100

// Measured light, post-transition and alkali metals, and the semimetals
// silicon and germanium, from the physical library on 50 mm balls, including
// anodized aluminum and titanium, whose colour is the oxide layer's.

aluminumMat, aluminumColor = physical.aluminum();
aluminumAnodizedRedMat, aluminumAnodizedRedColor = physical.aluminumAnodizedRed();
titaniumMat, titaniumColor = physical.titanium();
titaniumAnodizedMat, titaniumAnodizedColor = physical.titaniumAnodized();
magnesiumMat, magnesiumColor = physical.magnesium();
berylliumMat, berylliumColor = physical.beryllium();
zincMat, zincColor = physical.zinc();
leadMat, leadColor = physical.lead();
mercuryMat, mercuryColor = physical.mercury();
lithiumMat, lithiumColor = physical.lithium();
sodiumMat, sodiumColor = physical.sodium();
potassiumMat, potassiumColor = physical.potassium();
rubidiumMat, rubidiumColor = physical.rubidium();
cesiumMat, cesiumColor = physical.cesium();
siliconMat, siliconColor = physical.silicon();
germaniumMat, germaniumColor = physical.germanium();

spacing = 75;

ball(x, y) {
  return transform.translate(sphere(25), [x * spacing, y * spacing, 0]);
}

aluminum = ball(-3.5, 0.5);
aluminum.material = aluminumMat;
aluminum.color = aluminumColor;

aluminumAnodizedRed = ball(-2.5, 0.5);
aluminumAnodizedRed.material = aluminumAnodizedRedMat;
aluminumAnodizedRed.color = aluminumAnodizedRedColor;

titanium = ball(-1.5, 0.5);
titanium.material = titaniumMat;
titanium.color = titaniumColor;

titaniumAnodized = ball(-0.5, 0.5);
titaniumAnodized.material = titaniumAnodizedMat;
titaniumAnodized.color = titaniumAnodizedColor;

magnesium = ball(0.5, 0.5);
magnesium.material = magnesiumMat;
magnesium.color = magnesiumColor;

beryllium = ball(1.5, 0.5);
beryllium.material = berylliumMat;
beryllium.color = berylliumColor;

zinc = ball(2.5, 0.5);
zinc.material = zincMat;
zinc.color = zincColor;

lead = ball(3.5, 0.5);
lead.material = leadMat;
lead.color = leadColor;

mercury = ball(-3.5, -0.5);
mercury.material = mercuryMat;
mercury.color = mercuryColor;

lithium = ball(-2.5, -0.5);
lithium.material = lithiumMat;
lithium.color = lithiumColor;

sodium = ball(-1.5, -0.5);
sodium.material = sodiumMat;
sodium.color = sodiumColor;

potassium = ball(-0.5, -0.5);
potassium.material = potassiumMat;
potassium.color = potassiumColor;

rubidium = ball(0.5, -0.5);
rubidium.material = rubidiumMat;
rubidium.color = rubidiumColor;

cesium = ball(1.5, -0.5);
cesium.material = cesiumMat;
cesium.color = cesiumColor;

silicon = ball(2.5, -0.5);
silicon.material = siliconMat;
silicon.color = siliconColor;

germanium = ball(3.5, -0.5);
germanium.material = germaniumMat;
germanium.color = germaniumColor;

return aluminum, aluminumAnodizedRed, titanium, titaniumAnodized, magnesium, beryllium, zinc, lead, mercury, lithium, sodium, potassium, rubidium, cesium, silicon, germanium;

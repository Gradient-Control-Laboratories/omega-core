@scene(2800, 28)

// Knots in proportion: a dozen planks 1200 mm long, 140 mm wide and 20 mm
// thick, a 1x6 board four feet long, in two racks end to end: knotty on the
// left, clean on the right. Front to back, six woods, each knotty plank
// lined up with a clean one of its wood: eastern white pine, Sitka spruce,
// western red cedar, aromatic cedar, black cherry and black walnut.
//
// Every plank is flat-sawn from a stem 80 mm below it, so the rings cross its
// face as long stripes opening into cathedral arches, and the knots, the
// branches of whorls along the stem, show where the cut passes through them.
// The softwoods keep their own spacing, a year's height growth (pine 450 mm,
// spruce 550) or, for the cedars, which branch irregularly, a typical
// distance between knots (western red 225, aromatic 150); the hardwoods,
// which have none of their own, take one knot a metre or so, as measured
// along boards: cherry every 850 mm, walnut 700. The plank's top face lies
// 100 to 122 mm from the pith and each stem's heartwood runs 115 mm out, so
// the face's edges reach into the sapwood.
//
// The planks are planed, the knife marks 1.7 mm apart, and oiled with boiled
// linseed: wet-looking, the grain deepened, but matte, about 4 gloss units.
// Each plank is cut from its own stretch of stem, so no two have their knots
// in the same places.
//
// age is how far indoor light has changed the colour, from fresh (0) to fully
// aged (1), which also yellows the linseed.

age = 0.00;
age.min = 0;
age.max = 1;
look = [0, age, 0];

plankLength = 1200;
pitch = 160;
rack = 650;

plank(x, y) {
  return boxCentered([x, y, 10], [plankLength, 140, 20], intersectRound(1));
}

rows = [0, 1, 2, 3, 4, 5];
racks = reduce(1000, (nearest, i) {
  return min(nearest, min(plank(-rack, (i - 2.5) * pitch), plank(rack, (i - 2.5) * pitch)));
}, rows);

// The plank the point is in: its wood, 0 to 5 front to back, and whether it
// is in the knotty rack on the left.
pair = clamp(floor(p.y / pitch + 3), 0, 5);
knotty = p.x < 0 ? 1 : 0;
index = 2 * pair + knotty;
number = pair < 0.5 ? wood.pineNumber : (pair < 1.5 ? wood.spruceNumber : (pair < 2.5 ? wood.westernRedCedarNumber : (pair < 3.5 ? wood.aromaticCedarNumber : (pair < 4.5 ? wood.cherryNumber : wood.walnutNumber))));
// Whorl spacing, mm: the softwoods their own (-1), cherry 850 and walnut 700;
// 0 for none.
spacing = pair < 3.5 ? -1 : (pair < 4.5 ? 850 : 700);
knots = knotty > 0.5 ? spacing : 0;

// The stem runs along the plank 80 mm below it, starting at its own place
// along the stem for each plank, within 2.1 m of it, so the stem's frame
// keeps float precision.
stem = [(knotty > 0.5 ? -rack : rack) - plankLength / 2 - mod(911 * index, 2100), (pair - 2.5) * pitch, -80];
along = [1, 0, 0];
// The surface's normal, for the finish: the gradient of the plank the point
// is in alone.
normal = plank(knotty > 0.5 ? -rack : rack, (pair - 2.5) * pitch).dp;
prep = wood.planed(along, 1.7);
racks.material = wood.speciesMaterial(number, stem, along, look, knots, normal, prep, wood.linseedOil);
racks.color = wood.speciesColor(number, stem, along, look, knots, 115 + wood.sapwoodDepth(number), normal, prep, wood.noStain, wood.linseedOil);

return racks;

@scene(30)

// A slider-crank behind a crankcase wall: the connecting rod swings through
// the wall opening once per revolution. The point of this example: certify
// with a time range proves the rod clears the opening at EVERY instant of
// the motion — the envelope itself, not sampled frames — and with the
// slider ranging too, at every crank radius simultaneously:
//
//   certify "max(rod, wall)" >= 0.1 over a region containing both,
//   overParams: true, time in [0, 1]
//
// As shipped (crankR up to 3.2) that proof closes. Widen crankR.max to 4.2
// and the same call returns a counterexample naming the failing ranges —
// the rod clips the opening rim only when crankR passes ~4.17 AND time is
// in the downswing window near 0.88: a conspiracy of configuration and
// instant that no sampled check pins down.

crankR = 3.0;
crankR.min = 2.2;
crankR.max = 3.2;

rodLen = 8.0;
rodR = 0.45;
wallX = 4.0;
wallHalfT = 0.18;
holeR = 2.9;
wallOuterR = 6.0;

theta = 6.283185307 * time;
pinX = crankR * cos(theta);
pinY = crankR * sin(theta);
slideX = pinX + sqrt(rodLen * rodLen - pinY * pinY);

// Connecting rod: capsule from the crank pin to the wrist pin.
dX = slideX - pinX;
dY = 0.0 - pinY;
qX = p.x - pinX;
qY = p.y - pinY;
h = clamp((qX * dX + qY * dY) / (dX * dX + dY * dY), 0.0, 1.0);
rod = length([qX - dX * h, qY - dY * h, p.z]) - rodR;
rod.color = [0.72, 0.72, 0.76];

crank = max(length(p.xy) - (crankR + 0.4), abs(p.z) - 0.45);
crank.color = [0.78, 0.62, 0.35];

pin = max(length(p.xy - [pinX, pinY]) - 0.55, abs(p.z) - 0.8);
pin.color = [0.85, 0.72, 0.42];

piston = max(length(p.yz) - 1.35, abs(p.x - slideX - 1.2) - 1.5);
piston.color = [0.55, 0.30, 0.28];

// Crankcase wall: a washer whose round opening the rod swings through.
wall = max(abs(p.x - wallX) - wallHalfT, holeR - length(p.yz), length(p.yz) - wallOuterR);
wall.color = [0.42, 0.48, 0.58];

return crank, pin, rod, piston, wall;

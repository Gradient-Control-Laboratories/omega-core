@scene(2000, 20)

// Spalting and worm holes in six woods, each log with the fungi and insects
// found in its wood. Front to back on the left:
//   - sugar maple: Xylaria's black zone lines and bleaching, Scytalidium's
//     pink, and ambrosia beetles' pinholes in grey-brown streaks, as in
//     ambrosia maple;
//   - beech: black and brown zone lines, strong bleaching, and furniture
//     beetle holes;
//   - cherry birch: black zone lines and bleaching, no insects.
// On the right:
//   - holly: blue stain in the sapwood, and black zone lines;
//   - chestnut: no fungi, its tannins resisting them, and the timberworm's
//     larger unstained holes, wormy chestnut;
//   - pine: blue stain and red ring rot's pink, and the old house borer's
//     oval holes.
// Each wood is a round of its log, 300 mm across and end grain up, pith to
// bark, beside a board 600 mm long flat-sawn from just under the bark, 120 to
// 140 mm from the pith, where the pinholes reach.
//
// Every log has its bark 150 mm out, so its heartwood ends its own sapwood
// depth in from there: the maple's 50 mm from the pith, the chestnut's 132,
// so only the chestnut's board reaches its heartwood.
//
// spalting and wormholes each go from 0 to 1: up to 0.5 they spread through
// the sapwood, and from 0.5 to 1 on in from the heartwood's edge toward the
// pith, though blue stain keeps to the sapwood and some insects do too. The
// holes are relief, drawn with Displacement on.
//
// Everything is sanded to P180 and oiled with boiled linseed. age is how far
// indoor light has changed the colour, from fresh (0) to fully aged (1), and
// weather how long the wood has stood outdoors, from fresh (0) to years (1).

spalting = 0.50;
spalting.min = 0;
spalting.max = 1;
wormholes = 0.50;
wormholes.min = 0;
wormholes.max = 1;
age = 0.00;
age.min = 0;
age.max = 1;
weather = 0.00;
weather.min = 0;
weather.max = 1;
look = [0, age, weather];

pitch = 340;
bark = 150;
columns = [-500, 500];
rows = [-1, 0, 1];

// The round of the log whose pair of pieces starts at x, its end grain up,
// and the board beside it.
disc(x, y) {
  return cylinderCapped([x - 325, y, 0], [x - 325, y, 30], bark);
}
board(x, y) {
  return boxCentered([x + 175, y, 10], [600, 140, 20], intersectRound(1));
}

pieces = reduce(1000, (nearest, x) {
  return min(nearest, reduce(1000, (inColumn, j) {
    return min(inColumn, min(disc(x, j * pitch), board(x, j * pitch)));
  }, rows));
}, columns);

// The pair the point is in, its column and its row, 0 to 2 front to back, its
// wood, and whether it is in the round or the board.
column = p.x < 0 ? 0 : 1;
row = clamp(floor(p.y / pitch + 1.5), 0, 2);
index = 3 * column + row;
pairX = column < 0.5 ? -500 : 500;
centreY = (row - 1) * pitch;
number = index < 0.5 ? wood.sugarMapleNumber : (index < 1.5 ? wood.beechNumber : (index < 2.5 ? wood.cherryBirchNumber : (index < 3.5 ? wood.hollyNumber : (index < 4.5 ? wood.chestnutNumber : wood.pineNumber))));
inDisc = p.x < pairX - 150 ? 1 : 0;

// The round is cut across its stem; the board's stem runs along it 100 mm
// below, from its own place along the stem for each board.
stem = inDisc > 0.5 ? [pairX - 325, centreY, 0] : [pairX - 125 - 317 * index, centreY, -100];
axis = inDisc > 0.5 ? [0, 0, 1] : [1, 0, 0];
// The surface's normal, for the finish: the gradient of the piece the point
// is in alone.
normal = inDisc > 0.5 ? disc(pairX, centreY).dp : board(pairX, centreY).dp;
prep = wood.sanded(180);

// Each log's fungi and insects, a row of each record at a time, so they can be
// picked from the point.
specimens = [0, 1, 2, 3, 4, 5];
mapleFungi = wood.fungi(wood.xylaria, wood.scytalidiumPink);
beechFungi = wood.fungi(wood.xylaria, wood.whiteRot);
birchFungi = wood.xylaria;
hollyFungi = wood.fungi(wood.blueStain, wood.xylaria);
chestnutFungi = wood.noFungi;
pineFungi = wood.fungi(wood.blueStain, wood.redRingRot);
mapleInsects = wood.ambrosiaBeetle;
beechInsects = wood.furnitureBeetle;
birchInsects = wood.noInsects;
hollyInsects = wood.noInsects;
chestnutInsects = wood.timberworm;
pineInsects = wood.oldHouseBorer;
pick(list) {
  return reduce([0, 0, 0, 0], (found, i) {
    return i == index ? list[i] : found;
  }, specimens);
}
fungi = [pick([mapleFungi[0], beechFungi[0], birchFungi[0], hollyFungi[0], chestnutFungi[0], pineFungi[0]]), pick([mapleFungi[1], beechFungi[1], birchFungi[1], hollyFungi[1], chestnutFungi[1], pineFungi[1]]), pick([mapleFungi[2], beechFungi[2], birchFungi[2], hollyFungi[2], chestnutFungi[2], pineFungi[2]]), pick([mapleFungi[3], beechFungi[3], birchFungi[3], hollyFungi[3], chestnutFungi[3], pineFungi[3]]), pick([mapleFungi[4], beechFungi[4], birchFungi[4], hollyFungi[4], chestnutFungi[4], pineFungi[4]])];
insects = [pick([mapleInsects[0], beechInsects[0], birchInsects[0], hollyInsects[0], chestnutInsects[0], pineInsects[0]]), pick([mapleInsects[1], beechInsects[1], birchInsects[1], hollyInsects[1], chestnutInsects[1], pineInsects[1]]), pick([mapleInsects[2], beechInsects[2], birchInsects[2], hollyInsects[2], chestnutInsects[2], pineInsects[2]])];

pieces.material = wood.speciesMaterial(number, stem, axis, look, 0, bark, normal, prep, wood.linseedOil, spalting, wormholes, fungi, insects);
pieces.color = wood.speciesColor(number, stem, axis, look, 0, bark, normal, prep, wood.noStain, wood.linseedOil, spalting, wormholes, fungi, insects);

return pieces;

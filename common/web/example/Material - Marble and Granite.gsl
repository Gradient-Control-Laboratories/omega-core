@scene(1000, 10)

// Four polished stone slabs, 400 mm square and 20 mm thick. The three
// marbles are the measured marble preset (polished, roughness 0) coloured by
// the stone library's named stones, each built from what photographs of the
// real stone show, veins running diagonally:
//
//   - Calacatta (back left): warm white, sparse long grey veins, gold where
//     they thin, soft smoky bands beside them, gathered in zones with clean
//     stone between;
//   - Statuario (back right): bright white crazed by a dense network of thin,
//     sharp, jagged dark cracks;
//   - Carrara (front left): grey-white with soft, feathery grey veins and
//     smudges.
//
// The granite (front right) has no entry in the database, so it is the
// library's crystal mosaic: interlocking crystals about 3 mm across, each one
// mineral with its own tone (warm grey feldspar, smoky quartz that looks
// translucent, black mica), with dark seams where they meet, polished, the
// quartz glassier and the mica shinier than the feldspar.

marbleMat, marbleColor = physical.marble();

veins = [1, 0.6, 0];

slab(x, y) {
  return boxCentered([x, y, 10], [400, 400, 20], intersectRound(1));
}

calacattaSlab = slab(-220, 220);
calacattaSlab.material = marbleMat;
calacattaSlab.color = stone.calacatta(veins);

statuarioSlab = slab(220, 220);
statuarioSlab.material = marbleMat;
statuarioSlab.color = stone.statuario(veins);

carraraSlab = slab(-220, -220);
carraraSlab.material = marbleMat;
carraraSlab.color = stone.carrara(veins);

graniteSlab = slab(220, -220);
graniteSlab.material = stone.graniteFinish(4, 0.15);
graniteSlab.color = stone.granite(4, [0.55, 0.53, 0.52], [0.10, 0.10, 0.11], [0.85, 0.83, 0.80]);

return calacattaSlab, statuarioSlab, carraraSlab, graniteSlab;

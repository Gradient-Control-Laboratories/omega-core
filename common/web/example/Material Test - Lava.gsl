@scene(100)

// Debug scene: one natural.lavaHero ball, alone, at a small scene size —
// isolates the cost of lavaHero's crust-roughness displacement tier
// (the "hero" opt-in on top of the free lava() material/color effect).

lavaMat, lavaColor = natural.lavaHero(15, [0.12, 0.09, 0.08], [1.0, 0.4, 0.05], 4.0, 5.0, 0.1);
ball = sphere(25);
ball.material = lavaMat;
ball.color = lavaColor;

return ball;

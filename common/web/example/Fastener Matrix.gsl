@scene(150)

// A screw is a head, a shank, a drive and an end, and the four are independent.
//
// That is what this board is for. Each row varies ONE of them and holds the
// others fixed: HEADS along the top, then DRIVES, then SHANKS, then ENDS along
// the bottom. Nothing in any of them is a special case of anything else — every
// part here is one fastener.screw() call with ordinary fields handed to it, so
// any cell of any row composes with any cell of any other.
//
// The standards are the thin layer: fastener.shcs(6.0, 18.0) is four catalog
// lookups and one screw() call, and it is in the top row as the first head.
//
// Everything is M6 so the rows compare. Dimensions that mechanical/catalog
// carries are read from it: the cap screw, button, hex and pan heads, the
// countersunk head, the Phillips, Pozidriv, Torx and Robertson recesses. The
// rest is ILLUSTRATIVE, chosen to draw well — the square, pentagon and flanged
// heads, the hex socket and the slot in a pan head, and the set screws —
// because those standards are not in the catalog,
// and inventing numbers into it would be worse than leaving them at the call.
//
// EVERY PART IS ITS OWN RETURN, with its own colour and material. Min-ed into
// one object, a colour or material per part made every point blend them all,
// and the blend differentiates the whole expression once per part; returned
// side by side, each part answers for itself. So each screw carries its own
// thread, as a relief on its own material — see threadOn below.

zincMat, zincColor = metal.zinc();
steelMat, steelColor = metal.steel();

d = 6.0;
len = 18.0;
pitchVal = thread.metricPitch(d);

dk = catalog.shcsHeadDia(d);        // ISO 4762 head, 10.0
af = catalog.shcsSocket(d);         // ISO 4762 socket, 5.0
csk = catalog.cskHeadDia(d);        // ISO 10642 head, sharp
hexAf = catalog.nutAcrossFlats(d);  // ISO 4032 across flats, 10.0

headH = d;
socketDepth = catalog.shcsSocketDepth(d);   // ISO 4762 t min, 3.0
col = 16.0;

// The ISO 7045 M6 pan head every drive in the drives row is cut into. The
// recess it takes is a PH3 or a PZ3.
panDk = catalog.panHeadDia(d);      // 12.0
panK = catalog.panHeadHeight(d);    // 4.6
panRf = catalog.panCrown(d);        // 10

// THE CROSS RECESS FAMILY, and the numbers that separate its members.
//
// A Phillips and a Pozidriv look alike at arm's length and drive very
// differently. The FLANK ANGLE decides whether a driver cams out: taper the
// wings and it rides up under torque, which is a torque limiter and was a
// deliberate one before torque drivers were cheap. ISO 4757 gives a PH3 5
// degrees 45 minutes.
//
// THERE IS NO JIS RECESS TO SET BESIDE THEM. JIS B 1012 declares its type H
// the ISO 4757 one, and its table matches ISO's angles and its b, e and g for
// every recess number but No. 0, whose wing faces are a radius instead. The
// near-vertical flanks and the R0.06 root a JIS cross is often drawn with are
// in neither standard.
//
// Pozidriv is not a ribbed Phillips. Its wings are parallel, which is what
// stops the bit climbing, and between them its core runs out into four
// V-valleys at 45 degrees that the driver's ribs sit in — see drill.pozidrivAt.

// A recess seats where the standards measure it from: the plane through the
// points where it meets the top of the head, which on a domed head is below
// the crown's apex, where the dome crosses the recess's own outline.
sqAf = catalog.robertsonAcross(3.0);
sqSeat = panK - panRf + sqrt(panRf * panRf - sqAf * sqAf / 2.0);

// The marks are drawn at BOARD scale, not at screw scale. A real stamp is a
// couple of tenths deep and vanishes at the size this page is read at, so these
// are about twice life size — the point here is to tell the recesses apart,
// and a mark you cannot see does not do that.
markDepth = 0.45;

// place: a part set down in its cell of the board. A move that says where the
// part went keeps its box, where a remap would clear it, so each part is its
// own box and the viewer can let one go as it gets small.
place(shape, offset) {
  return transform.translate(shape, offset);
}

// =========================================================
// HEADS — one shank, one drive, every head
// =========================================================

capHead = place(fastener.shcs(d, len), [-4.0 * col, 22.0, 0.0]);

// ISO 7380-1 button head and ISO 7045 pan head, as the standards draw them.
buttonH = place(fastener.button(d, len), [-3.0 * col, 22.0, 0.0]);

panH = place(fastener.panPhillips(d, len), [-2.0 * col, 22.0, 0.0]);

flatH = place(fastener.countersunk(d, len), [-col, 22.0, 0.0]);

// ISO 4017, the hexagon head screw.
hexH = place(fastener.hexScrew(d, len), [0.0, 22.0, 0.0]);

// Four flats, not six: an open-end wrench re-seats every quarter turn instead
// of every sixth, and the flat is wider at the same size across.
squareH = place(fastener.screw(fastener.squareHead(hexAf, 4.5),
                               fastener.plainShank(d, len)),
                [col, 22.0, 0.0]);

// Five flats is a security head. No standard wrench has five, and — the part
// that actually matters — an odd-sided head has no pair of opposite faces for
// a pipe wrench or a pair of pliers to close on. Fire hydrants, water meters
// and utility cabinets are held shut with these.
pentH = place(fastener.screw(fastener.pentHead(hexAf, 4.5),
                             fastener.plainShank(d, len)),
              [2.0 * col, 22.0, 0.0]);

flangeH = place(fastener.screw(fastener.flangeHead(dk, headH, 14.0, 1.5),
                               fastener.plainShank(d, len),
                               drill.hexSocketAt(headH, af, socketDepth)),
                [3.0 * col, 22.0, 0.0]);

setScrew = place(fastener.screw(fastener.noHead(),
                                fastener.ended(fastener.plainShank(d, 10.0),
                                               min(fastener.flatTop(d, 0.0, 0.4),
                                                   fastener.flatEnd(d, -10.0, 0.4)),
                                               1000.0),
                                drill.hexSocketAt(0.0, 3.0, 5.0)),
                 [4.0 * col, 22.0, 0.0]);

// =========================================================
// DRIVES — one head, one shank, every drive
// =========================================================

hexDrive = place(fastener.screw(fastener.panHead(panDk, panK, panRf),
                                fastener.plainShank(d, len),
                                drill.hexSocketAt(panK, af, 3.0)),
                 [-2.5 * col, 0.0, 0.0]);

// ROBERTSON, a #3 — the size that goes with a quarter-inch screw, which is the
// nearest thing to an M6 the square drive has. Parallel walls and a pyramid at
// the bottom, as P.L. Robertson patented it: the bottom is the taper, and a
// modern recess holds its bit without the walls leaning at all.
sqDrive = place(fastener.screw(fastener.panHead(panDk, panK, panRf),
                               fastener.plainShank(d, len),
                               drill.robertsonAt(sqSeat, sqAf, catalog.robertsonDepth(3.0))),
                [-1.5 * col, 0.0, 0.0]);

// Phillips: four ribs standing in a cone over a pointed bottom, the wings what
// they leave between them, and NO MARK AT ALL — which is itself the
// identification, once the Pozidriv's is known. The whole screw is ISO 7045
// type H, a PH3, its recess drawn to ISO 4757's form.
phDrive = place(fastener.panPhillips(d, len), [-0.5 * col, 0.0, 0.0]);

// Pozidriv: parallel wings plus four valleys at 45 degrees, marked with four
// lines at 45 degrees. The valleys and the marks are different features and
// both are needed — the valleys are why the bit holds, the marks are how you
// know to reach for it. ISO 4757's type Z, a PZ3, draws its own marks running
// out from the valleys to the recess diameter; the board-scale ticks start
// beyond them.
pozDrive = place(fastener.screw(fastener.panHead(panDk, panK, panRf,
                                                 drill.tickSection(1.0, 3.9, 5.4), markDepth),
                                fastener.plainShank(d, len),
                                fastener.panPozidrivDrive(d)),
                 [0.5 * col, 0.0, 0.0]);

// TORX, hexalobular, ISO 10664 — the T30 ISO 14583 puts in an M6 pan head,
// to the depth it gives, and the whole screw is that standard. Six lobes with
// straight radial flanks, so there is no cam-out to resist and no need to press
// the driver into the screw to keep it there. The concave fillets between the
// lobes are the profile, not a detail of it: six lobe circles unioned would
// leave a sharp reentrant corner where the standard has an arc, and a reentrant
// corner in a recess is a crack waiting to start.
torxDrive = place(fastener.panTorx(d, len), [1.5 * col, 0.0, 0.0]);

slotDrive = place(fastener.screw(fastener.panHead(panDk, panK, panRf),
                                 fastener.plainShank(d, len),
                                 drill.slotDriveAt(panK, 1.2, 2.0)),
                  [2.5 * col, 0.0, 0.0]);

// =========================================================
// SHANKS — one head, one drive, every shank
// =========================================================
//
// EVERY SHANK HERE IS SMOOTH, at the major diameter — the maximum-material
// envelope a fit is proved against — and every thread on the board is a
// displacement on its material, which only the renderer reads: see the board's
// threadOn at the bottom. So what varies along this row is where the thread is
// and what pitch it has, never how it is drawn.

plainSh = place(fastener.shcs(d, len), [-2.0 * col, -22.0, 0.0]);

// The same screw threaded its whole length: nothing but the relief differs.
fullTh = place(fastener.shcs(d, len), [0.0 - col, -22.0, 0.0]);

// Threaded for its last 9 only, as a bolt is: the plain run under the head is
// what takes shear in a fitted joint. The geometry is the same smooth shank —
// the relief simply stops 9 above the tip.
partTh = place(fastener.shcs(d, len), [0.0, -22.0, 0.0]);

// A shoulder screw: a ground 8 shoulder 12 long, then an M5 stud 8 long, the
// stud running up into the shoulder so the two are one solid.
shoulder = place(fastener.screw(fastener.cylindricalHead(13.0, 6.0),
                                min(fastener.plainShank(8.0, 12.0, 3.0),
                                    remap(fastener.plainShank(5.0, 8.0, 1.25),
                                          [p.x, p.y, p.z + 12.0])),
                                drill.hexSocketAt(6.0, 6.0, 3.5)),
                 [col, -22.0, 0.0]);

// Fine pitch: M6 x 0.75, ISO 261's first fine pitch for the size.
fineTh = place(fastener.shcs(d, len), [2.0 * col, -22.0, 0.0]);

// =========================================================
// ENDS — one head (none), one shank, every end
// =========================================================
//
// The fourth axis, shown on set screws because a set screw is the fastener
// that is ALL end — no head, and the point is the entire product, which is why
// the catalogues tabulate ends there and nowhere else. They are not a set screw
// feature: fastener.ended() finishes any shank, so the same dog point goes on a
// shoulder screw and the same lead chamfer on a bolt.
//
// AN END IS TWO FIELDS. A cup, a cone and an oval are ground INTO the stock; a
// dog point and a soft tip stand PROUD of it. ended() takes one of each and
// 1000.0 is the empty one.
//
// Every one of these carries the socket-side chamfer at z = 0 as well. That is
// not decoration: a set screw is driven down inside a threaded hole, and a
// sharp corner there catches the first thread and raises a burr that stops it
// seating.

// The thread's MINOR diameter — the root, 4.92 for an M6 x 1. Two of the ends
// below are sized on it rather than on the nominal, and in both cases that is
// the mechanism rather than a detail.
minorD = thread.minorDia(d, pitchVal);

setBody = fastener.plainShank(d, 10.0);
setSocket = drill.hexSocketAt(0.0, 3.0, 5.0);
setTop = fastener.flatTop(d, 0.0, 0.4);
zEnd = 0.0 - 10.0;
endRow = 44.0;

// FLAT: bears on the largest area and marks the shaft least. The end for a
// hardened shaft you intend to take apart again.
flatPt = place(fastener.screw(fastener.noHead(),
                              fastener.ended(setBody,
                                             min(setTop, fastener.flatEnd(d, zEnd, 0.4)),
                                             1000.0),
                              setSocket),
               [-3.5 * col, -endRow, 0.0]);

// CUP: a cone ground into the end leaves a thin annular rim that BITES. The
// commonest point and the best holder, at the cost of marking the shaft.
cupPt = place(fastener.screw(fastener.noHead(),
                             fastener.ended(setBody,
                                            min(setTop,
                                                fastener.flatEnd(d, zEnd, 0.4),
                                                fastener.cupEnd(d, zEnd, 1.2, radians(118.0))),
                                            1000.0),
                             setSocket),
              [-2.5 * col, -endRow, 0.0]);

// CONE: digs in and will not shift sideways, so it is the permanent setting —
// and the one that matches a drilled detent in a spotted shaft.
conePt = place(fastener.screw(fastener.noHead(),
                              fastener.ended(setBody,
                                             min(setTop, fastener.coneEnd(d, zEnd, radians(90.0))),
                                             1000.0),
                              setSocket),
               [-1.5 * col, -endRow, 0.0]);

// OVAL: radiused larger than the shank, so it bears on a curved face without a
// cone's bite. The point for something that gets adjusted and re-set.
ovalPt = place(fastener.screw(fastener.noHead(),
                              fastener.ended(setBody,
                                             min(setTop, fastener.ovalEnd(d, zEnd, 6.0)),
                                             1000.0),
                              setSocket),
               [-0.5 * col, -endRow, 0.0]);

// BALL: the oval taken to exactly the shank radius — a true hemisphere,
// bearing on one point. For a V-groove or a flat that must not be scarred.
ballPt = place(fastener.screw(fastener.noHead(),
                              fastener.ended(setBody,
                                             min(setTop, fastener.ballEnd(d, zEnd)),
                                             1000.0),
                              setSocket),
               [0.5 * col, -endRow, 0.0]);

// DOG (EXTENDED) POINT: an unthreaded cylinder standing below the end, dropping
// into a hole or a slot so the screw LOCATES as well as clamps. The one end
// here that ADDS material — it goes in ended()'s second field, not its first.
dogPt = place(fastener.screw(fastener.noHead(),
                             fastener.ended(setBody, setTop,
                                            fastener.dogPoint(3.5, zEnd, 2.5)),
                             setSocket),
              [1.5 * col, -endRow, 0.0]);

// SOFT TIP: a nylon pad that clamps without marking and locks against
// vibration. It is a SEPARATE NAMED OBJECT and has to be, because the whole
// point of it is that it is a different material — and a colour belongs to a
// named object, not to a part of one. Same lesson the painted thread in the
// Fastener Cosmetics example teaches.
// The body is the smooth set screw the rest of this row is, threaded by its
// relief, and the pad is fastener.softTip on the same datum. The pad is at the
// thread's MINOR diameter — it sits in a pocket bored into the end, and that
// pocket cannot be wider than the thread root without cutting through the
// crests.
softBody = place(fastener.screw(fastener.noHead(),
                                fastener.ended(setBody,
                                               min(setTop, fastener.flatEnd(d, zEnd, 0.4)),
                                               1000.0),
                                setSocket),
                 [2.5 * col, 0.0 - endRow, 0.0]);
softPad = place(fastener.softTip(minorD, zEnd, 2.0), [2.5 * col, 0.0 - endRow, 0.0]);
// SELF-DRILLING: an UNTHREADED drill standing below the thread, at the thread's
// MINOR diameter, with two flutes running from the tip up to where the thread
// starts and no further.
//
// The minor diameter is the mechanism, not a detail. The point drills a hole
// the size of the thread's ROOT, and the thread then cuts its own crests into
// the wall of that hole; a drill at nominal would bore away the very material
// the thread needs to bite, and the screw would spin in the hole it just made.
// And the flutes stop at the thread because chips have to clear the cutting
// lips — past the first thread there is nothing left to cut, so a flute run on
// up would only be a notch out of the thread.
//
// The two flutes are offset rather than one slot straight through: a slot
// through the centre leaves both lips facing the same way and cuts on one side.
// Two objects again, and for the same reason: a drill point is usually harder
// or case-hardened compared with the body it has to drill a hole for.
drillPt = place(fastener.screw(fastener.noHead(),
                               fastener.ended(setBody, setTop, 1000.0),
                               setSocket),
                [3.5 * col, 0.0 - endRow, 0.0]);
drillTip = place(fastener.selfDrillPoint(minorD, zEnd, 6.0, radians(118.0), 2.2),
                 [3.5 * col, 0.0 - endRow, 0.0]);
// THE THREADS. Each screw's thread is thread.maleRelief on its own material,
// remapped exactly as the screw is placed: zero outside its own thread, so the
// head and the end keep their own surfaces.
threadOn(finish, dia, pitch, zTop, zBottom, x, y) {
  return material.withDisplacement(finish,
           remap(thread.maleRelief(dia, pitch, zTop, zBottom), [p.x - x, p.y - y, p.z]));
}

// threadColorOn: the colour `base` with the same thread painted on, for
// wherever the renderer is not drawing it (thread.reliefColor).
threadColorOn(base, dia, pitch, zTop, zBottom, x, y) {
  return thread.reliefColor(base,
           remap(thread.maleRelief(dia, pitch, zTop, zBottom), [p.x - x, p.y - y, p.z]), pitch);
}

drillPt.material = threadOn(zincMat, d, pitchVal, 0.0, zEnd, 3.5 * col, -endRow);   // zinc plated
drillPt.color = threadColorOn(zincColor, d, pitchVal, 0.0, zEnd, 3.5 * col, -endRow);
drillTip.material = material.withRoughness(steelMat, 0.3);    // hardened
drillTip.color = steelColor;
softBody.material = threadOn(material.withRoughness(steelMat, 0.55), d, pitchVal,
                             0.0, zEnd, 2.5 * col, -endRow);        // black oxide
softBody.color = threadColorOn([0.22, 0.22, 0.24], d, pitchVal, 0.0, zEnd, 2.5 * col, -endRow);
softPad.material = material.plastic;                             // natural nylon
softPad.color = [0.93, 0.91, 0.85];

// The heads and drives rows hold the shank fixed: threaded its whole length.
// The countersunk head's thread starts under its cone, (dk - d) / 2 down.
capHead.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -4.0 * col, 22.0);
capHead.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -4.0 * col, 22.0);
buttonH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -3.0 * col, 22.0);
buttonH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -3.0 * col, 22.0);
panH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -2.0 * col, 22.0);
panH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -2.0 * col, 22.0);
flatH.material = threadOn(steelMat, d, pitchVal, 0.0 - (csk - d) / 2.0, 0.0 - len, 0.0 - col, 22.0);
flatH.color = threadColorOn(steelColor, d, pitchVal, 0.0 - (csk - d) / 2.0, 0.0 - len, 0.0 - col, 22.0);
hexH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 0.0, 22.0);
hexH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 0.0, 22.0);
squareH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, col, 22.0);
squareH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, col, 22.0);
pentH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 2.0 * col, 22.0);
pentH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 2.0 * col, 22.0);
flangeH.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 3.0 * col, 22.0);
flangeH.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 3.0 * col, 22.0);
setScrew.material = threadOn(steelMat, d, pitchVal, 0.0, -10.0, 4.0 * col, 22.0);
setScrew.color = threadColorOn(steelColor, d, pitchVal, 0.0, -10.0, 4.0 * col, 22.0);

hexDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -2.5 * col, 0.0);
hexDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -2.5 * col, 0.0);
sqDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -1.5 * col, 0.0);
sqDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -1.5 * col, 0.0);
phDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, -0.5 * col, 0.0);
phDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, -0.5 * col, 0.0);
pozDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 0.5 * col, 0.0);
pozDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 0.5 * col, 0.0);
torxDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 1.5 * col, 0.0);
torxDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 1.5 * col, 0.0);
slotDrive.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 2.5 * col, 0.0);
slotDrive.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 2.5 * col, 0.0);

// The shanks row: where the thread is and what pitch it has.
plainSh.material = steelMat;
plainSh.color = steelColor;
fullTh.material = threadOn(steelMat, d, pitchVal, 0.0, 0.0 - len, 0.0 - col, -22.0);
fullTh.color = threadColorOn(steelColor, d, pitchVal, 0.0, 0.0 - len, 0.0 - col, -22.0);
partTh.material = threadOn(steelMat, d, pitchVal, 9.0 - len, 0.0 - len, 0.0, -22.0);
partTh.color = threadColorOn(steelColor, d, pitchVal, 9.0 - len, 0.0 - len, 0.0, -22.0);
shoulder.material = threadOn(steelMat, 5.0, thread.metricPitch(5.0), -12.0, -20.0, col, -22.0);
shoulder.color = threadColorOn(steelColor, 5.0, thread.metricPitch(5.0), -12.0, -20.0, col, -22.0);
fineTh.material = threadOn(steelMat, d, catalog.finePitch(d), 0.0, 0.0 - len, 2.0 * col, -22.0);
fineTh.color = threadColorOn(steelColor, d, catalog.finePitch(d), 0.0, 0.0 - len, 2.0 * col, -22.0);

// The ends row, threaded their whole length.
flatPt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, -3.5 * col, -endRow);
flatPt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, -3.5 * col, -endRow);
cupPt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, -2.5 * col, -endRow);
cupPt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, -2.5 * col, -endRow);
conePt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, -1.5 * col, -endRow);
conePt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, -1.5 * col, -endRow);
ovalPt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, -0.5 * col, -endRow);
ovalPt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, -0.5 * col, -endRow);
ballPt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, 0.5 * col, -endRow);
ballPt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, 0.5 * col, -endRow);
dogPt.material = threadOn(steelMat, d, pitchVal, 0.0, zEnd, 1.5 * col, -endRow);
dogPt.color = threadColorOn(steelColor, d, pitchVal, 0.0, zEnd, 1.5 * col, -endRow);

return capHead, buttonH, panH, flatH, hexH, squareH, pentH, flangeH, setScrew,
       hexDrive, sqDrive, phDrive, pozDrive, torxDrive, slotDrive,
       plainSh, fullTh, partTh, shoulder, fineTh,
       flatPt, cupPt, conePt, ovalPt, ballPt, dogPt,
       softBody, softPad, drillPt, drillTip;

@scene(6)

s = sphere(0.8);
r = boxCentered([0.3, 0.3, 0], [1.5, 1.5, 1.2]);
t = torus(1.3, 0.2);
combined = unionSharp(s, r, t);

edges = length([combined, combined.second]);
scale = max(abs(dot(combined.dp, combined.second.dp)), 0.5);
combined.color = ramp(edges, 0.005 * scale, 0.008 * scale, color.darkGray, color.white);

return combined;
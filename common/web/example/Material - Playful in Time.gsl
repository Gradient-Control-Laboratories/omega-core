@scene(70)

// Playful textures that move (material/playful): glitter that glints as a
// moving light would catch it, and polka dots drifting over a climbing
// rainbow.
// Press play to start the clock.

// Each piece is a sphere 24 mm across, 32 mm apart.
ball(column, row) {
  return transform.translate(sphere(12), [32 * column, -32 * row, 0]);
}

// Glitter whose flakes glint as a light moving round them would catch them.
glitterMat, glitterColor = playful.glitterTwinkle(material.polishedMetal, color.black, 1.0, color.white, 0.25, 8);
glitter = ball(-0.5, 0);
glitter.material = glitterMat;
glitter.color = glitterColor;

// Polka dots drifting over a rainbow that climbs a band every 5 s.
rainbow = playful.rainbowCycle(10, 5, color.cyclicRainbow);
dots = ball(0.5, 0);
dots.material = material.plastic;
dots.color = playful.polkaDotDrift(6, 2, rainbow, color.white, [2, 0, 0]);

return glitter, dots;

@scene(700, 7)

// A dark granite, polished, as a 400 mm slab and a 150 mm ball: near-black
// feldspar and mica with chunky smoky quartz crystals about 5 mm across that
// throw light back. Each quartz crystal is a small mirror tilted its own way
// (stone.graniteFacetFinish, render-only), as a cleavage plane just under the
// polish catches the light, so the chunks glint one by one as the view moves,
// and the quartz reflects more strongly than the stone around it.

cellSize = 7;
feldspar = [0.20, 0.19, 0.19];
darkMinerals = [0.04, 0.04, 0.05];
quartz = [0.66, 0.67, 0.70];

graniteSlab = boxCentered([-120, 0, 10], [400, 400, 20], intersectRound(1));
graniteSlab.material = stone.graniteFacetFinish(cellSize, 0.12, 0.05, 0.35);
graniteSlab.color = stone.granite(cellSize, feldspar, darkMinerals, quartz);

graniteBall = transform.translate(sphere(75), [200, 0, 75]);
graniteBall.material = stone.graniteFacetFinish(cellSize, 0.12, 0.05, 0.35);
graniteBall.color = stone.granite(cellSize, feldspar, darkMinerals, quartz);

return graniteSlab, graniteBall;

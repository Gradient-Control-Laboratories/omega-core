@scene(48)

// A row of spheres showing the material presets. Each shape sets a material
// (its finish) and, where the finish has a natural colour, a colour to pair
// with it. The two properties are independent: the metals take their colour
// from the metal library, the plastics from the color library.

brassMat, brassColor = metal.brass();
steelMat, steelColor = metal.steel();

spacing = 9;

matteBall = transform.translate(sphere(3), [-2 * spacing, 0, 0]);
matteBall.material = material.matte;
matteBall.color = color.cherry;

plasticBall = transform.translate(sphere(3), [-spacing, 0, 0]);
plasticBall.material = material.shinyPlastic;
plasticBall.color = color.teal;

brassBall = transform.translate(sphere(3), [0, 0, 0]);
brassBall.material = brassMat;
brassBall.color = brassColor;

steelBall = transform.translate(sphere(3), [spacing, 0, 0]);
steelBall.material = material.withRoughness(steelMat, 0.15);
steelBall.color = steelColor;

lampBall = transform.translate(sphere(3), [2 * spacing, 0, 0]);
lampBall.material = material.glowing(color.orange, 3);
lampBall.color = color.orange;

return matteBall, plasticBall, brassBall, steelBall, lampBall;



// END OF PROTECTED MODELING LIBRARY

// =========================================================
// MODEL PARAMETERS
// =========================================================

bottomPoint = [0.48, -1.23, -1.25];

gateHeight = 1;
gateCylinderHeight = 1;

gatePortCenterA = [-0.03, 1.29, -0.00];
gatePortCenterB = [0.01, 0.31, 0.00];

gatePortPatternCountA = 6;
gatePortPatternCountB = 2;

drainHeight = 3;

gatePortAnnulusRadiusA = length(gatePortCenterA.xy);
gatePortAnnulusThicknessA = 0.15;
gatePortXThicknessA = 0.5;
gatePortAnnulusRadiusB = length(gatePortCenterB.xy);
gatePortAnnulusThicknessB = 0.15;
gatePortXThicknessB = 0.35;

drainArea = gatePortPatternCountA *
 (gatePortAnnulusThicknessA * gatePortXThicknessA + gatePortAnnulusThicknessB * gatePortXThicknessB);
drainRadius = sqrt(drainArea) / pi;

gateCylinderRadius = gatePortAnnulusRadiusA + gatePortAnnulusThicknessA;

drainSweepScaleA = drainRadius / gatePortAnnulusRadiusA;
drainSweepScaleB = drainRadius / gatePortAnnulusRadiusB;

sprueShaftDiameter = 3;
sprueBaseDiameter = sprueShaftDiameter * 0.5 + 2 * drainRadius;
sprueBaseHeight = 1;
sprueTopDiameter = 4;
sprueTopChamfer = 0.5;
sprueHoleDiameter = 1;
sprueHoleDepth = 3;

gateTopZ = gateHeight + gateCylinderHeight;
sprueTopBaseZ = gateTopZ + 0.5;
sprueTopZ = 8;
gatePenetration = 0.1;

partOrient = [0, pi / 2, 0];
partPlacementShift = 4;
ventRadius = 0.3;

drainRectZ = bottomPoint.z - gatePenetration;
drainCircZ = drainRectZ - drainHeight - 2 * gatePenetration;

// Lattice parameters
latticeShell = 0.08;       // inward offset thickness (wall thickness)
latticeCell = 0.5;        // BCC cell size
latticeBeamRadius = 0.05; // radius of lattice beams

// =========================================================
gatePortFoldedXY(count) {
  wedge = 2 * pi / count;
  halfWedge = wedge * 0.5;
  ang = atan(p.x, p.y);
  rad = length(p.xy);
  angmod = (ang + halfWedge) % wedge - halfWedge;
  foldedX = rad * sin(angmod);
  foldedY = rad * cos(angmod);
  return foldedX, foldedY;
}

gatePortArc(gatePortPatternCount, gatePortAnnulusRadius, gatePortAnnulusThickness, gatePortXThickness) {
  foldedX, foldedY = gatePortFoldedXY(gatePortPatternCount);
  annulusField = abs(length(p.xy) - gatePortAnnulusRadius) - gatePortAnnulusThickness * 0.5;
  xSlabField = abs(foldedX) - gatePortXThickness * 0.5;
  return intersectRound(annulusField, xSlabField, 0);
}

gatePortArcA() {
  return gatePortArc(gatePortPatternCountA, gatePortAnnulusRadiusA, gatePortAnnulusThicknessA, gatePortXThicknessA);
}

gatePortArcB() {
  return gatePortArc(gatePortPatternCountB, gatePortAnnulusRadiusB, gatePortAnnulusThicknessB, gatePortXThicknessB);
}

gateProfiles() {
  return [gatePortArcA(), gatePortArcB()];
}

// drainProfiles() {
//   return [gatePortArcA, gatePortArcB];
// }

drainEndProfile() {
  return circleXY(vector.zero.xy, drainRadius);
}

buildDrainBlended(arcThunk, endThunk, a, b, c, sweepScale, shiftedP, drainCap) {
  profile, capA, capC = remap(
    sweepLoftScaleSmoothSeparateCaps(
      arcThunk,
      endThunk,
      a, b, c,
      [0, 1, 0],
      sweepScale
    ),
    shiftedP
  );

  arcField = remap(arcThunk(), shiftedP);

  transZ = shiftedP.z - bottomPoint.z + gatePenetration;
  blended = mix(profile, arcField, clamp(transZ / gatePenetration, 0, 1));
  return max(blended, capC, drainCap);
}

castPart() {
  castVDB = vdbSdf(0, 1024, 30);
  return remap(castVDB, map.eulerAngles(p, -partOrient));
}

topPlane = plane(vector.zero, [0, 0, 1]);
capZ = [0, 0, gateTopZ];

partFieldsAt(trans) {
  shiftedP = [p.x - trans, p.y, p.z];

  gatePortsXY = remap(unionSharp(gateProfiles()), shiftedP);
  maxXP = [max(p.x, 0), p.y, p.z];
  centerPlane = plane([-partPlacementShift, 0, 0], -vector.dirX);
  gateCirc = remap(
    max(remap(circleXY(vector.zero.xy, gateCylinderRadius), maxXP), centerPlane),
  shiftedP);

  gatePortsField = intersectSharp(
    gatePortsXY,
    plane(capZ, [0, 0, 1]),
    -(topPlane + gatePenetration)
  );
  
  gateCircles = intersectSharp(
    gateCirc,
    plane([0, 0, gateHeight], -vector.dirZ),
    plane(capZ, vector.dirZ)
  );
  
  gates = min(gatePortsField, gateCircles);

  drainEndRadius = sprueShaftDiameter * 0.5 + drainRadius;
  drainPtA = [0, 0, drainRectZ];
  drainPtB = [0, 0, mix(drainRectZ, drainCircZ, 0.75)];
  drainPtC = [drainEndRadius - partPlacementShift, 0, drainCircZ];

  drainCap = p.z - (bottomPoint.z + gatePenetration);

  // drains = map((index, value) {
  //   return buildDrainBlended(
  //     value, drainEndProfile,
  //     drainPtA, drainPtB, drainPtC,
  //     drainSweepScaleA, shiftedP, drainCap
  //   );
  // }, drainProfiles());

  drainBlendA = buildDrainBlended(
    gatePortArcA, drainEndProfile,
    drainPtA, drainPtB, drainPtC,
    drainSweepScaleA, shiftedP, drainCap
  );

  drainBlendB = buildDrainBlended(
    gatePortArcB, drainEndProfile,
    drainPtA, drainPtB, drainPtC,
    drainSweepScaleB, shiftedP, drainCap
  );

  drainEndSphere = length(shiftedP - drainPtC) - drainRadius;

  allDrains = min(drainBlendA, drainBlendB, drainEndSphere);

  // allDrains = min(unionSharp(drains), drainEndSphere);

  partResult = remap(castPart(), shiftedP);

  return partResult, gates, allDrains;
}

partAt, gates, drainsAt = partFieldsAt(partPlacementShift);

ventStart = [partPlacementShift, 0, gateTopZ];
ventEnd = [sprueTopDiameter - sprueTopChamfer * 2, 0, sprueTopZ - sprueTopChamfer];

vent = bezierQuadRound(ventStart, [ventStart.x, 0, mix(ventStart.z, ventEnd.z, 0.75)], ventEnd) - ventRadius;

sideNoPartAt = min(gates, drainsAt, vent);
side = min(sideNoPartAt, partAt);

angles = [-pi / 3, -tau / 3, pi / 3, tau / 3];

side1 = remap(side, map.rotateXY(p, angles.x));
side2 = remap(side, map.rotateXY(p, angles.y));
side3 = remap(side, map.rotateXY(p, angles.z));
side4 = remap(side, map.rotateXY(p, angles.w));

sideNoPartAt1 = remap(sideNoPartAt, map.rotateXY(p, angles.x));
sideNoPartAt2 = remap(sideNoPartAt, map.rotateXY(p, angles.y));
sideNoPartAt3 = remap(sideNoPartAt, map.rotateXY(p, angles.z));
sideNoPartAt4 = remap(sideNoPartAt, map.rotateXY(p, angles.w));

pattern = min(side1, side2, side3, side4);
patternNoPart = min(sideNoPartAt1, sideNoPartAt2, sideNoPartAt3, sideNoPartAt4);

sprueMountHole = max(
  circleXY(vector.zero.xy, sprueHoleDiameter * 0.5),
  -p.z + sprueTopZ - sprueHoleDepth
);

sprueCone = cylinderZ(vector.zero, ramp(p.z, sprueTopBaseZ, sprueTopZ, sprueShaftDiameter * 0.5, sprueTopDiameter));
sprueTop = p.z - sprueTopZ;
sprueBottom = -p.z + drainCircZ - sprueBaseHeight;

sprueShaft = max(
  intersectChamfer(
    max(sprueCone, sprueBottom),
    sprueTop,
    sprueTopChamfer
  ), 
  -sprueMountHole
); 
 
sprue = min(
  cylinderCapped([0, 0, drainCircZ - sprueBaseHeight], [0, 0, drainCircZ], sprueBaseDiameter),
  sprueShaft
);

sprueHoleSize = sprueTopChamfer * 0.6;  // TODO declare
sprueHoleTaperFactor = 1.5;  // TODO declare
sprueHole = (abs(sprueCone - sprueTop) / sqrt2 + abs(p.y) * sprueHoleTaperFactor - (sprueCone + sprueTop + sprueHoleSize * sqrt2) / sqrt2) / sqrt3 
  - sprueHoleSize * 0.5;
  
sprueHoles = remap(sprueHole, map.patternPolarXY(12));

solidInside = min(pattern, sprue) + latticeShell;
solidOutside = max(min(patternNoPart, sprue), -sprueHoles);

latticeField = lattice.bcc(latticeCell, latticeBeamRadius);

// Lattice only inside the inner region
latticedInside = intersectRound(-latticeField, solidInside, latticeBeamRadius);

// Subtract the interior lattice cavity from the solid
result = max(solidOutside, -latticedInside);

radials = map(
  (index, ang) { return map.rotateXY(vector.dirX * partPlacementShift, ang); },
  angles
);

return meshDifference([
    meshUnion(map(
      (index, value) { return mesh(0, value, 1, partOrient); },
      radials
    )),
    solidOutside
  ],
  latticedInside
);

// par, gateCirc, drains = partFieldsAt(0);
// return  mesh(0, zero, 1, partOrient), gateCirc, drains;

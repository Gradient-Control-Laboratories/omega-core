// A multi-return wrapper that forwards a constant string into text() and
// returns multiple values (the sprue.labeled shape). It must inline so the
// string folds; multi-return values are bound at the multi-assignment.
import font "text";

label(codes, position, size) {
  // Test shadowing: "text" is local but shares its name with the auto-imported "text" package.
  text = font.left(codes, position, size);
  outline = text - 1;
  return text, outline;
}

glyphs, ring = label("Hi", [0, 0], 10);
return max(glyphs, -ring);

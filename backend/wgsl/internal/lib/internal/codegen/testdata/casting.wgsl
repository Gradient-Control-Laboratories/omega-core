fn gsl_floored(a: f32, n: f32) -> f32 {
  return a - n * floor(a / n);
}

fn gsl_partFieldsAt_remap(p: vec3<f32>) -> f32 {
  return dot(p - vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(0.0, 0.0, 1.0));
}

fn gatePortFoldedXY(p: vec3<f32>) -> gsl_struct {
  let rad = length(p.xy);
  let ang = atan2(p.x, p.y);
  let angmod = gsl_floored((ang + 0.5235988), 1.0471976) - 0.5235988;
  let foldedX = rad * sin(angmod);
  let foldedY = rad * cos(angmod);
  var gsl_result : gsl_struct;
  gsl_result.v_1 = foldedX;
  gsl_result.v_2 = foldedY;
  return gsl_result;
}

fn gatePortArcA(p: vec3<f32>) -> f32 {
  let gsl_result = gatePortFoldedXY(p);
  let foldedX = gsl_result.v_1;
  let foldedY = gsl_result.v_2;
  let annulusFieldA = abs(length(vec2<f32>(foldedX, foldedY)) - 1.2903488) - 0.075;
  let xSlabFieldA = abs(foldedX) - 0.25;
  return max(annulusFieldA, xSlabFieldA);
}

fn gatePortArcB(p: vec3<f32>) -> f32 {
  let gsl_result_2 = gatePortFoldedXY(p);
  let foldedX = gsl_result_2.v_1;
  let foldedY = gsl_result_2.v_2;
  let annulusFieldB = abs(length(vec2<f32>(foldedX, foldedY)) - 0.31016126) - 0.075;
  let xSlabFieldB = abs(foldedX) - 0.075;
  return max(annulusFieldB, xSlabFieldB);
}

fn gsl_partFieldsAt_remap_2(p: vec3<f32>) -> f32 {
  return min(gatePortArcA(p), gatePortArcB(p));
}

fn gsl_partFieldsAt_remap_3(p: vec3<f32>) -> f32 {
  return length(p.xy - vec2<f32>(0.0, 0.0)) - 1.4403487;
}

fn bezierTubeDir(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, r: f32, dir: vec3<f32>) -> gsl_struct_2 {
  let d = a - p;
  let e = b - a;
  let g = e * 2.0;
  let f = a - b * 2.0 + c;
  let ff = dot(f, f);
  let kk = 1.0 / (ff + 0.0000000001);
  let ef = dot(e, f);
  let kx = kk * ef;
  let ee = dot(e, e);
  let df = dot(d, f);
  let ky = kk * (2.0 * ee + df) / 3.0;
  let de = dot(d, e);
  let kz = kk * de;
  let qq = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
  let pp = ky - kx * kx;
  let zz = sqrt(max(-pp, 0.0));
  let v = acos(clamp(qq / (2.0 * pp * zz - 0.00000000000000000001), -1.0, 1.0)) / 3.0;
  let m = cos(v);
  let ta = clamp((m + m) * zz - kx, 0.0, 1.0);
  let eva = d + (g + f * ta) * ta;
  let da = dot(eva, eva);
  let n = sin(v) * 1.7320508;
  let tb = clamp((-n - m) * zz - kx, 0.0, 1.0);
  let evb = d + (g + f * tb) * tb;
  let dbb = dot(evb, evb);
  let tc = clamp((n - m) * zz - kx, 0.0, 1.0);
  let evc = d + (g + f * tc) * tc;
  let dc = dot(evc, evc);
  let d3 = min(min(da, dbb), dc);
  let h = qq * qq + 4.0 * pp * pp * pp;
  let sh = sqrt(max(h, 0.0));
  let w1 = (sh - qq) / 2.0;
  let u1 = sign(w1) * exp(log(max(abs(w1), 0.000000000001)) / 3.0);
  let w2 = (-sh - qq) / 2.0;
  let u2 = sign(w2) * exp(log(max(abs(w2), 0.000000000001)) / 3.0);
  let t1 = clamp(u1 + u2 - kx, 0.0, 1.0);
  let ev1 = d + (g + f * t1) * t1;
  let d1 = dot(ev1, ev1);
  let dist2 = select(d3, d1, h >= 0.0);
  let unsignedDist = sqrt(dist2) - r;
  let tBest3 = select(select(tc, tb, dbb <= dc), select(tc, ta, da <= dc), da <= dbb);
  let tBest = select(tBest3, t1, h >= 0.0);
  let closestPt = a + g * tBest + f * tBest * tBest;
  let offset = p - closestPt;
  let dirSign = sign(dot(offset, normalize(dir)));
  let signedDist = select(unsignedDist, dirSign * unsignedDist, dirSign != 0.0);
  let chordLen = length(c - a);
  let polyLen = length(b - a) + length(c - b);
  let arcLength = (chordLen + polyLen) * 0.5;
  let tangentRaw = g + f * 2.0 * tBest;
  let tangentLen = length(tangentRaw);
  let tangent = tangentRaw / (tangentLen + 0.000000000001);
  var gsl_result : gsl_struct_2;
  gsl_result.v_1 = signedDist;
  gsl_result.v_2 = tBest;
  gsl_result.v_3 = arcLength;
  gsl_result.v_4 = closestPt;
  gsl_result.v_5 = tangent;
  return gsl_result;
}

fn gsl_fn_mix(a: f32, b: f32, t: f32) -> f32 {
  return a + (b - a) * t;
}

fn drainArcAThunk(p: vec3<f32>) -> f32 {
  return gatePortArcA(p);
}

fn circleXY(p: vec3<f32>, center: vec2<f32>, radius: f32) -> f32 {
  return length(p.xy - center) - radius;
}

fn drainEndThunk(p: vec3<f32>) -> f32 {
  return circleXY(p, vec2<f32>(0.0, 0.0), 0.3989423);
}

fn gcl_closure_sweepLoftScaleSmoothSeparateCaps(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, dir: vec3<f32>, scale: f32) -> gsl_struct_3 {
  let gsl_result_3 = bezierTubeDir(p, a, b, c, 0.0, dir);
  let closestPt = gsl_result_3.v_4;
  let offset = p - closestPt;
  let tangent = gsl_result_3.v_5;
  let dirN = normalize(dir);
  let dirProj = dirN - tangent * dot(dirN, tangent);
  let dirProjLen = length(dirProj);
  let frameB = dirProj / (dirProjLen + 0.000000000001);
  let frameN = cross(tangent, frameB);
  let localX = dot(offset, frameN);
  let tParam = gsl_result_3.v_2;
  let tClamped = clamp(tParam, 0.0, 1.0);
  let tSmooth = tClamped * tClamped * (3.0 - 2.0 * tClamped);
  let startScale = gsl_fn_mix(1.0, scale, tSmooth);
  let localY = dot(offset, frameB);
  let startLocalPt = vec3<f32>(localX / startScale, localY / startScale, 0.0);
  let startDist = drainArcAThunk(startLocalPt) * startScale;
  let invScale = 1.0 / scale;
  let endScale = gsl_fn_mix(invScale, 1.0, tSmooth);
  let endLocalPt = vec3<f32>(localX / endScale, localY / endScale, 0.0);
  let endDist = drainEndThunk(endLocalPt) * endScale;
  let profileDist = gsl_fn_mix(startDist, endDist, tSmooth);
  let tangentA = normalize((b - a) * 2.0);
  let capA = -dot(p - a, tangentA);
  let tangentC = normalize((c - b) * 2.0);
  let capC = dot(p - c, tangentC);
  var gsl_result : gsl_struct_3;
  gsl_result.v_1 = profileDist;
  gsl_result.v_2 = capA;
  gsl_result.v_3 = capC;
  return gsl_result;
}


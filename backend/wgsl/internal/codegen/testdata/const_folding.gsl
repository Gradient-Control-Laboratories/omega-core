x = 2 + 3;
y = [1, 2] + [3, 4];
z = 5 * 6 - 4 / 2 + 3 - 2 - 1;
w = 5 % 2;

bool1 = 1 && 1;
bool2 = 0 || 1;

s2 = select(bool1 && bool2, 1.0, 0.0);
s3_true = 1.0 ? 10.0 : 20.0;
s3_false = 0.0 ? 10.0 : 20.0;
s3_gt = 1.0 ? 10.0 : 20.0 : 30.0;
s3_eq = 0.0 ? 10.0 : 20.0 : 30.0;
s3_lt = -1.0 ? 10.0 : 20.0 : 30.0;

cond1 = [1.0, 0.0];
res1 = cond1 ? [10.0, 20.0] : [30.0, 40.0];

cond2 = [1.0, 0.0, -1.0];
res2 = cond2 ? [10, 20, 30] : [40, 50, 60] : [70, 80, 90];

txt = "Hello";

text2 = map((c, i) { return c + 1; }, txt);

return
    x + length(y) + z + w + s2 + s3_true + s3_false + s3_gt + s3_eq + s3_lt
        + res1.x + res1.y + res2.x + res2.y + res2[2],
    txt[0] + txt[1] + txt[2] + txt[3] + txt[4],
    text2[0] + text2[1] + text2[2] + text2[3] + text2[4];

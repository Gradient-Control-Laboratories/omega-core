// Test: function that destructures a multi-return call
// AND itself returns multiple values.
// This previously caused a gsl_result redeclaration in WGSL.

inner() {
  return p.x, p.y;
}

outer() {
  a, b = inner();
  sum = a + b;
  diff = a - b;
  return sum, diff;
}

// Test: a multi-return function called with different thunk arguments.
// Both specializations produce the same struct type, which must only
// be declared once in the output.

thunkA() {
  return p.x;
}

thunkB() {
  return p.y;
}

wrapper(thunk) {
  a, b = inner();
  blended = a + thunk();
  return blended, b;
}

s, d = outer();
wa, wb = wrapper(thunkA);
wc, wd = wrapper(thunkB);
return s + d + wa + wb + wc + wd;

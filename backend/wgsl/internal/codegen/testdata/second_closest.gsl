
box(p1, p2) {
  return intersectSharp([
  p1.x - p.x, p.x - p2.x,
  p1.y - p.y, p.y - p2.y,
  p1.z - p.z, p.z - p2.z
  ]);
}

threeShapes() {
  s = sphere(0.8);
  r = box([0.3, 0.3, -1.2], [1.2, 1.2, 1.2]);
  t = torus(1.3, 0.2);

  return s, r, t;
}

s, r, t = threeShapes();

combined = unionSharp(s, r, t);
edges = length([combined, combined.second]);
combined.color = ramp(edges, 0.005, 0.01, color.darkGray, color.white);

return combined;

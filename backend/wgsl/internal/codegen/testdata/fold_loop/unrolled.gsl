// Folds that stay unrolled: too few elements, and a list indexed by the
// element.
few(q) {
  return reduce(0.0, (acc, i) { return acc + length(q - [i, 0, 0]); }, [0, 1, 2]);
}
indexed(q) {
  ks = [1, 2, 3, 4, 5, 6, 7, 8, 9];
  return reduce(0.0, (acc, i) { return acc + ks[i] * q.x; }, [0, 1, 2, 3, 4, 5, 6, 7, 8]);
}
return sphere(p, 10 + few(p) + indexed(p));

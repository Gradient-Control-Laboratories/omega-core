a = 1;
b = 2;

c = a < b;
d = a <=> b;
e = a < b;

f = a < b ? 4 : 5;
g = a <=> b ? 4 : 5 : 6;


// e1 = 1 ? ( 2 ? 3 : 4 ? 5 : 6 ) : 7;
// e2 = 1 ? ( 2 ? 3 : 3.5 : 4 ? 5 : 6 ) : 7;


h = a < b ?
  c < b ? 0 : 1 :
  d < b ?
    (e < b ? 2 : 3) :
    f < b ? 4 : 5;

i = a < b ?
  (c < b ? 0 : 1) :
  (d < b ?
    (e < b ? 2 : 3) :
    (f < b ? 4 : 5));

k = a < 0.5 ? b :
      a < 1.5 ? c :
      a < 2.5 ? d :
      a < 3.5 ? f :
      a < 7.5 ? g : h;

return g, h, i, k;

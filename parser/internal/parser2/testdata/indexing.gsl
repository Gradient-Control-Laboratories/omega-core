
// a0 = []; // ERROR: 4 collections cannot be empty
a1 = [1];
a2 = [1, 2];
a3 = [1, 2, 3];
a4 = [1, 2, 3, 4];
a5 = [1, 2, 3, 4, 5];
a6 = [1, 2, 3, 4, 5, 6];

foo(value) {
    return [value, value + 1, value + 2, value + 3, value + 4, value + 5];
}

// a3[0] = 1;  // ERROR: 95 unexpected token "["

return a1[0] + a3[0] + a3[2] + foo(2)[0] + foo(3)[5];

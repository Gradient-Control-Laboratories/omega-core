// Ink width (max x, font units) per code, for proportional spacing.
// Missing codes (e.g. space) fall through to a default advance.
glyphWidth(code) {
  return
    (code < 97) ? glyphWidth_dispatch_0(code) :
    (code < 196) ? glyphWidth_dispatch_1(code) :
    (code < 260) ? glyphWidth_dispatch_2(code) :
    (code < 324) ? glyphWidth_dispatch_3(code) :
    (code < 917) ? glyphWidth_dispatch_4(code) :
    (code < 1058) ? glyphWidth_dispatch_5(code) :
    (code < 8595) ? glyphWidth_dispatch_6(code) :
    (code < 12302) ? glyphWidth_dispatch_7(code) :
    glyphWidth_dispatch_8(code);
}

/// Render character codes (e.g. a string literal "Hi") as proportionally-spaced
/// left-aligned text in the XY plane (the position is the lower-left corner of
/// the first glyph); see center() and right() for the other justifications.
///   codes:     character codes / string literal
///   position:  [x, y] of the text origin (lower-left of the first glyph)
///   size:      cap height in output units
///   thickness: stroke radius, as a fraction of cap height
///   spacing:   inter-glyph gap (tracking), as a fraction of cap height
/// thickness and spacing are relative metrics, so they scale with size.
/// Returns a 2D SDF; extrude with e.g. max(..., abs(p.z) - t) for a solid.
// The fold threads [cursor, field] so each glyph advances by its own width.
// Cost note: glyph(code) is branchless, so every glyph in the dispatch is
// evaluated per character — best for short strings / small glyph sets.
left(codes, position, size, thickness, spacing) {

  // These values are inlined so that the text func will be inlined
  // scale = size / 9;
  // q = p.xy - position;

  return reduce([0, 1000000],
    (acc, code) {
      return [acc.x + glyphWidth(code) + spacing * 9, min(acc.y,
        remap(glyph(code), [(p.x - position.x) / (size / 9) - acc.x, (p.y - position.y) / (size / 9), p.z / (size / 9)]))];
    },
    codes).y * (size / 9) - thickness * size;
}

/// Convenience overload with default thickness and spacing.
left(codes, position, size) {
  return left(codes, position, size, fontStroke(), fontSpacing());
}

/// Width of a span of text in output units, matching the horizontal extent
/// left() lays out: from the left edge of the first glyph to the right edge of
/// the last (ink only — the stroke radius is symmetric and not included).
///   codes:    character codes / string literal
///   size:     cap height in output units
///   spacing:  inter-glyph gap (tracking), as a fraction of cap height
// reduce advances by glyphWidth + spacing*9 per glyph (the same step left()
// threads through its cursor); the trailing spacing after the last glyph is
// dropped so the result is the rendered extent, not the next cursor position.
width(codes, size, spacing) {
  return (reduce(0,
    (acc, code) {
      return acc + glyphWidth(code) + spacing * 9;
    },
    codes) - spacing * 9) * (size / 9);
}

/// Convenience overload with default spacing.
width(codes, size) {
  return width(codes, size, fontSpacing());
}

/// Render text horizontally centered on position.x (position.y is the baseline).
/// Same parameters as left().
center(codes, position, size, thickness, spacing) {
  return left(codes, [position.x - width(codes, size, spacing) / 2, position.y], size, thickness, spacing);
}

/// Convenience overload with default thickness and spacing.
center(codes, position, size) {
  return center(codes, position, size, fontStroke(), fontSpacing());
}

/// Render text right-justified so position.x is the right edge (position.y is
/// the baseline). Same parameters as left().
right(codes, position, size, thickness, spacing) {
  return left(codes, [position.x - width(codes, size, spacing), position.y], size, thickness, spacing);
}

/// Convenience overload with default thickness and spacing.
right(codes, position, size) {
  return right(codes, position, size, fontStroke(), fontSpacing());
}

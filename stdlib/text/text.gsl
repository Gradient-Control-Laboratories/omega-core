/// A pen-stroke font in the XY plane: `text.left`, `text.center` and
/// `text.right` lay out a string, and `text.width` measures it.

// Generated by cxf2gsl from a QCAD CXF font — do not edit by hand.
// A pen-stroke font: each glyph is a union of line/arc centerline
// distances in the XY plane; left() applies the stroke radius and size.
// Self-contained (no imports).
//
// Only the public entry points (fontStroke, fontSpacing, text) carry
// `///` docs and are surfaced in the AI preamble / Libraries panel. The
// per-glyph functions, dispatch chunks, and 2D-distance helpers stay on
// plain `//` so they're treated as internal implementation.

/// Default stroke radius, as a fraction of cap height.
fontStroke() {
  return 0.0389;
}

/// Default inter-glyph spacing (tracking), as a fraction of cap height.
fontSpacing() {
  return 0.3333;
}

// Distance to a line segment centerline between 2D points a and b.
segmentDist(a, b) {
  pa = p.xy - a;
  ba = b - a;
  h = clamp(dot(pa, ba) / dot(ba, ba), 0, 1);
  return length(pa - ba * h);
}

// Distance to a circular arc centerline: center (cx, cy), radius ra,
// bisector angle mid and half-aperture half (radians). Evaluated in a frame
// rotated so the bisector points along +Y.
arcDist(cx, cy, ra, mid, half) {
  dx = p.x - cx;
  dy = p.y - cy;
  rot = 1.5707963267948966 - mid;
  ca = cos(rot);
  sa = sin(rot);
  rx = dx * ca - dy * sa;
  ry = dx * sa + dy * ca;
  scx = sin(half);
  scy = cos(half);
  pxAbs = abs(rx);
  inside = scy * pxAbs > scx * ry;
  wx = pxAbs - ra * scx;
  wy = ry - ra * scy;
  dInside = length([wx, wy]);
  l = length([pxAbs, ry]);
  dOutside = abs(l - ra);
  return inside ? dInside : dOutside;
}

// 0x0021 '!'
glyph_0021() {
  return min(
    segmentDist([0, 9], [0, 3]),
    segmentDist([0, 0], [0, 0.5])
  );
}

// 0x0022 '"'
glyph_0022() {
  return min(
    segmentDist([0.5, 7], [1, 9]),
    segmentDist([3.5, 7], [4, 9])
  );
}

// 0x0023 '#'
glyph_0023() {
  return min(
    segmentDist([2, 0], [2, 9]),
    segmentDist([5, 9], [5, 0]),
    segmentDist([0, 2.5], [7, 2.5]),
    segmentDist([7, 6.5], [0, 6.5])
  );
}

// 0x0024 '$'
glyph_0024() {
  return min(
    arcDist(1.9994, 2.3723, 6.6277, 1.3358, 0.2349),
    arcDist(2.0001, 7, 2, 2.906, 1.3351),
    segmentDist([1.092, 5.218], [3.909, 3.782]),
    arcDist(3.0002, 2.0002, 2.0002, -0.2359, 1.335),
    arcDist(3.0001, 6.6259, 6.6259, -1.8055, 0.2347),
    segmentDist([2.5, -1], [2.5, 10])
  );
}


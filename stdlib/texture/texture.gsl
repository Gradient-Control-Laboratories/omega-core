
// Texture Library (texture)
//
// Shared helpers for the material family (material/stone, material/wood,
// material/weathering, material/playful, material/natural): each preset in
// those packages composes noise + color + material via the same small set
// of idioms defined here, so no preset re-derives its own threshold or
// blend math.
//
// Taxonomy discipline, applied throughout the whole family: gradient/fbm ->
// broad color blotches and banding; cellular/cellularF1F2 (F1, cell
// membership) -> speckle/grain per-region tone; cellularEdges -> crack,
// joint, and vein networks. Each preset uses exactly one of these per
// effect, so techniques don't duplicate across presets with different names.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "noise";
import "color";
import "material";
import "ease";

/// mask(field, edge, width): a soft 0..1 threshold of `field` centered at
/// `edge` with transition half-width `width` (ease.quadratic — smoothstep —
/// over a clamp), i.e. 0 well below edge, 1 well above, smooth between. The
/// shared threshold every paint/paintMaterial call below is built on.
mask(field, edge, width) {
  t = clamp((field - edge) / width * 0.5 + 0.5, 0, 1);
  return ease.quadratic(t);
}

/// fadeDetail(size): how much of a feature `size` mm across the screen can
/// show where it is being drawn: 1 while it spans four pixels or more, falling
/// to 0 by the time it spans two (pixelSize() against size). Multiply a fine
/// feature's contrast by it, or blend the feature toward its average color, so
/// detail too small to resolve fades instead of shimmering. It is 1 wherever
/// nothing is drawn to a screen (meshing, export), so those keep full detail.
fadeDetail(size) {
  return 1 - mask(pixelSize(), 0.375 * size, 0.125 * size);
}

/// coverageLine(distance, width): a line `width` wide, 0 to 1, from the
/// distance to its centre, both in world units. A line thinner than a pixel is
/// drawn a pixel wide (pixelSize()) and as much fainter, so it keeps its share
/// of the pixel rather than fading away or breaking into dashes. Wherever
/// nothing is drawn to a screen it is the line itself.
coverageLine(distance, width) {
  half = max(0.5 * width, 0.5 * pixelSize());
  return (1 - mask(distance, half, 0.25 * half)) * 0.5 * width / half;
}

/// paint(field, edge, width, colorA, colorB): colorA below `edge`, colorB
/// above, blended across `width` via mask() and mixed perceptually
/// (color.mixOklab) — the generalized form of the existing
/// `color.mixOklab(steel, dark, thread.stripe(...))` idiom, so every texture
/// preset paints a scalar field the same way.
paint(field, edge, width, colorA, colorB) {
  return color.mixOklab(colorA, colorB, mask(field, edge, width));
}

/// paintMaterial(field, edge, width, matA, matB): matA below `edge`, matB
/// above, blended across `width` via mask() and material.blend — the
/// material-record sibling of paint().
paintMaterial(field, edge, width, matA, matB) {
  return material.blend(matA, matB, mask(field, edge, width));
}

/// domainWarp(size, strength): a warped point, for use as remap()'s second
/// argument, built from three noise.gradient taps at fixed decorrelating
/// offsets (the same shear-offset rationale as noise.gsl's cellHash4: avoid
/// aliasing with the hash tile's period). FOR COLOR AND RENDER-ONLY
/// DISPLACEMENT INPUTS ONLY: this warps the sample point, not a certified
/// distance value, so feeding the warped point into real subtractive SDF
/// geometry needs its own fresh Lipschitz analysis — it does not inherit any
/// bound from noise.gradient/gradientBump.
domainWarp(size, strength) {
  wx = noise.gradient(size);
  wy = remap(noise.gradient(size), p + [37.0, 0.0, 0.0]);
  wz = remap(noise.gradient(size), p + [0.0, 59.0, 0.0]);
  return p + [wx, wy, wz] * strength;
}

/// flow(velocity, period, sampleFn): a pattern carried along by a flow that
/// may vary from place to place, without the pattern smearing. sampleFn(q)
/// gives the pattern at a point q in world units; velocity is the flow at p in
/// world units per second, a constant or a field. Two copies of the pattern
/// ride the flow, each for one `period` of seconds before it starts again where
/// it began, half a period apart, and each fades out as it restarts (Vlachos
/// 2010), so neither is ever stretched by more than a period's travel. Each
/// restart draws the copy from a new part of the pattern, so it never repeats.
/// The mix is divided by the root of its weights' sum of squares, so a
/// zero-mean pattern keeps its contrast through the crossfade instead of
/// dimming at its middle: give sampleFn a pattern around zero and add its mean
/// afterwards. A shorter period stretches less and pulses more. The mix is up
/// to 1.42 times as steep as the pattern, and more where the flow shears.
/// Inside a library function, use flowPoints and flowMix instead: a lambda
/// passed from one there captures every local before it.
flow(velocity, period, sampleFn) {
  a, b, weight = flowPoints(velocity, period);
  return flowMix(sampleFn(a), sampleFn(b), weight);
}

/// flowPoints(velocity, period): the two points flow samples its pattern at,
/// and the first one's weight: sample the pattern at both and pass the two
/// values and the weight to flowMix, as flow does. Returns a, b and weight.
flowPoints(velocity, period) {
  cycles = time / period;
  phase = fract(cycles);
  phaseB = fract(cycles + 0.5);
  cycle = floor(cycles);
  cycleB = floor(cycles + 0.5);
  a = p - velocity * period * phase + [cycle * 37.3, cycle * 11.9, cycle * 23.1];
  b = p - velocity * period * phaseB + [cycleB * 37.3 + 17.7, cycleB * 11.9 + 5.3, cycleB * 23.1 + 29.9];
  return a, b, 1 - abs(1 - 2 * phase);
}

/// flowMix(a, b, weight): flow's mix of the pattern sampled at flowPoints' two
/// points, a with `weight` and b with the rest, divided by the root of the
/// weights' sum of squares.
flowMix(a, b, weight) {
  return (weight * a + (1 - weight) * b) / sqrt(weight * weight + (1 - weight) * (1 - weight));
}

// --- Filtering at the pixel ---
//
// Each kind of pattern loses its detail at the pixel in its own way: a line
// or a dot keeps its share of the pixel's area, a periodic step is averaged
// over the pixel exactly, any other feature fades to its own average, and
// relief finer than the pixel turns into the roughness its hidden slopes
// make. Off a screen pixelSize() is 0, and each of these is the pattern
// itself.

/// fadeTo(value, mean, size): value where a feature `size` mm across shows on
/// screen, fading to `mean`, its average over the pattern, as it shrinks past
/// a few pixels (fadeDetail), so detail too small to resolve settles to what
/// it averages to rather than shimmering.
fadeTo(value, mean, size) {
  return mean + (value - mean) * fadeDetail(size);
}

/// coverageDisc(distance, radius): a dot `radius` mm across, 0 to 1, from the
/// distance to its centre, with an edge half a pixel soft. A dot smaller than
/// a pixel is drawn a pixel wide and as much fainter, so it keeps its share of
/// the pixel's area, as coverageLine does for a line.
coverageDisc(distance, radius) {
  drawn = max(radius, 0.5 * pixelSize());
  soft = max(0.5 * pixelSize(), 0.01 * radius);
  return (1 - mask(distance, drawn, soft)) * (radius / drawn) * (radius / drawn);
}

// The integral from 0 to x of a square wave of `period`, 0 over the first
// half of each period and 1 over the second.
squareWaveIntegral(x, period) {
  whole = floor(x / period);
  return whole * 0.5 * period + max(x - whole * period - 0.5 * period, 0);
}

/// squareWave(x, period): a square wave of `period`, 0 over the first half of
/// each period and 1 over the second, averaged exactly over a pixel's width
/// about x, so its steps blur by what a pixel sees and settle to 0.5 once the
/// period is under a pixel.
squareWave(x, period) {
  width = pixelSize();
  exact = fract(x / period) < 0.5 ? 0 : 1;
  averaged = (squareWaveIntegral(x + 0.5 * width, period) - squareWaveIntegral(x - 0.5 * width, period)) / max(width, 0.000001);
  return width > 0.0001 * period ? averaged : exact;
}

/// reliefRoughness(roughness, slope, size): the roughness of a surface whose
/// relief, `size` mm across with slopes of `slope` (rise over run, root mean
/// square), is too small to resolve or not drawn (displacementDrawn()): its
/// slopes, lost with it, spread the highlight as roughness does (Toksvig
/// 2005). The roughness itself while the relief shows. Fade the relief with
/// fadeDetail(size) alongside.
reliefRoughness(roughness, slope, size) {
  return sqrt(roughness * roughness + (1 - fadeDetail(size) * displacementDrawn()) * slope * slope);
}

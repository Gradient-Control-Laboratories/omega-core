/// ISO 7045 pan head diameter dk, the head ISO 14583 shares. Zero outside M1.6 to M10.
panHeadDia(nominal) {
  k = nominal;
  return reduce((acc, v) { return acc + v; },
                map((r) { return r[1] * onRow(k, r[0], 0.0001); },
                    pan7045));
}

/// ISO 7045 pan head height k.
panHeadHeight(nominal) {
  k = nominal;

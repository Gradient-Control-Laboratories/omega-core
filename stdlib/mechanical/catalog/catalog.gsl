// ISO 4762 nominal lengths l, the series every size is made in some run of —
// an M6 at 10, 12, 16, then 20 to 60 by 5. Which run each size is made in is
// NOT here: shcsLength answers with the series alone. Read off the length
// table of ISO 4762, as reproduced at
// https://www.fasteners.eu/standards/ISO/4762/ and, for M6's run,
// https://www.engineersedge.com/iso_socket_head_screw.htm
shcsLengths = [2.5, 3.0, 4.0, 5.0, 6.0, 8.0, 10.0, 12.0, 16.0, 20.0, 25.0, 30.0,
               35.0, 40.0, 45.0, 50.0, 55.0, 60.0, 65.0, 70.0, 80.0, 90.0, 100.0,
               110.0, 120.0, 130.0, 140.0, 150.0, 160.0, 180.0, 200.0, 220.0,
               240.0, 260.0, 280.0, 300.0];

/// The shortest ISO 4762 nominal length that is at least `minLength`:
/// catalog.shcsLength(17.0) is 20. Zero past 300, the end of the series, and
/// a zero length builds nothing.
shcsLength(minLength) {
  m = minLength;
  l = reduce((acc, v) { return min(acc, v); },
             map((r) { return r + 1000000.0 * clamp(sign(m - r - 0.0001), 0.0, 1.0); },
                 shcsLengths));
  return l * clamp(sign(300.0001 - l), 0.0, 1.0);
}

// ISO 10642 NOMINAL LENGTHS l — overall, the head included, since a flat head
// seats flush and the screw is measured from the surface. One series for the
// standard: ISO 10642:2004 Table 1 lists every length from 8 to 100, and the
// sizes each length is made in are drawn there as stepped lines, which this
// table does not keep (an M3 x 100 is in the series and not in a catalog).
// Read off the ISO 10642:2004 preview's Table 1,
// https://cdn.standards.iteh.ai/samples/34454/32dec7e84d974361b85f744935ab2175/ISO-10642-2004.pdf
cskLengths = [8.0, 10.0, 12.0, 16.0, 20.0, 25.0, 30.0, 35.0, 40.0, 45.0, 50.0,
              55.0, 60.0, 65.0, 70.0, 80.0, 90.0, 100.0];

/// The shortest ISO 10642 nominal length that is at least `minLength`:
/// catalog.cskLength(9.0) is 10. Zero past 100, the end of the series, and a
/// zero length builds nothing.
cskLength(minLength) {
  m = minLength;
  l = reduce((acc, v) { return min(acc, v); },
             map((r) { return r + 1000000.0 * clamp(sign(m - r - 0.0001), 0.0, 1.0); },
                 cskLengths));
  return l * clamp(sign(100.0001 - l), 0.0, 1.0);
}


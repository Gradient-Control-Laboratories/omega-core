/// Involute curves and parametric spur, helical and bevel gears, gear pairs and
/// racks.


// Gears Library (gears)
//
// Involute curves and the parametric spur/helical gears built from them. The
// involute is the standard flank profile for meshing gear teeth; gearProfile
// tiles a single involute tooth into a 2D profile, and gear / gearPair extrude
// and pair them into 3D parts.
//
// Built from builtin's CSG primitives and constants (circleXY,
// intersectChamfer, unionRound/Chamfer, cylinderZ, pi) and vector.zero.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

// =========================================================
// Involutes
// =========================================================

/// Involute curve of a circle of given radius, in the XY plane. Inside
/// the base circle the field is the perimeter distance (so the curve
/// can be revolved cleanly); outside, it's the true distance to the
/// involute.
involute(radius) {
  rho = length(p.xy);
  // The max-guards are the identity wherever their value is used (the
  // rho > radius branch), but keep the other branch finite under interval
  // evaluation — a cell's rho can span 0 or sit inside the base circle,
  // and sqrt/divide would bound it as NaN at every subdivision scale.
  tanLen = sqrt(max(rho * rho - radius * radius, 0.0));
  ang = atan(p.y, p.x);
  ratioVal = radius / max(rho, radius);
  invField = tanLen - (acos(ratioVal) + ang) * radius;
  circumField = neg(ang) * radius;
  result = (rho > radius) ? invField : circumField;
  return result;
}

/// Variant of involute() used for gear-tooth flanks: inside the base
/// circle the field is -p.y (radial), so unioning two reflected
/// involutes through rotation closes off a clean tooth shape.
involuteRadial(radius) {
  rho = length(p.xy);
  // Same interval-totality max-guards as involute() above.
  tanLen = sqrt(max(rho * rho - radius * radius, 0.0));
  ang = atan(p.y, p.x);
  ratioVal = radius / max(rho, radius);
  invField = tanLen - (acos(ratioVal) + ang) * radius;
  radialField = neg(p.y);
  result = (rho > radius) ? invField : radialField;
  return result;
}

// =========================================================
// Spur Gears
// =========================================================

/// 2D gear profile centered at the origin in the XY plane. `rotOffset`
/// spins the profile about Z by the given angle.
//
// Internal: tooth flanks are involute curves (involuteRadial); the
// addendum and root circles come from circleXY; teeth and root are
// blended with chamfer/round unions.
gearProfile(numTeeth, moduleVal, pressureAngle, rotOffset, dedendumClearance, kSmall) {
  pitchRadius = (numTeeth / 2.0) * moduleVal;
  baseRadius = pitchRadius * cos(pressureAngle);
  addendumRadius = pitchRadius + moduleVal;
  dedendumRadius = pitchRadius - (1 + dedendumClearance) * moduleVal;
  roundK = dedendumClearance * moduleVal;

  pitchAngle = pi / numTeeth;
  halfPitchAngle = pitchAngle / 2;

  prRatio = pitchRadius / baseRadius;
  gammaP = sqrt(prRatio * prRatio - 1);
  contactAngle = gammaP - atan(gammaP);
  rotAngle = halfPitchAngle - contactAngle;
  cosR = cos(rotAngle);
  sinR = sin(rotAngle);

  rotInv() {
    rx = p.x * cosR + p.y * sinR;
    ry = neg(p.x) * sinR + p.y * cosR;
    return remap(involuteRadial(baseRadius), [rx, ry, p.z]);
  }

  reflInv() {
    return remap(rotInv(), [p.x, neg(p.y), p.z]);
  }

  singleTooth() {
    left = rotInv();
    right = reflInv();
    return min(left, right);
  }

  cosO = cos(rotOffset);
  sinO = sin(rotOffset);
  opx = p.x * cosO + p.y * sinO;
  opy = neg(p.x) * sinO + p.y * cosO;

  pRho = length([opx, opy]);
  pAngle = atan(opy, opx);
  pAngleShifted = pAngle + pitchAngle;
  twicePitchAngle = pitchAngle * 2;
  pAngleMod = ((pAngleShifted % twicePitchAngle) + twicePitchAngle) % twicePitchAngle;
  pAngleCentered = pAngleMod - pitchAngle;
  rpx = pRho * cos(pAngleCentered);
  rpy = pRho * sin(pAngleCentered);

  repeatedTooth = remap(singleTooth(), [rpx, rpy, p.z]);
  addClip = remap(circleXY([0, 0], addendumRadius), [opx, opy, p.z]);
  toothProfile = intersectChamfer(repeatedTooth, addClip, kSmall);
  dedBody = remap(circleXY([0, 0], dedendumRadius), [opx, opy, p.z]);
  return unionRound(toothProfile, dedBody, roundK);
}

// gearReach: how far a spur gear reaches from its axis, its addendum circle,
// or its standoff's chamfer where that is wider. A chamfer union adds material
// only where both sides are within the chamfer of their surfaces, and the
// standoff's side is never less than its cylinder's distance.
gearReach(numTeeth, moduleVal, standoffDiameter, standoffChamfer) {
  return max((numTeeth / 2.0 + 1.0) * moduleVal, standoffDiameter / 2 + standoffChamfer);
}

// gearTop: the top of a spur gear, its face or its standoff, or the chamfer
// between them where the standoff is the shorter; the bottom is its face, or
// that chamfer again where the standoff's foot at z = 0 blends into it.
gearTop(thickness, standoffHeight, standoffChamfer) {
  return max(thickness / 2, standoffHeight, min(thickness / 2, standoffHeight) + standoffChamfer);
}

gearBottom(thickness, standoffChamfer) {
  return neg(max(thickness / 2, standoffChamfer));
}

/// 3D gear: extrudes gearProfile along Z with an optional helix, adds
/// a cylindrical standoff on the +Z face, and drills a concentric
/// through-bore.
gear(numTeeth, moduleVal, pressureAngle, rotOffset, thickness, helixAngle, standoffDiameter, standoffHeight, standoffChamfer, boreDiameter, dedendumClearance, kSmall) {
  pitchRadius = (numTeeth / 2.0) * moduleVal;
  twistRate = tan(helixAngle) / pitchRadius;
  twistAngle = p.z * twistRate;
  cosTw = cos(twistAngle);
  sinTw = sin(twistAngle);
  tpx = p.x * cosTw + p.y * sinTw;
  tpy = neg(p.x) * sinTw + p.y * cosTw;
  profile = remap(gearProfile(numTeeth, moduleVal, pressureAngle, rotOffset, dedendumClearance, kSmall), [tpx, tpy, p.z]);
  slab = abs(p.z) - thickness / 2;
  gearBody = intersectChamfer(profile, slab, kSmall);

  standoffRadius = standoffDiameter / 2;
  standoffCyl = cylinderZ(vector.zero, standoffRadius);
  standoffSlabZ = intersectChamfer(neg(p.z), p.z - standoffHeight, kSmall);
  standoffSolid = intersectChamfer(standoffCyl, standoffSlabZ, kSmall);

  withStandoff = unionChamfer(gearBody, standoffSolid, standoffChamfer);

  boreRadius = boreDiameter / 2;
  bore = cylinderZ(vector.zero, boreRadius);

  reach = gearReach(numTeeth, moduleVal, standoffDiameter, standoffChamfer);
  form = differenceChamfer(withStandoff, bore, kSmall);
  form.box = [[neg(reach), neg(reach), gearBottom(thickness, standoffChamfer)],
              [reach, reach, gearTop(thickness, standoffHeight, standoffChamfer)]];
  return form;
}

// =========================================================
// Racks
// =========================================================

/// 2D basic-rack profile in the XY plane — the straight-flank rack that
/// meshes with gearProfile of the same module and pressure angle. A rack
/// tooth is four planes: two flanks at the pressure angle, the tip, and
/// the root plane its bar hangs from. Teeth point +Y with the pitch line
/// at y = 0 (tips at y = moduleVal, roots at
/// y = -(1 + dedendumClearance) * moduleVal), and the body fills
/// everything below the root line, so the caller bounds the bar — see
/// rack. `shift` slides the rack along X with a tooth centered at
/// x = shift; pass rackShift() to stay in step with a meshing gear.
/// `backlash` thins every tooth by that much in total, giving the mesh a
/// running clearance (0 is the theoretical rack, whose flanks touch the
/// gear's). `dedendumClearance` and `kSmall` mean what they do for
/// gearProfile: extra root depth with a fillet of that radius, and a small
/// chamfer breaking the tip corners.
//
// Internal: a flank is the half-plane |x| <= halfThickness - y*tan(a),
// scaled by cos(a) to keep the field unit-gradient. The centered modulo
// makes the nearest tooth always the one in the cell, so the repeat needs
// no neighbor search.
rackProfile(moduleVal, pressureAngle, shift, backlash, dedendumClearance, kSmall) {
  circPitch = pi * moduleVal;
  halfThickness = circPitch / 4 - backlash / 2;
  dedendum = (1 + dedendumClearance) * moduleVal;

  sx = p.x - shift + circPitch / 2;
  xm = ((sx % circPitch) + circPitch) % circPitch - circPitch / 2;

  flanks = (abs(xm) - halfThickness) * cos(pressureAngle) + p.y * sin(pressureAngle);
  tooth = intersectChamfer(flanks, p.y - moduleVal, kSmall);
  body = p.y + dedendum;
  return unionRound(tooth, body, dedendumClearance * moduleVal);
}

/// The rack `shift` that holds a rack in mesh with a gear of the given
/// tooth count rolling along it, while the rack travels by `travel` and
/// the gear turns by travel / pitchRadius. The gear's pitch circle unrolls
/// onto the rack's pitch line, so the phase constant is a quarter turn of
/// that arc. Verified by measurement rather than by eye — see
/// TestRackAndPinionMesh, which reads the mesh clearance across a full
/// tooth pitch of travel.
rackShift(numTeeth, moduleVal, travel) {
  pitchRadius = (numTeeth / 2.0) * moduleVal;
  return travel + pitchRadius * pi / 2;
}

/// 3D rack: extrudes rackProfile along Z, bounded to a length along X, a
/// depth below the pitch line, and a thickness in Z (centered on the
/// origin except depth, which hangs below the pitch line y = 0).
rack(moduleVal, pressureAngle, shift, backlash, length, depth, thickness, dedendumClearance, kSmall) {
  profile = rackProfile(moduleVal, pressureAngle, shift, backlash, dedendumClearance, kSmall);
  bounds = max(abs(p.x) - length / 2, neg(p.y) - depth, abs(p.z) - thickness / 2);
  form = intersectChamfer(profile, bounds, kSmall);
  // The tooth tips are the top; the fillets at their roots stay below them.
  form.box = [[neg(length) / 2, neg(depth), neg(thickness) / 2],
              [length / 2, moduleVal, thickness / 2]];
  return form;
}

/// A pinion and the rack it drives, in mesh, returned as a multi-value
/// (pinion, rack) of 2D profiles. The pinion is centered at the origin and
/// the rack's pitch line lies at y = -pitchRadius with its teeth pointing
/// up, so the pair rolls without slipping: `travel` slides the rack along
/// X and turns the pinion by travel / pitchRadius, keeping the mesh in
/// step at every travel. Give `backlash` a few hundredths of the module
/// for a running fit. The involute undercut limit still applies: below
/// about 2/sin(pressureAngle)^2 teeth (17 at 20 degrees) a pure-involute
/// pinion and a full-depth rack foul near the root, exactly as real gears
/// do — use more teeth, or relieve the rack tip.
rackAndPinion(numTeeth, moduleVal, pressureAngle, travel, backlash, dedendumClearance, kSmall) {
  pitchRadius = (numTeeth / 2.0) * moduleVal;
  pinion = gearProfile(numTeeth, moduleVal, pressureAngle, travel / pitchRadius, dedendumClearance, kSmall);
  rackAt = rackProfile(moduleVal, pressureAngle, rackShift(numTeeth, moduleVal, travel), backlash, dedendumClearance, kSmall);
  return pinion, remap(rackAt, [p.x, p.y + pitchRadius, p.z]);
}

/// Two meshing gears placed along X so their pitch circles are
/// tangent, returned as a multi-value (g1, g2). `phase` advances both
/// gears in lock-step (gear 1 by pitchAng1 * phase * 2; gear 2 by
/// pitchAng2 * phase * 2, in the opposite direction) — pass e.g.
/// mod(time, 1) to animate.
gearPair(numTeeth1, numTeeth2, moduleVal, pressureAngle, thickness, helixAngle, standoffDiam1, standoffDiam2, standoffHeight, standoffChamfer, boreDiam1, boreDiam2, dedendumClearance, kSmall, phase) {
  pitchR1 = (numTeeth1 / 2.0) * moduleVal;
  pitchR2 = (numTeeth2 / 2.0) * moduleVal;

  pitchAng1 = pi / numTeeth1;
  pitchAng2 = pi / numTeeth2;

  rot1 = pitchAng1 * 0.5 + pitchAng1 * phase * 2;
  rot2 = neg(pitchAng2) * 0.5 + pitchAng2 * phase * 2;

  // Each gear's own box, moved along x to where it sits; the second one's
  // mirror leaves its box as it is.
  reach1 = gearReach(numTeeth1, moduleVal, standoffDiam1, standoffChamfer);
  reach2 = gearReach(numTeeth2, moduleVal, standoffDiam2, standoffChamfer);
  bottom = gearBottom(thickness, standoffChamfer);
  top = gearTop(thickness, standoffHeight, standoffChamfer);

  g1 = remap(gear(numTeeth1, moduleVal, pressureAngle, rot1, thickness, helixAngle, standoffDiam1, standoffHeight, standoffChamfer, boreDiam1, dedendumClearance, kSmall), [p.x + pitchR1, p.y, p.z]);
  g1.box = [[neg(pitchR1) - reach1, neg(reach1), bottom], [reach1 - pitchR1, reach1, top]];
  g2 = remap(gear(numTeeth2, moduleVal, pressureAngle, rot2, thickness, helixAngle, standoffDiam2, standoffHeight, standoffChamfer, boreDiam2, dedendumClearance, kSmall), [neg(p.x) + pitchR2, p.y, p.z]);
  g2.box = [[pitchR2 - reach2, neg(reach2), bottom], [pitchR2 + reach2, reach2, top]];

  return g1, g2;
}

// =========================================================
// Bevel Gears
// =========================================================

/// The pitch cone half-angle of a bevel gear of `numTeeth` running against
/// a mate of `mateTeeth`, on shafts crossing at `shaftAngle`. The two
/// angles of a pair sum to the shaft angle, and the pair shares one apex
/// and one outer cone distance, so this is all bevelPair needs to place
/// both gears. For the usual right-angle drive it reduces to
/// atan(numTeeth / mateTeeth).
bevelPitchAngle(numTeeth, mateTeeth, shaftAngle) {
  return atan(sin(shaftAngle), mateTeeth / numTeeth + cos(shaftAngle));
}

/// The teeth of a bevel gear as an unbounded conical field: apex at the
/// origin, axis +Z, teeth converging on the apex, and no ends — bevelGear
/// faces it off, or bound it yourself. `pitchAngle` is the pitch cone
/// half-angle (bevelPitchAngle gives the one that meshes a chosen mate) and
/// `moduleVal` is the module at the OUTER end; together they fix the outer
/// cone distance at numTeeth * moduleVal / (2 * sin(pitchAngle)), so a bevel
/// gear's size is not a free parameter the way a spur gear's thickness is.
/// `spiralAngle` is the angle the tooth trace makes with the cone element —
/// 0 is a straight bevel, and it is the bevel analog of gear()'s helixAngle,
/// over-estimating the field on the flanks by the same 1 / cos of itself.
/// `rotOffset` spins the gear about its axis and accepts any value.
/// `backlash` thins every tooth by that much at the outer end, and in
/// proportion at every other cone distance. `dedendumClearance` and
/// `kSmall` mean what they do for gearProfile. `numTeeth` must be a whole
/// number — the tooth pattern closes around the axis only then.
//
// Internal: Tredgold's approximation, done as a coordinate map rather than
// as a second profile. The polar angle from the axis becomes a radius on
// the developed back cone (u), the azimuth becomes the developed angle
// (psi = phi * cos(pitchAngle)), and gearProfile of the virtual tooth count
// numTeeth / cos(pitchAngle) is read there. Both coordinates depend on
// direction alone, so the tooth pattern is identical at every cone distance
// and the teeth converge on the apex for free. Undercut follows the virtual
// count, which is why a bevel pinion carries fewer real teeth than a spur
// one before it undercuts. Tredgold degrades as pitchAngle approaches pi/2,
// where the back cone distance runs away, so crown gears are out of range.
//
// The developed field is an arc length on the sphere of radius outerCone,
// so the restoration to 3D is coneDist * sin(dev / outerCone) and NOT
// coneDist * dev / outerCone. An exact cone field has |grad| = 1 because
// its angular gradient is cos(sigma) rather than 1; the sine costs one op
// and holds the gradient at gearProfile's own ~1.30 ceiling, where the
// linear form reaches 2.03.
//
// phi is wrapped to (-pi, pi] AFTER the spiral shear, so psi jumps by
// 2 * pi * cos(pitchAngle) at the seam — exactly numTeeth developed tooth
// pitches, which leaves the field continuous across it. That is what lets
// rotOffset take any value, and it is why numTeeth must be whole.
//
// The spiral is the logarithmic one: a constant angle to the cone element
// means d(phi) / d(ln coneDist) = tan(spiralAngle) / sin(pitchAngle). Real
// spiral bevels are cut on a circular arc (Gleason); this is the
// constant-angle tooth of the textbooks, and it is what keeps a pair
// conjugate at every cone distance. The max() guard keeps ln finite when a
// cell spans the apex, where interval evaluation would bound it at -inf.
bevelTeeth(numTeeth, moduleVal, pressureAngle, pitchAngle, spiralAngle, rotOffset, backlash, dedendumClearance, kSmall) {
  sinD = sin(pitchAngle);
  cosD = cos(pitchAngle);
  outerCone = numTeeth * moduleVal / (2 * sinD);
  backCone = outerCone * sinD / cosD;
  virtualTeeth = numTeeth / cosD;

  coneDist = length(p);
  theta = atan(length(p.xy), p.z);
  twoPi = 2 * pi;

  spiral = neg(tan(spiralAngle)) * ln(max(coneDist, outerCone * 0.001) / outerCone) / sinD;
  phi = atan(p.y, p.x) - rotOffset + spiral;
  phiWrapped = ((phi + pi) % twoPi + twoPi) % twoPi - pi;
  psi = phiWrapped * cosD;

  u = backCone + outerCone * (theta - pitchAngle);
  dev = remap(gearProfile(virtualTeeth, moduleVal, pressureAngle, 0.0, dedendumClearance, kSmall), [u * cos(psi), u * sin(psi), 0.0]) + backlash / 2;
  return coneDist * sin(clamp(dev / outerCone, neg(pi) / 2, pi / 2));
}

// bevelReach, bevelLow and bevelHigh bound a bevel gear from its axis and
// along it. The teeth stay inside the tip cone and the heel's end cone, and
// along the tip cone the radius grows with cone distance, so the widest point
// is the outer tooth-tip corner. The lowest is the toe face, or the toe's tip
// corner where the recess stands the face below it, and the top is the back
// face under the standoff. A standoff flush with a face blends into it by up
// to its chamfer, so that is allowed for at both ends.
bevelReach(numTeeth, moduleVal, pitchAngle, standoffDiameter, standoffChamfer) {
  outerCone = numTeeth * moduleVal / (2 * sin(pitchAngle));
  addendumAngle = moduleVal / outerCone;
  return max(outerCone * sin(pitchAngle + addendumAngle) / cos(addendumAngle),
             standoffDiameter / 2 + standoffChamfer);
}

bevelLow(numTeeth, moduleVal, pitchAngle, faceWidth, recess, standoffChamfer) {
  outerCone = numTeeth * moduleVal / (2 * sin(pitchAngle));
  addendumAngle = moduleVal / outerCone;
  toeCorner = (outerCone - faceWidth) * cos(pitchAngle + addendumAngle) / cos(addendumAngle);
  return min(toeCorner + recess - standoffChamfer, toeCorner);
}

bevelHigh(numTeeth, moduleVal, pitchAngle, crownToBack, standoffHeight, standoffChamfer) {
  outerCone = numTeeth * moduleVal / (2 * sin(pitchAngle));
  addendumAngle = moduleVal / outerCone;
  heelFace = outerCone * cos(pitchAngle + addendumAngle) / cos(addendumAngle) + crownToBack;
  return heelFace + max(standoffHeight, standoffChamfer);
}

/// 3D bevel gear: bevelTeeth ended the way a real bevel blank is, and
/// drilled with a concentric bore. The teeth run out on the two cones normal
/// to the pitch cone — the back cone at the heel and the front cone at the
/// toe — and each of those is then cut by a plane perpendicular to the axis,
/// giving the flat back face and the flat toe face the tooth ends step down
/// from. `faceWidth` is measured along the cone element inward from the
/// outer end; gear practice keeps it under about a third of the outer cone
/// distance.
///
/// `crownToBack` and `recess` place those planes: each is the axial
/// distance from its end's outer tooth-tip corner — where the tip cone meets
/// that end cone, on the outer cylinder — to the flat face, both taken in
/// +Z. At the heel that stands the back face proud of the teeth; at the toe
/// it sets the toe face back so the teeth project past it toward the mate.
/// Either way the tooth end is left running out on its cone in between, and
/// the tip corner itself does not move: the recess only says where the flat
/// face meets that cone. Zero is the degenerate case and is meant to work —
/// the plane passes through the tip corner, its cone binds nowhere there is
/// material, and the end comes out flat.
///
/// The standoff is the hub, and it goes on the heel where a bevel gear's hub
/// belongs — a cylinder of `standoffDiameter` rising from the toe face, so it
/// adds nothing inside the blank and projects `standoffHeight` past the back
/// face, blended on with `standoffChamfer`. Measuring from the back face is
/// the difference from gear(), which has a mid-plane to measure from and a
/// bevel gear has not. To ask for no hub at all set the height AND the
/// chamfer to zero: a chamfer union of the hub's top with the back face it is
/// then flush against blends the two, standing the face proud by the usual
/// chamfer / sqrt(2) over the hub's footprint. Any real hub clears that, and
/// the back face outside the footprint is untouched either way.
///
/// The apex sits at the origin and the teeth face it, so a mate goes on the
/// far side of the origin, not the far side of the gear.
//
// Internal: elementDist is the distance from the apex along a pitch element
// to the foot of the perpendicular from p, so both end cones are level sets
// of it and cost one dot product between them. The heel and toe caps are NOT
// booleaned the same way, and cannot be. Both cones open toward the apex, so
// the back cone's inward continuation passes harmlessly behind the gear
// (z = outerCone / cos(pitchAngle), well past the blank) while the FRONT
// cone's runs straight through it: at a typical bore radius it demands a z
// above the back face, which as an intersection would punch a hole around
// the bore. So the heel cap intersects its cone with its plane, and the toe
// cap unions them — which is what puts the cone on the tooth ends and the
// plane across the middle at both ends, as the blank requires.
bevelGear(numTeeth, moduleVal, pressureAngle, pitchAngle, spiralAngle, rotOffset, faceWidth, crownToBack, recess, backlash, standoffDiameter, standoffHeight, standoffChamfer, boreDiameter, dedendumClearance, kSmall) {
  sinD = sin(pitchAngle);
  cosD = cos(pitchAngle);
  outerCone = numTeeth * moduleVal / (2 * sinD);
  innerCone = outerCone - faceWidth;

  teeth = bevelTeeth(numTeeth, moduleVal, pressureAngle, pitchAngle, spiralAngle, rotOffset, backlash, dedendumClearance, kSmall);

  elementDist = length(p.xy) * sinD + p.z * cosD;

  // Where the tip cone crosses an end cone, per unit of that end's cone
  // distance — the outer tooth-tip corner the recesses are measured from.
  addendumAngle = moduleVal / outerCone;
  tipCornerZ = cos(pitchAngle + addendumAngle) / cos(addendumAngle);
  heelFace = outerCone * tipCornerZ + crownToBack;
  toeFace = innerCone * tipCornerZ + recess;

  heelCap = max(elementDist - outerCone, p.z - heelFace);
  toeCap = min(innerCone - elementDist, toeFace - p.z);

  body = intersectChamfer(teeth, max(heelCap, toeCap), kSmall);

  standoffRadius = standoffDiameter / 2;
  standoffCyl = cylinderZ(vector.zero, standoffRadius);
  standoffSlabZ = intersectChamfer(toeFace - p.z, p.z - (heelFace + standoffHeight), kSmall);
  standoffSolid = intersectChamfer(standoffCyl, standoffSlabZ, kSmall);

  withStandoff = unionChamfer(body, standoffSolid, standoffChamfer);

  boreRadius = boreDiameter / 2;
  bore = cylinderZ(vector.zero, boreRadius);

  reach = bevelReach(numTeeth, moduleVal, pitchAngle, standoffDiameter, standoffChamfer);
  form = differenceChamfer(withStandoff, bore, kSmall);
  form.box = [[neg(reach), neg(reach), bevelLow(numTeeth, moduleVal, pitchAngle, faceWidth, recess, standoffChamfer)],
              [reach, reach, bevelHigh(numTeeth, moduleVal, pitchAngle, crownToBack, standoffHeight, standoffChamfer)]];
  return form;
}

/// A bevel tooth form shared by every gear that meshes with it, as a
/// factory: call it once with what mating gears must agree on, and the
/// function it returns makes a gear from what is its own — `numTeeth`, its
/// mate's `mateTeeth`, a `spiralHand` of +1 or -1, its `rotOffset`, and its
/// hub `standoffDiameter` and `boreDiameter`. The pitch angle is derived
/// from the two tooth counts and `shaftAngle` rather than passed, so a gear
/// whose cone disagrees with its mate's stops being expressible — an error
/// no single-pose mesh check would catch. A pair needs one hand of each.
/// Every argument means what it does for bevelGear, and a gear made this way
/// is identical to what bevelPair builds; use it for what bevelPair is not —
/// a train, or two gears that need separate placement.
///
///   tooth = gears.bevelTooth(0.5, 0.35, shaftAngle, 0.5, faceWidth, 0.4, 0.4, 0.025, 1.2, 0.1, 0.25, 0.025);
///   pinion = tooth(16, 24,  1, rot1, 3.0, 1.5);
///   wheel  = tooth(24, 16, -1, rot2, 3.6, 2.0);
bevelTooth(moduleVal, pressureAngle, shaftAngle, spiralAngle, faceWidth, crownToBack, recess, backlash, standoffHeight, standoffChamfer, dedendumClearance, kSmall) {
  make(numTeeth, mateTeeth, spiralHand, rotOffset, standoffDiameter, boreDiameter) {
    pitchAngle = bevelPitchAngle(numTeeth, mateTeeth, shaftAngle);
    return bevelGear(numTeeth, moduleVal, pressureAngle, pitchAngle, spiralHand * spiralAngle, rotOffset, faceWidth, crownToBack, recess, backlash, standoffDiameter, standoffHeight, standoffChamfer, boreDiameter, dedendumClearance, kSmall);
  }
  return make;
}

/// Two bevel gears in mesh on shafts crossing at `shaftAngle`, returned as
/// a multi-value (g1, g2). Gear 1 turns about +Z, gear 2's axis lies in the
/// XZ plane at `shaftAngle` from it, both apexes are the origin, and the
/// two share one module and one outer cone distance. `phase` advances the
/// pair by one tooth per unit — gear 1 forward, gear 2 back by the tooth
/// ratio — so mod(time, 1) animates the drive. `spiralAngle` is gear 1's
/// hand; gear 2 is given the opposite hand automatically, which is not a
/// nicety but the meshing condition: a same-hand pair collides rather than
/// meshes. Give `backlash` a few hundredths of the module for a running
/// fit. `crownToBack` and `recess` end both blanks and the standoff
/// arguments hub them, meaning what they do for bevelGear — each gear takes
/// its own hub diameter, and both share a height and a chamfer, as gearPair
/// does. Equal tooth counts at a right angle make a miter pair. For gears
/// that are not simply a pair — a train, or two that need separate placement
/// — bevelTooth declares what they share once and makes each gear from its
/// own tooth count and its mate's; the gears it makes are identical to these.
//
// The phase constant pi * (numTeeth2 - 1) / numTeeth2 puts a tooth space of
// gear 2 on the common pitch element facing gear 1's tooth, for either
// parity of numTeeth2 and with no case split. It is measured, not asserted
// — see TestBevelPairMesh, which reads the mesh clearance across a full
// tooth pitch of rotation and requires it to stay positive AND constant,
// since rolling contact cannot make the gap depend on phase.
bevelPair(numTeeth1, numTeeth2, moduleVal, pressureAngle, shaftAngle, spiralAngle, faceWidth, crownToBack, recess, backlash, standoffDiam1, standoffDiam2, standoffHeight, standoffChamfer, boreDiam1, boreDiam2, dedendumClearance, kSmall, phase) {
  pitchAngle1 = bevelPitchAngle(numTeeth1, numTeeth2, shaftAngle);
  pitchAngle2 = shaftAngle - pitchAngle1;

  rot1 = 2 * pi * phase / numTeeth1;
  rot2 = pi * (numTeeth2 - 1) / numTeeth2 - 2 * pi * phase / numTeeth2;

  g1 = bevelGear(numTeeth1, moduleVal, pressureAngle, pitchAngle1, spiralAngle, rot1, faceWidth, crownToBack, recess, backlash, standoffDiam1, standoffHeight, standoffChamfer, boreDiam1, dedendumClearance, kSmall);
  g2 = bevelGear(numTeeth2, moduleVal, pressureAngle, pitchAngle2, neg(spiralAngle), rot2, faceWidth, crownToBack, recess, backlash, standoffDiam2, standoffHeight, standoffChamfer, boreDiam2, dedendumClearance, kSmall);

  cosS = cos(shaftAngle);
  sinS = sin(shaftAngle);

  // Gear 2's box turned with it about y: the box around its turned corners,
  // x from cosS * x + sinS * z and z from cosS * z - sinS * x.
  reach2 = bevelReach(numTeeth2, moduleVal, pitchAngle2, standoffDiam2, standoffChamfer);
  low2 = bevelLow(numTeeth2, moduleVal, pitchAngle2, faceWidth, recess, standoffChamfer);
  high2 = bevelHigh(numTeeth2, moduleVal, pitchAngle2, crownToBack, standoffHeight, standoffChamfer);
  turned = remap(g2, [cosS * p.x - sinS * p.z, p.y, sinS * p.x + cosS * p.z]);
  turned.box = [[min(sinS * low2, sinS * high2) - abs(cosS) * reach2, neg(reach2),
                 min(cosS * low2, cosS * high2) - abs(sinS) * reach2],
                [max(sinS * low2, sinS * high2) + abs(cosS) * reach2, reach2,
                 max(cosS * low2, cosS * high2) + abs(sinS) * reach2]];
  return g1, turned;
}

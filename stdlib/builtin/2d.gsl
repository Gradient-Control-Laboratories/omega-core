// =========================================================
// 2D PRIMITIVES (XY plane)
// =========================================================

/// Circle in the XY plane, centered at `center` (2D point) with given
/// radius. SDF is signed: negative inside, positive outside.
circleXY(center, radius) {
  return length(p.xy - center) - radius;
}

/// Ring (annulus) in the XY plane with given radius and stroke
/// thickness, centered at `center`.
annulusXY(center, radius, thickness) {
  return abs(circleXY(center, radius)) - thickness * 0.5;
}

/// Axis-aligned rectangle in the XY plane, centered at `center` (2D point)
/// with given `size` (2D extent), using `blend` to combine the two slab
/// fields — pass `intersectRound(radius)` to round every corner, or any other
/// operator taking a list of fields.
rectangleXYCentered(center, size, blend) {
  halfSize = size * 0.5;
  d = abs(p.xy - center) - halfSize;
  return blend([d.x, d.y]);
}

/// Axis-aligned rectangle in the XY plane centered at `center` (2D
/// point) with given `size` (2D extent).
rectangleXYCentered(center, size) {
  return rectangleXYCentered(center, size, intersectRound(0));
}

/// Axis-aligned rectangle in the XY plane defined by two opposite corners,
/// using `blend` to combine the two slab fields — pass `intersectRound(radius)`
/// to round every corner, or any other operator taking a list of fields.
rectangleXY(pointA, pointB, blend) {
  center = (pointA + pointB) * 0.5;
  size = abs(pointB - pointA);
  return rectangleXYCentered(center, size, blend);
}

/// Axis-aligned rectangle in the XY plane defined by two opposite
/// corners.
rectangleXY(pointA, pointB) {
  return rectangleXY(pointA, pointB, intersectRound(0));
}

/// Quadrilateral in the XY plane with corners corner0..corner3 given in consistent
/// winding order.
//
// Based on Inigo Quilez formulation.
quadXY(corner0, corner1, corner2, corner3) {
  q = p.xy;

  gs = (corner0.x - corner3.x) * (corner1.y - corner0.y) - (corner0.y - corner3.y) * (corner1.x - corner0.x);

  // Edge 0: corner0 -> corner1
  e0 = corner1 - corner0;
  w0 = q - corner0;
  t0 = clamp(dot(w0, e0) / dot(e0, e0), 0, 1);
  qq0 = w0 - e0 * t0;
  d0 = dot(qq0, qq0);
  s0 = gs * (w0.x * e0.y - w0.y * e0.x);

  // Edge 1: corner1 -> corner2
  e1 = corner2 - corner1;
  w1 = q - corner1;
  t1 = clamp(dot(w1, e1) / dot(e1, e1), 0, 1);
  qq1 = w1 - e1 * t1;
  d1 = dot(qq1, qq1);
  s1 = gs * (w1.x * e1.y - w1.y * e1.x);

  // Edge 2: corner2 -> corner3
  e2 = corner3 - corner2;
  w2 = q - corner2;
  t2 = clamp(dot(w2, e2) / dot(e2, e2), 0, 1);
  qq2 = w2 - e2 * t2;
  d2 = dot(qq2, qq2);
  s2 = gs * (w2.x * e2.y - w2.y * e2.x);

  // Edge 3: corner3 -> corner0
  e3 = corner0 - corner3;
  w3 = q - corner3;
  t3 = clamp(dot(w3, e3) / dot(e3, e3), 0, 1);
  qq3 = w3 - e3 * t3;
  d3 = dot(qq3, qq3);
  s3 = gs * (w3.x * e3.y - w3.y * e3.x);

  dmin = min(d0, d1, d2, d3);
  smax = max(s0, s1, s2, s3);

  return sqrt(dmin) * sign(smax);
}

/// Circular arc in the XY plane. `halfAngleSinCos` is [sin, cos] of the arc's
/// half-angle and `radius` the arc radius. Returns the distance to the arc
/// curve; subtract a half-width to give it a stroke.
//
// Based on Inigo Quilez formulation.
arcXY(halfAngleSinCos, radius) {
  pxAbs = abs(p.x);
  py = p.y;
  inside = halfAngleSinCos.y * pxAbs > halfAngleSinCos.x * py;
  wx = pxAbs - radius * halfAngleSinCos.x;
  wy = py - radius * halfAngleSinCos.y;
  dInside = length([wx, wy]);
  l = length([pxAbs, py]);
  dOutside = abs(l - radius);
  return inside ? dInside : dOutside;
}

/// Arc (as in arcXY) extended along the tangents at its endpoints.
/// `halfAngleSinCos` is [sin, cos] of the half-angle and `radius` the radius.
//
// Based on Inigo Quilez formulation.
arcExtendedXY(halfAngleSinCos, radius) {
  pxAbs = abs(p.x);
  py = p.y;
  inside = halfAngleSinCos.y * pxAbs > halfAngleSinCos.x * py;
  
  // Tangent line at the right-side endpoint has normal [halfAngleSinCos.x, halfAngleSinCos.y]
  dInside = pxAbs * halfAngleSinCos.x + py * halfAngleSinCos.y - radius;
  
  l = length([pxAbs, py]);
  dOutside = l - radius;
  return inside ? dInside : dOutside;
}

/// Arc specified by two endpoints (2D, XY) and the unit tangent at pointA.
/// Returns a 2D SDF for the arc curve; subtract a half-width for a stroke.
arcTwoPointTangentExtendedXY(pointA, pointB, tangentA) {
  // Perpendicular to the tangent at pointA points toward the circle center.
  towardCenter = [-tangentA.y, tangentA.x];

  // Chord midpoint and its perpendicular bisector direction.
  midpoint = (pointA + pointB) * 0.5;
  chord = pointB - pointA;
  bisectorDirection = [-chord.y, chord.x];

  // Solve center = pointA + s * towardCenter, lying on the bisector:
  // dot(center - midpoint, chord) = 0
  //   ->  dot(pointA + s*towardCenter - midpoint, chord) = 0
  denominator = dot(towardCenter, chord);
  numerator = dot(midpoint - pointA, chord);
  s = numerator / denominator;
  center = pointA + s * towardCenter;

  radius = length(pointA - center);

  // Angles from center to each endpoint.
  radialA = pointA - center;
  radialB = pointB - center;
  angleA = atan(radialA.y, radialA.x);
  angleB = atan(radialB.y, radialB.x);

  // Sweep from pointA to pointB, normalized into (-pi, pi].
  unwrappedSweep = angleB - angleA;
  sweep = unwrappedSweep - tau * round(unwrappedSweep / tau);
  halfSweep = sweep * 0.5;
  bisectorAngle = angleA + halfSweep;

  // arcExtendedXY expects [sin, cos] of the half-angle, centered on +Y,
  // opening symmetrically. Rotate p so the arc bisector aligns with +Y.
  halfAngleSinCos = [sin(abs(halfSweep)), cos(halfSweep)];
  // Z rotation carrying the bisector direction onto +Y (angle pi/2 - bisectorAngle),
  // inlined (map.rotateXY) so builtin does not import map.
  cosBisector = cos(bisectorAngle);
  sinBisector = sin(bisectorAngle);
  relativeX = p.x - center.x;
  relativeY = p.y - center.y;
  arcField = remap(
    arcExtendedXY(halfAngleSinCos, radius),
    [relativeX * sinBisector - relativeY * cosBisector, relativeX * cosBisector + relativeY * sinBisector, p.z]
  );

  return arcField;
}

// =========================================================
// PROFILES (XY plane)
// =========================================================

// One sign's share of a profile's distance: the nearest of the loop's features
// that face that way. Each vertex brings two features. Its corner is the
// distance to the vertex, facing out where the loop turns left there (convex)
// and in where it turns right (reflex) — the sign of the whole normal cone of
// that vertex. Its edge, to the next vertex, is the distance to the edge's
// line, facing whichever side of the line p is on. `whenOutside` and
// `whenInside` are what a feature adds when it faces out or in: 0 to count
// it, nothing to drop it.
//
// Written for its interval bounds as much as its value. A ternary lowers to
// c * a + (1 - c) * b, which over a cell that straddles the condition loses
// the distance's lower bound; so the ternaries here choose only between
// constants and max applies them. And past either end of its edge the line
// distance grows by twice the overshoot, so it is strictly farther than the
// end vertex: at once the overshoot it would tie the corner all along the
// edge's extended line, and the comparison in profileXY would never settle
// there. A vertex the loop runs straight through has no normal cone, only
// the one normal line its two edges share, and counted either way it would
// tie them all along that line with the wrong sign on half of it; so a
// corner that turns by less than a millionth of a radian faces neither way.
//
// profileXY reads the two pools only for the sign, and takes the distance from
// a third pass that counts every feature whichever way it faces. Over a cell
// the profile's edge runs through, that edge is undecided in both pools and
// neither is bounded by it; the third pass is, so the result is bounded by the
// distance to the edge and not by nothing.
profilePoolXY(points, whenOutside, whenInside) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  return reduce([nothing, 0], (nearest, start, index) {
    previous = points[mod(index - 1 + count, count)];
    end = points[mod(index + 1, count)];
    incoming = start - previous;
    edge = end - start;
    offset = p.xy - start;
    edgeLength = length(edge);
    along = dot(offset, edge) / edgeLength;
    turn = (incoming.x * edge.y - incoming.y * edge.x) / (length(incoming) * edgeLength);
    side = offset.x * edge.y - offset.y * edge.x;
    cornerDistance = max(length(offset), turn > 1e-6 ? whenOutside : (turn < neg(1e-6) ? whenInside : nothing));
    lineDistance = abs(side) / edgeLength + 2 * max(0, neg(along), along - edgeLength);
    edgeDistance = max(lineDistance, side >= 0 ? whenOutside : whenInside);
    return [min(nearest.x, cornerDistance, edgeDistance), 0];
  }, points).x;
}

/// Closed polygon profile in the XY plane, convex or concave: the exact signed
/// distance to the loop through `points` (a list of 2D points) in order,
/// negative inside. Wind the loop counterclockwise; a clockwise loop is its
/// complement, a hole. The loop must not cross itself. Its box bounds it in
/// X and Y. Its frame: .u the distance along the loop, from its first point,
/// to the point of the loop nearest p, in mm.
profileXY(points) {
  outside = profilePoolXY(points, 0, nothing);
  inside = profilePoolXY(points, nothing, 0);
  nearest = profilePoolXY(points, 0, 0);
  form = outside <= inside ? nearest : neg(nearest);
  low, high = profileBoundsXY(points);
  form.box = [[low.x, low.y, neg(nothing)], [high.x, high.y, nothing]];
  form.u = profileRunXY(points);
  return form;
}

// The corners of a polygon profile's box in the XY plane: the least and the
// greatest of its points.
profileBoundsXY(points) {
  low = reduce((corner, point) { return min(corner, point); }, points);
  high = reduce((corner, point) { return max(corner, point); }, points);
  return low, high;
}

// A polygon profile's u: the distance along the loop, from its first point, to
// the point of the loop nearest p. Each edge offers its own nearest point; a
// first pass finds how near the nearest of them is, and a second keeps the
// distance along the loop of the edge that is that near, the length of the
// edges before it and its own station. Where a vertex is nearest, the two
// edges that meet there agree on it, and at the first point the loop's whole
// length is kept over zero.
//
// It is two passes, each reading what it carries once or twice, and not one
// that carries the nearest so far with its distance: unrolled, that one reads
// what it carries five times an edge and grows fivefold with every edge.
profileRunXY(points) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  nearest = reduce([nothing, 0], (best, start, index) {
    run = profileEdgeRun(start, points[mod(index + 1, count)]);
    return [min(best.x, run.x), 0];
  }, points).x;
  return reduce([0, 0], (best, start, index) {
    run = profileEdgeRun(start, points[mod(index + 1, count)]);
    return [max(best.x, run.x <= nearest + 1e-4 ? best.y + run.y : 0), best.y + run.z];
  }, points).x;
}

// One straight edge's offer to profileRunXY: [the distance from p to its
// nearest point, that point's distance along the edge, the edge's length].
profileEdgeRun(start, end) {
  edge = end - start;
  edgeLength = length(edge);
  offset = p.xy - start;
  station = clamp(dot(offset, edge) / edgeLength, 0, edgeLength);
  return [length(offset - edge / edgeLength * station), station, edgeLength];
}

/// The length of the closed polygon through `points`: its perimeter, in mm.
profileLengthXY(points) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  return reduce([0, 0], (sum, start, index) {
    return sum + length(points[mod(index + 1, count)] - start);
  }, points).x;
}

// profilePoolXY for a loop whose edges may be arcs: edge i, from point i to
// the next, has signed curvature curvatures[i]. An edge is a piece of a
// circline through its start, with tangent T there and normal N to its right:
// F = N . offset + curvature / 2 * |offset|^2 is zero on it, a line at
// curvature 0 and a circle otherwise, and its signed distance is
// 2 F / (1 + sqrt(1 + 2 curvature F)), which is F itself on the line. So a
// straight edge is no special case and nothing divides by a curvature.
//
// The tangents at an edge's two ends are its chord turned back and forward
// by the angle whose sine is curvature * chord / 2, and the normals to a
// circline are straight lines, so the edge's own region is still bounded by
// two lines and the overshoot past them is taken as on a straight edge. That
// keeps the edge farther than an end vertex only while p is no farther round
// from that end than a quarter turn. Farther round than that from both ends,
// p is behind the arc's centre as seen from each, and twice the lesser of
// those two depths is added, which is enough to keep the edge behind its
// nearer end there too. It is a length added and never a feature dropped, so
// the edge keeps a finite bound everywhere, and it is zero all over an edge's
// own region and all round a straight edge. A corner's turn is between
// the tangents that meet there, so an arc that leaves a line tangentially
// has no corner, as a point on a straight side has none.
profileArcPoolXY(points, curvatures, whenOutside, whenInside) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  return reduce([nothing, 0], (nearest, start, index) {
    previousIndex = mod(index - 1 + count, count);
    previous = points[previousIndex];
    end = points[mod(index + 1, count)];

    curvature = curvatures[index];
    chord = end - start;
    chordLength = length(chord);
    along = chord / chordLength;
    sine = curvature * chordLength / 2;
    cosine = sqrt(max(1 - sine * sine, 0));
    startTangent = [along.x * cosine + along.y * sine, along.y * cosine - along.x * sine];
    endTangent = [along.x * cosine - along.y * sine, along.y * cosine + along.x * sine];

    previousChord = start - previous;
    previousLength = length(previousChord);
    previousAlong = previousChord / previousLength;
    previousSine = curvatures[previousIndex] * previousLength / 2;
    previousCosine = sqrt(max(1 - previousSine * previousSine, 0));
    incoming = [previousAlong.x * previousCosine - previousAlong.y * previousSine, previousAlong.y * previousCosine + previousAlong.x * previousSine];
    turn = incoming.x * startTangent.y - incoming.y * startTangent.x;

    offset = p.xy - start;
    carrier = offset.x * startTangent.y - offset.y * startTangent.x + curvature / 2 * dot(offset, offset);
    carrierDistance = 2 * carrier / (1 + sqrt(max(1 + 2 * curvature * carrier, 0)));
    fromEnd = p.xy - end;
    startOvershoot = neg(dot(offset, startTangent));
    endOvershoot = dot(fromEnd, endTangent);
    overshoot = max(0, startOvershoot, endOvershoot);
    startDepth = 1 + curvature * (offset.x * startTangent.y - offset.y * startTangent.x);
    endDepth = 1 + curvature * (fromEnd.x * endTangent.y - fromEnd.y * endTangent.x);
    behindCenter = max(0, neg(max(startDepth, endDepth))) / max(abs(curvature), 1e-30);

    cornerDistance = max(length(offset), turn > 1e-6 ? whenOutside : (turn < neg(1e-6) ? whenInside : nothing));
    edgeDistance = max(abs(carrierDistance) + 2 * overshoot + 2 * behindCenter, carrier >= 0 ? whenOutside : whenInside);
    return [min(nearest.x, cornerDistance, edgeDistance), 0];
  }, points).x;
}

/// Closed profile of lines and circular arcs in the XY plane: the exact signed
/// distance to the loop through `points`, negative inside, as profileXY(points)
/// but with each edge bent to a signed curvature. `curvatures` holds one per
/// edge, in 1/mm, for the edge leaving the point of the same index: 0 is
/// straight, positive curves to the left along the loop (bulging out of a
/// counterclockwise one) and negative to the right (dented in). An edge is at
/// most a semicircle: its curvature times its chord must not pass 2. The
/// edges must not cross. Its box and its .u are as profileXY(points)'s,
/// the distance along an arc being its arc length.
profileXY(points, curvatures) {
  outside = profileArcPoolXY(points, curvatures, 0, nothing);
  inside = profileArcPoolXY(points, curvatures, nothing, 0);
  nearest = profileArcPoolXY(points, curvatures, 0, 0);
  form = outside <= inside ? nearest : neg(nearest);
  low, high = profileArcBoundsXY(points, curvatures);
  form.box = [[low.x, low.y, neg(nothing)], [high.x, high.y, nothing]];
  form.u = profileArcRunXY(points, curvatures);
  return form;
}

// The corners of an arc profile's box in the XY plane: the box of its points,
// grown all round by the most any edge can bulge. An edge of at most a
// semicircle stands off its chord by its sagitta, which is no more than half
// the chord and no more than chord^2 * curvature / 4; and no chord is longer
// than the diagonal of the points' box. So the box is sound, and loose where
// one edge bends much more than the rest. It is not walked edge by edge
// because a box is read where a reduce's function can see only its own
// arguments: not the curvatures, nor the next point.
profileArcBoundsXY(points, curvatures) {
  low = reduce((corner, point) { return min(corner, point); }, points);
  high = reduce((corner, point) { return max(corner, point); }, points);
  bend = reduce(0, (most, curvature) { return max(most, abs(curvature)); }, curvatures);
  span = length(high - low);
  bulge = min(span / 2, span * span * bend / 4);
  return low - bulge, high + bulge;
}

// An edge's curvature kept off zero, so a length along the edge can be an
// angle divided by it: a straight edge is read as an arc of a million mm
// radius, whose lengths are the straight ones to a part in a million.
profileArcCurvature(curvature) {
  return curvature >= 0 ? max(curvature, 1e-6) : min(curvature, neg(1e-6));
}

// An arc profile's u, as profileRunXY. Along an edge the distance is the angle
// p has turned about the edge's centre since its start, over the curvature;
// it is held to the edge's own length, and the distance to that point of the
// edge is its start, its end, or the circline between them.
// The two passes are profileRunXY's.
profileArcRunXY(points, curvatures) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  nearest = reduce([nothing, 0], (best, start, index) {
    run = profileArcEdgeRun(start, points[mod(index + 1, count)], curvatures[index]);
    return [min(best.x, run.x), 0];
  }, points).x;
  return reduce([0, 0], (best, start, index) {
    run = profileArcEdgeRun(start, points[mod(index + 1, count)], curvatures[index]);
    return [max(best.x, run.x <= nearest + 1e-4 ? best.y + run.y : 0), best.y + run.z];
  }, points).x;
}

// One arc edge's offer to profileArcRunXY, as profileEdgeRun.
profileArcEdgeRun(start, end, edgeCurvature) {
  curvature = profileArcCurvature(edgeCurvature);
  chord = end - start;
  chordLength = length(chord);
  along = chord / chordLength;
  sine = curvature * chordLength / 2;
  cosine = sqrt(max(1 - sine * sine, 0));
  startTangent = [along.x * cosine + along.y * sine, along.y * cosine - along.x * sine];
  edgeLength = 2 * asin(clamp(sine, neg(1), 1)) / curvature;

  offset = p.xy - start;
  across = offset.x * startTangent.y - offset.y * startTangent.x;
  carrier = across + curvature / 2 * dot(offset, offset);
  carrierDistance = 2 * carrier / (1 + sqrt(max(1 + 2 * curvature * carrier, 0)));
  turned = atan(curvature * dot(offset, startTangent), 1 + curvature * across) / curvature;
  station = clamp(turned, 0, edgeLength);
  reach = station <= 0 ? length(offset) : (station >= edgeLength ? length(p.xy - end) : abs(carrierDistance));
  return [reach, station, edgeLength];
}

/// The length of the closed profile through `points` whose edges are bent to
/// `curvatures`, as profileXY(points, curvatures) reads them: the sum of its
/// lines and arcs, in mm.
profileLengthXY(points, curvatures) {
  count = reduce([0, 0], (sum, point) { return sum + 1; }, points).x;
  return reduce([0, 0], (sum, start, index) {
    curvature = profileArcCurvature(curvatures[index]);
    sine = curvature * length(points[mod(index + 1, count)] - start) / 2;
    return sum + 2 * asin(clamp(sine, neg(1), 1)) / curvature;
  }, points).x;
}

// =========================================================
// BOOLEAN OPERATIONS
// =========================================================

/// Sharp CSG intersection of two SDFs (logical AND of solid regions).
intersectSharp(d1, d2) {
  return max(d1, d2);
}

/// Sharp CSG intersection of three SDFs.
intersectSharp(d1, d2, d3) {
  return max(d1, d2, d3);
}

/// Sharp CSG intersection of N SDFs. Pass [d1, d2, ...] as one
/// collection.
intersectSharp(fields) {
  return reduce(
    (peak, field) {
      return max(peak, field);
    },
    fields);
}

/// Sharp CSG union of two SDFs (logical OR of solid regions).
unionSharp(d1, d2) {
  return min(d1, d2);
}

/// Sharp CSG union of three SDFs.
unionSharp(d1, d2, d3) {
  return min(d1, d2, d3);
}

/// Sharp CSG union of N SDFs.
unionSharp(fields) {
  return reduce(
    (nearest, field) {
      return min(nearest, field);
    },
    fields);
}

/// Sharp CSG difference: target minus tool.
differenceSharp(target, tool) {
  return max(target, neg(tool));
}

/// The solid bounded by several surfaces that do not cross or touch: an
/// outline with its holes, islands inside those holes, separate parts, in any
/// order. Pass [field1, field2, ...] as one collection, each field negative on
/// the solid's side of its own surface: a profileXY loop wound counterclockwise
/// for an outline or an island and clockwise for a hole, or neg() of a solid to
/// make it a void. Where each field is an exact distance the result is exact
/// everywhere: the nearest surface's distance, with that surface's sign.
/// Nothing checks the winding. A field negative on the wrong side reads as its
/// own distance wherever its surface is the nearest: void just outside an
/// island wound as a hole, and the field jumps sign where another surface
/// becomes the nearer.
//
// Internal: the nearest surface with its sign, as profileXY's pools take it. A
// field gated to its sign by max with a constant pools the outside and the
// inside separately, and only their comparison picks the sign; the magnitude
// comes from the ungated pool, so a cell on a surface is bounded by that
// surface's own field, not by nothing. Each reduce starts from a list, as
// profilePoolsXY's do: a scalar first argument is read as the function here.
nested(fields) {
  outside = reduce([nothing, 0], (best, field) { return [min(best.x, max(abs(field), field >= 0 ? 0 : nothing)), 0]; }, fields).x;
  inside = reduce([nothing, 0], (best, field) { return [min(best.x, max(abs(field), field < 0 ? 0 : nothing)), 0]; }, fields).x;
  nearest = reduce([nothing, 0], (best, field) { return [min(best.x, abs(field)), 0]; }, fields).x;
  return outside <= inside ? nearest : neg(nearest);
}

/// Round CSG intersection with fillet `radius`. The intersection edge
/// becomes a smooth arc of about that radius. At radius 0 the surface is
/// intersectSharp's, but the field is not: outside a convex corner it
/// measures the Euclidean distance to the corner instead of the max.
intersectRound(d1, d2, radius) {
  inset1 = max(d1 + radius, 0);
  inset2 = max(d2 + radius, 0);
  return min(neg(radius), max(d1, d2)) + length([inset1, inset2]);
}

/// Round CSG intersection of three SDFs with fillet `radius`. Fillets
/// all three pairwise edges.
intersectRound(d1, d2, d3, radius) {
  inset1 = max(d1 + radius, 0);
  inset2 = max(d2 + radius, 0);
  inset3 = max(d3 + radius, 0);
  return min(neg(radius), max(d1, d2, d3)) + length([inset1, inset2, inset3]);
}

/// Round CSG intersection of N SDFs.
intersectRound(fields, radius) {
  sumOfSquares = reduce(0,
    (runningSum, field) {
      inset = max(field + radius, 0);
      return runningSum + inset * inset;
    },
    fields);
  // Written for its gradient as well as its value. Where every field is deeper than radius (all of a sharp
  // primitive's inside, at radius 0) the sum is 0, and sqrt's derivative there, 0 times infinity, made the
  // gradient NaN: the root is floored far below float precision, where max's derivative is 0. And
  // min(sharp, -radius) has its constant raised by 1e-30, its value the same in a float: at radius 0 the two
  // would tie all over the surface, where min took the constant's zero gradient; raised, sharp is the lesser
  // there and min takes the sharp intersection's, the face's normal, which meshing and lighting read. It was
  // once written sharp - max(sharp + radius, 0), which has that gradient too, but names sharp twice: interval
  // arithmetic cannot cancel them, so outside the part every bound was off by sharp's whole range over the box,
  // and bounds, certify and volume paid for it. At radius above 0 the tie is on the level set sharp = -radius,
  // inside the part, and there the gradient is zero.
  sharp = intersectSharp(fields);
  return min(sharp, 1e-30 - radius) + sqrt(max(sumOfSquares, 1e-30));
}

/// Partial application: binds the fillet radius and returns the intersection
/// operator itself, ready to hand to a primitive that takes its own blend —
/// `boxCentered(center, size, intersectRound(0.2))` rounds every edge of the
/// box by 0.2. The returned operator takes the list of fields to intersect.
intersectRound(radius) {
  return (fields) { return intersectRound(fields, radius); };
}

/// Round CSG union with fillet `radius`. The union seam becomes a smooth
/// arc of about that radius.
unionRound(d1, d2, radius) {
  return neg(intersectRound(neg(d1), neg(d2), radius));
}

/// Round CSG union of three SDFs with fillet `radius`.
unionRound(d1, d2, d3, radius) {
  return neg(intersectRound(neg(d1), neg(d2), neg(d3), radius));
}

/// Round CSG union of N SDFs.
unionRound(fields, radius) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectRound(negated, radius));
}

/// Partial application of unionRound: binds the fillet radius and returns the
/// operator, ready to hand to a primitive that takes its own blend.
unionRound(radius) {
  return (fields) { return unionRound(fields, radius); };
}

/// Round CSG difference: target minus tool with a fillet of `radius`
/// where the tool carves into the target.
differenceRound(target, tool, radius) {
  return intersectRound(target, neg(tool), radius);
}

/// Lp-norm blend intersection of a list of SDFs. Interpolates between a sharp
/// intersection (exponent -> infinity) and a round one (exponent == 2) by combining the
/// clamped per-field insets with an Lp norm instead of intersectRound's L2
/// norm. A larger exponent is sharper; `width` sets the blend width.
intersectLp(fields, width, exponent) {
  // Normalize by the peak inset (the Lp analog of the exponential blend's
  // log-sum-exp shift): factoring out the largest inset keeps every ratio
  // in [0, 1], so inset^exponent never overflows the mesher's intervals for any
  // positive exponent.
  peak = intersectSharp(fields);
  peakInset = max(peak + width, 0);
  normalizer = max(peakInset, 1e-9);
  sumOfPowers = reduce(0, (runningSum, field) {
    inset = max(field + width, 0);
    return runningSum + pow(inset / normalizer, exponent);
  }, fields);
  return min(neg(width), peak) + peakInset * pow(sumOfPowers, 1 / exponent);
}

/// Lp-norm blend intersection of two SDFs (see the list form).
intersectLp(d1, d2, width, exponent) {
  return intersectLp([d1, d2], width, exponent);
}

/// Lp-norm blend intersection of three SDFs (see the list form).
intersectLp(d1, d2, d3, width, exponent) {
  return intersectLp([d1, d2, d3], width, exponent);
}

/// Partial application of intersectLp: binds the blend width and exponent and
/// returns the operator, ready to hand to a primitive that takes its own blend.
intersectLp(width, exponent) {
  return (fields) { return intersectLp(fields, width, exponent); };
}

/// Lp-norm blend union of a list of SDFs (De Morgan dual of intersectLp):
/// interpolates between a sharp union (exponent -> infinity) and a round one
/// (exponent == 2). A larger exponent is sharper; `width` sets the blend width.
unionLp(fields, width, exponent) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectLp(negated, width, exponent));
}

/// Lp-norm blend union of two SDFs (see the list form).
unionLp(d1, d2, width, exponent) {
  return unionLp([d1, d2], width, exponent);
}

/// Lp-norm blend union of three SDFs (see the list form).
unionLp(d1, d2, d3, width, exponent) {
  return unionLp([d1, d2, d3], width, exponent);
}

/// Partial application of unionLp: binds the blend width and exponent and
/// returns the operator, ready to hand to a primitive that takes its own blend.
unionLp(width, exponent) {
  return (fields) { return unionLp(fields, width, exponent); };
}

/// Lp-norm blend difference: target minus tool, with an Lp-blended seam
/// (see intersectLp).
differenceLp(target, tool, width, exponent) {
  return intersectLp([target, neg(tool)], width, exponent);
}

/// Exponential (log-sum-exp) blend intersection of a list of SDFs — a smooth
/// maximum whose softness is set by `width`. A larger width blends more; a small one
/// approaches the sharp intersection.
//
// After Inigo Quilez.
intersectExponential(fields, width) {
  scale = width / e;
  // Shift by the peak (log-sum-exp trick): algebraically identical, but the
  // exponent stays <= 0 so exp never overflows the mesher's intervals.
  peak = intersectSharp(fields);
  total = reduce(0, (runningTotal, field) {
    return runningTotal + exp((field - peak) / scale);
  }, fields);
  return peak + scale * ln(total);
}

/// Exponential blend intersection of two SDFs (see the list form).
intersectExponential(d1, d2, width) {
  return intersectExponential([d1, d2], width);
}

/// Exponential blend intersection of three SDFs (see the list form).
intersectExponential(d1, d2, d3, width) {
  return intersectExponential([d1, d2, d3], width);
}

/// Partial application of intersectExponential: binds the blend width and
/// returns the operator, ready to hand to a primitive that takes its own blend.
intersectExponential(width) {
  return (fields) { return intersectExponential(fields, width); };
}

/// Exponential (log-sum-exp) blend union of a list of SDFs (De Morgan dual of
/// intersectExponential) — a smooth minimum. A larger width blends more.
unionExponential(fields, width) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectExponential(negated, width));
}

/// Exponential blend union of two SDFs (see the list form).
unionExponential(d1, d2, width) {
  return unionExponential([d1, d2], width);
}

/// Exponential blend union of three SDFs (see the list form).
unionExponential(d1, d2, d3, width) {
  return unionExponential([d1, d2, d3], width);
}

/// Partial application of unionExponential: binds the blend width and returns
/// the operator, ready to hand to a primitive that takes its own blend.
unionExponential(width) {
  return (fields) { return unionExponential(fields, width); };
}

/// Exponential blend difference: target minus tool, with a log-sum-exp seam
/// (see intersectExponential).
differenceExponential(target, tool, width) {
  return intersectExponential([target, neg(tool)], width);
}

// Chamfer building blocks over a list of distance fields. In 3D the
// chamfer of N half-spaces is shaped by where pairs of faces meet
// (edges, the sqrt2 planes) and where triples meet (vertices, the
// sqrt3 planes); higher-order groups add no new features.
// intersectChamferEdges and intersectChamferVertices scan all i<j (and
// i<j<l) combinations and take the strongest plane. Slots that aren't a
// valid combination fall back to `face` (the sharp intersection), the
// natural floor of the chamfer field; this avoids large sentinels that
// would otherwise blow up interval bounds in the mesher. The union
// counterparts negate, intersect, and negate back, as elsewhere.

/// Strongest pairwise (edge) chamfer plane of a list of SDFs at `offset`.
intersectChamferEdges(fields, offset) {
  face = intersectSharp(fields);
  return intersectSharp(map((di, i) {
    return intersectSharp(map((dj, j) {
      return (j > i) ? (di + dj + offset) / sqrt2 : face;
    }, fields));
  }, fields));
}

/// Strongest three-way (vertex) chamfer plane of a list of SDFs at `offset`.
intersectChamferVertices(fields, offset) {
  face = intersectSharp(fields);
  return intersectSharp(map((di, i) {
    return intersectSharp(map((dj, j) {
      return intersectSharp(map((dl, l) {
        return (l > j) && (j > i) ? (di + dj + dl + offset) / sqrt3 : face;
      }, fields));
    }, fields));
  }, fields));
}

/// Union counterpart of intersectChamferEdges.
unionChamferEdges(fields, offset) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectChamferEdges(negated, offset));
}

/// Union counterpart of intersectChamferVertices.
unionChamferVertices(fields, offset) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectChamferVertices(negated, offset));
}

/// Chamfered CSG intersection: the bevel (d1 + d2 + offset) / sqrt2 replaces
/// the sharp intersection edge. `offset` is added before dividing, so it is a
/// setback along each face, and the bevel is at 45°, only where the faces meet
/// at a right angle; the plane's gradient has length sqrt(1 + normal1·normal2),
/// so at obtuse edges the field overstates distance. To size a chamfer by its
/// depth, a setback along each face or its width at an edge of any angle, use
/// intersectChamferNormalized (with chamferDepthFromSetback or
/// chamferDepthFromWidth) or intersectChamferSetbacks.
intersectChamfer(d1, d2, offset) {
  face = max(d1, d2);
  edge = (d1 + d2 + offset) / sqrt2;
  return max(face, edge);
}

/// Chamfered CSG intersection of three SDFs. Chamfers all three pairwise
/// edges and the three-way vertex where they meet.
intersectChamfer(d1, d2, d3, offset) {
  face = max(d1, d2, d3);
  total = d1 + d2 + d3;
  // The strongest edge is between the two nearest faces: the two largest
  // d's, whose sum is the total minus the smallest.
  edge = (total - min(d1, d2, d3) + offset) / sqrt2;
  corner = (total + offset) / sqrt3;
  return max(face, edge, corner);
}

/// Chamfered CSG intersection of N SDFs. `offset` is a scalar that applies
/// to edges and vertices alike, or pass [edgeOffset, vertexOffset] to
/// set them separately.
intersectChamfer(fields, offset) {
  return max(intersectSharp(fields),
    intersectChamferEdges(fields, firstOf(offset)),
    intersectChamferVertices(fields, lastOf(offset)));
}

/// Partial application of intersectChamfer: binds the chamfer offset and
/// returns the operator, ready to hand to a primitive that takes its own blend.
intersectChamfer(offset) {
  return (fields) { return intersectChamfer(fields, offset); };
}

/// Chamfered CSG union with the bevel at `offset`, as for intersectChamfer.
unionChamfer(d1, d2, offset) {
  return neg(intersectChamfer(neg(d1), neg(d2), offset));
}

/// Chamfered CSG union of three SDFs.
unionChamfer(d1, d2, d3, offset) {
  return neg(intersectChamfer(neg(d1), neg(d2), neg(d3), offset));
}

/// Chamfered CSG union of N SDFs. `offset` is a scalar, or
/// [edgeOffset, vertexOffset] to set edges and vertices separately.
unionChamfer(fields, offset) {
  negated = map((field) {
    return neg(field);
  }, fields);
  return neg(intersectChamfer(negated, offset));
}

/// Partial application of unionChamfer: binds the chamfer offset and returns
/// the operator, ready to hand to a primitive that takes its own blend.
unionChamfer(offset) {
  return (fields) { return unionChamfer(fields, offset); };
}

/// Chamfered CSG difference: target minus tool with a chamfered cut.
differenceChamfer(target, tool, offset) {
  return intersectChamfer(target, neg(tool), offset);
}

/// Chamfered CSG intersection by depth: the bevel is the plane `depth` in from
/// the edge, square to the bisector of the angle between the faces, and its
/// field has unit gradient at an edge of any angle. (d1 + d2) / |normal1 +
/// normal2| is the signed distance to the plane through the edge square to that
/// bisector, normal1 and normal2 being the two faces' outward unit normals at
/// the edge, and the bevel is that field offset by `depth`.
///
/// intersectChamfer's bevel is the same plane, but its parameter is added to
/// d1 + d2 before dividing (by sqrt2), so it is the depth times |normal1 +
/// normal2|, a setback along each face only at a square edge. To chamfer by a
/// setback along each face or by the bevel's width, convert with
/// chamferDepthFromSetback or chamferDepthFromWidth.
///
/// Pass the normals when they are known, constant along the edge or
/// analytic; the three-argument form takes them from the fields' gradients.
/// Faces that face opposite ways have no edge to chamfer, and the guard on the
/// divisor keeps the result finite there.
intersectChamferNormalized(d1, d2, depth, normal1, normal2) {
  face = max(d1, d2);
  edge = (d1 + d2) / max(length(normal1 + normal2), 0.000001) + depth;
  return max(face, edge);
}

/// intersectChamferNormalized taking each face's normal from its own field's
/// gradient.
intersectChamferNormalized(d1, d2, depth) {
  return intersectChamferNormalized(d1, d2, depth, d1.dp, d2.dp);
}

/// The depth of a chamfer whose bevel meets each face `setback` from the edge,
/// for the Normalized chamfers. With φ the angle between the faces, through the
/// material, the depth is setback·cos(φ/2), and cos(φ/2) is |normal1 −
/// normal2| / 2, the faces' outward unit normals at the edge: pass the same
/// normals as to the chamfer (d1.dp and d2.dp for its three-argument form).
chamferDepthFromSetback(setback, normal1, normal2) {
  return setback * length(normal1 - normal2) / 2;
}

/// The depth of a chamfer whose bevel is `width` across, edge to edge, for the
/// Normalized chamfers: width/2 · cot(φ/2), with φ the angle between the faces
/// through the material. cot(φ/2) is |normal1 − normal2| / |normal1 + normal2|,
/// the faces' outward unit normals at the edge, as for chamferDepthFromSetback.
chamferDepthFromWidth(width, normal1, normal2) {
  return width / 2 * length(normal1 - normal2) / max(length(normal1 + normal2), 0.000001);
}

/// Union counterpart of intersectChamferNormalized: unionChamfer's surface,
/// with unit gradient at an edge of any angle. The normals are each solid's
/// outward ones, as for the intersection.
unionChamferNormalized(d1, d2, depth, normal1, normal2) {
  return neg(intersectChamferNormalized(neg(d1), neg(d2), depth, neg(normal1), neg(normal2)));
}

/// unionChamferNormalized taking each face's normal from its own field's
/// gradient.
unionChamferNormalized(d1, d2, depth) {
  return unionChamferNormalized(d1, d2, depth, d1.dp, d2.dp);
}

/// Difference counterpart of intersectChamferNormalized: target minus tool,
/// differenceChamfer's surface with unit gradient at any edge. `toolNormal` is
/// the tool's own outward normal; the cut's face points the other way.
differenceChamferNormalized(target, tool, depth, targetNormal, toolNormal) {
  return intersectChamferNormalized(target, neg(tool), depth, targetNormal, neg(toolNormal));
}

/// differenceChamferNormalized taking each face's normal from its own field's
/// gradient.
differenceChamferNormalized(target, tool, depth) {
  return differenceChamferNormalized(target, tool, depth, target.dp, tool.dp);
}

/// Chamfered CSG intersection by two setbacks: the bevel meets the first face
/// `setback1` from the edge and the second `setback2` from it, and its field has
/// unit gradient. With φ the angle between the faces through the material, a
/// point on the first face `setback1` from the edge is setback1·sinφ inside the
/// second, so the bevel is the plane setback1·d1 + setback2·d2 + setback1·
/// setback2·sinφ = 0, divided by the length of its gradient, setback1·normal1 +
/// setback2·normal2. sinφ is taken from the normals' dot product. Equal
/// setbacks give intersectChamferNormalized at chamferDepthFromSetback's depth.
intersectChamferSetbacks(d1, d2, setback1, setback2, normal1, normal2) {
  face = max(d1, d2);
  cosine = dot(normal1, normal2);
  sine = sqrt(max(1 - cosine * cosine, 0));
  edge = (setback1 * d1 + setback2 * d2 + setback1 * setback2 * sine) / max(length(normal1 * setback1 + normal2 * setback2), 0.000001);
  return max(face, edge);
}

/// Union counterpart of intersectChamferSetbacks: `setback1` along the first
/// solid's face, `setback2` along the second's. The normals are each solid's
/// outward ones, as for the intersection.
unionChamferSetbacks(d1, d2, setback1, setback2, normal1, normal2) {
  return neg(intersectChamferSetbacks(neg(d1), neg(d2), setback1, setback2, neg(normal1), neg(normal2)));
}

/// Difference counterpart of intersectChamferSetbacks: target minus tool,
/// `targetSetback` along the target's face and `toolSetback` along the cut's.
/// `toolNormal` is the tool's own outward normal; the cut's face points the
/// other way.
differenceChamferSetbacks(target, tool, targetSetback, toolSetback, targetNormal, toolNormal) {
  return intersectChamferSetbacks(target, neg(tool), targetSetback, toolSetback, targetNormal, neg(toolNormal));
}

/// Chamfered intersection whose chamfer planes are joined by a round fillet
/// of `radius`: intersectChamferBlend with intersectRound(radius). A
/// bevel that fades into a fillet rather than ending in a hard line.
/// Radius 0 gives intersectChamfer's surface.
intersectChamferRound(d1, d2, offset, radius) {
  return intersectChamferBlend(d1, d2, offset, intersectRound(radius));
}

/// Chamfered + rounded intersection of three SDFs.
intersectChamferRound(d1, d2, d3, offset, radius) {
  return intersectChamferBlend(d1, d2, d3, offset, intersectRound(radius));
}

/// Chamfered + rounded CSG intersection of N SDFs. `offset` is a scalar, or
/// [edgeOffset, vertexOffset] to set edges and vertices separately;
/// `radius` is the fillet radius. One fillet joins the face, edge
/// and vertex planes, so edge and vertex rounding are not independent.
intersectChamferRound(fields, offset, radius) {
  return intersectChamferBlend(fields, offset, intersectRound(radius));
}

/// Partial application of intersectChamferRound: binds the chamfer offset and
/// rounding radius and returns the operator, ready to hand to a primitive that
/// takes its own blend.
intersectChamferRound(offset, radius) {
  return (fields) { return intersectChamferRound(fields, offset, radius); };
}

/// Chamfered union whose chamfer planes are joined by a round fillet of
/// `radius`: unionChamferBlend with unionRound(radius).
unionChamferRound(d1, d2, offset, radius) {
  return unionChamferBlend(d1, d2, offset, unionRound(radius));
}

/// Chamfered + rounded union of three SDFs.
unionChamferRound(d1, d2, d3, offset, radius) {
  return unionChamferBlend(d1, d2, d3, offset, unionRound(radius));
}

/// Chamfered + rounded CSG union of N SDFs (see intersectChamferRound for the
/// offset and radius parameters).
unionChamferRound(fields, offset, radius) {
  return unionChamferBlend(fields, offset, unionRound(radius));
}

/// Partial application of unionChamferRound: binds the chamfer offset and
/// rounding radius and returns the operator, ready to hand to a primitive that
/// takes its own blend.
unionChamferRound(offset, radius) {
  return (fields) { return unionChamferRound(fields, offset, radius); };
}

/// Chamfered + rounded CSG difference: target minus tool with a chamfered cut
/// whose planes are joined by a round fillet of `radius`.
differenceChamferRound(target, tool, offset, radius) {
  return intersectChamferRound(target, neg(tool), offset, radius);
}

/// Chamfered intersection whose chamfer planes are combined by `blend`
/// instead of a fixed fillet. blend is an intersection operator over a list,
/// such as intersectRound(radius), intersectLp(width, exponent) or
/// intersectExponential(width);
/// its width is used as given. intersectSharp gives back intersectChamfer.
intersectChamferBlend(d1, d2, offset, blend) {
  face = max(d1, d2);
  edge = (d1 + d2 + offset) / sqrt2;
  return blend([face, edge]);
}

/// Chamfered intersection of three SDFs with its chamfer planes combined by
/// `blend`.
intersectChamferBlend(d1, d2, d3, offset, blend) {
  face = max(d1, d2, d3);
  total = d1 + d2 + d3;
  edge = (total - min(d1, d2, d3) + offset) / sqrt2;
  corner = (total + offset) / sqrt3;
  return blend([face, edge, corner]);
}

/// Chamfered CSG intersection of N SDFs with its chamfer planes combined by
/// `blend`. `offset` is a scalar, or [edgeOffset, vertexOffset].
/// One blend joins the face, edge and vertex planes, so edge and vertex
/// blending are not independent.
intersectChamferBlend(fields, offset, blend) {
  return blend([intersectSharp(fields),
    intersectChamferEdges(fields, firstOf(offset)),
    intersectChamferVertices(fields, lastOf(offset))]);
}

/// Partial application of intersectChamferBlend: binds the chamfer offset and
/// blend and returns the operator, ready to hand to a primitive that takes its
/// own blend.
intersectChamferBlend(offset, blend) {
  return (fields) { return intersectChamferBlend(fields, offset, blend); };
}

/// Chamfered union whose chamfer planes are combined by `blend`, a union
/// operator over a list such as unionRound(radius), unionLp(width, exponent) or
/// unionExponential(width). unionSharp gives back unionChamfer.
unionChamferBlend(d1, d2, offset, blend) {
  face = min(d1, d2);
  edge = (d1 + d2 - offset) / sqrt2;
  return blend([face, edge]);
}

/// Chamfered union of three SDFs with its chamfer planes combined by `blend`.
unionChamferBlend(d1, d2, d3, offset, blend) {
  face = min(d1, d2, d3);
  total = d1 + d2 + d3;
  edge = (total - max(d1, d2, d3) - offset) / sqrt2;
  corner = (total - offset) / sqrt3;
  return blend([face, edge, corner]);
}

/// Chamfered CSG union of N SDFs with its chamfer planes combined by the
/// union operator `blend` (see intersectChamferBlend for offset).
unionChamferBlend(fields, offset, blend) {
  return blend([unionSharp(fields),
    unionChamferEdges(fields, firstOf(offset)),
    unionChamferVertices(fields, lastOf(offset))]);
}

/// Partial application of unionChamferBlend: binds the chamfer offset and
/// blend and returns the operator, ready to hand to a primitive that takes its
/// own blend.
unionChamferBlend(offset, blend) {
  return (fields) { return unionChamferBlend(fields, offset, blend); };
}

/// Chamfered CSG difference: target minus tool, with the chamfer planes
/// combined by the intersection operator `blend` (see intersectChamferBlend).
differenceChamferBlend(target, tool, offset, blend) {
  return intersectChamferBlend(target, neg(tool), offset, blend);
}

/// Edge-coordinate fillets. For each pair of fields in the list, `profile`
/// (a nullary function returning a 2D field of p) is evaluated in the local
/// coordinate where x and y are the two signed distances. The result is the
/// nearest such fillet across all pairs. profile() == length(p.xy) - r gives
/// a round fillet of radius r along every shared edge; other profiles give
/// other cross-sections. Slots that aren't a pair fall back to nothing so
/// they lose the min.
remapEdges(fields, profile) {
  return unionSharp(map((di, i) {
    return unionSharp(map((dj, j) {
      return (j > i) ? remap(profile(), [di, dj, 0]) : nothing;
    }, fields));
  }, fields));
}

/// Exact rounded union of two fields (nullary field1/field2) that uses their
/// surface normals normal1, normal2 to scale the blend, staying accurate where the
/// two gradients differ. The zero set is the sharp union; the field is its
/// exact SDF, so offsetting the result by r rounds the seam with radius r.
unionRoundExact(field1, field2, normal1, normal2) {
  d1 = field1();
  d2 = field2();
  sumScale = length(normal1 + normal2);
  diffScale = length(normal1 - normal2);
  sum = (d1 + d2) / sumScale;
  diff = (d1 - d2) / diffScale;
  sharp = min(d1, d2);
  field1OnSurface2 = remap(field1(), p - d2 * normal2);
  field2OnSurface1 = remap(field2(), p - d1 * normal1);

  return max(field1OnSurface2, field2OnSurface1) > 0 ? sharp : -length([sum, diff]);
}

/// Exact rounded union of two fields (nullary field1/field2), taking each field's
/// surface normal from its own gradient instead of being handed them. Use the
/// four-argument form when a normal is known analytically, or when the same
/// gradient is already computed elsewhere.
unionRoundExact(field1, field2) {
  return unionRoundExact(field1, field2, field1().dp, field2().dp);
}

/// Exact rounded intersection of two fields (nullary field1/field2) that uses
/// their surface normals normal1, normal2 to scale the blend. The De Morgan dual of
/// unionRoundExact: negating a field flips its gradient, so the normals are
/// negated alongside it.
intersectRoundExact(field1, field2, normal1, normal2) {
  return neg(unionRoundExact(
    () { return neg(field1()); },
    () { return neg(field2()); },
    neg(normal1), neg(normal2)));
}

/// Exact rounded intersection of two fields (nullary field1/field2), taking each
/// field's surface normal from its own gradient instead of being handed them.
/// The gradients are of field1 and field2 themselves; the four-argument form
/// negates them along with the fields.
intersectRoundExact(field1, field2) {
  return intersectRoundExact(field1, field2, field1().dp, field2().dp);
}

/// The point nearest c on both fields' tangent planes at c (nullary
/// field1/field2): one Newton step from c toward the edge {field1 = 0, field2 =
/// 0}, the least-norm step c - Jᵀ(JJᵀ)⁻¹[field1, field2] with J the fields'
/// gradients at c. Where the faces are parallel there is no edge, and the guard
/// on the determinant keeps the step finite.
edgeProject(field1, field2, c) {
  v1 = remap(field1(), c);
  v2 = remap(field2(), c);
  n1 = remap(field1().dp, c);
  n2 = remap(field2().dp, c);
  a = dot(n1, n1);
  b = dot(n1, n2);
  d = dot(n2, n2);
  det = max(a * d - b * b, 0.000001);
  step = ((d * v1 - b * v2) * n1 + (a * v2 - b * v1) * n2) / det;
  // A trust region: no component of the step longer than four times the
  // fields' values at c, so a far point or near-parallel faces cannot throw c
  // out of range. It is a clamp, not a rescaling, so that an interval bound
  // over a cell stays as finite as the fields' own.
  reach = 4 * (abs(v1) + abs(v2)) + 0.001;
  return c - clamp(step, neg(reach), reach);
}

/// One Newton step from c toward the point of the edge {field1 = 0, field2 =
/// 0} nearest p (nullary field1/field2): edgeProject's step, then a slide along
/// the edge's tangent at c, the cross product of the fields' gradients there,
/// to the foot of p.
edgeNewtonStep(field1, field2, c) {
  v1 = remap(field1(), c);
  v2 = remap(field2(), c);
  n1 = remap(field1().dp, c);
  n2 = remap(field2().dp, c);
  a = dot(n1, n1);
  b = dot(n1, n2);
  d = dot(n2, n2);
  det = max(a * d - b * b, 0.000001);
  step = ((d * v1 - b * v2) * n1 + (a * v2 - b * v1) * n2) / det;
  reach = 4 * (abs(v1) + abs(v2)) + 0.001;
  q = c - clamp(step, neg(reach), reach);
  t = cross(n1, n2);
  // The slide is to the foot of p on the tangent line, so no component of it
  // is longer than |p - q|; clamped to that, for the same finite bounds.
  slide = dot(p - q, t) / max(dot(t, t), 0.000001) * t;
  span = length(p - q);
  return q + clamp(slide, neg(span), span);
}

/// Exact sharp intersection of two fields (nullary field1/field2) whose faces
/// may be curved: outside the intersection and nearest its edge, the distance
/// to the point c of the edge {field1 = 0, field2 = 0} nearest p, found by
/// `iterations` Newton steps from p (1 to 8). Each step moves to the nearest
/// point of both fields' tangent planes, then slides along the edge to the foot
/// of p; the last step only projects. Near the edge, one step gives the
/// two-argument form's distance, off by 7% of a round's radius on a sphere and
/// a plane; three give 1e-6 mm where the edge is a circle, and five where it is
/// not. Where p - c lies between the two faces' normals at c, p is nearest the
/// edge and the field is |p - c|; elsewhere it is the sharp intersection, exact
/// where the fields are. That test is only as good as c, so use three steps or
/// more. Pass `iterations` as a constant: the steps it does not take are
/// dropped at compile time.
///
/// Offset the fields in by r and the result out by r to round the edge with
/// radius r: intersectRoundExact(() { return f1() + r; }, () { return f2() + r;
/// }, 3) - r. Each step evaluates both fields and their gradients at a new
/// point, so the field costs about iterations + 1 times the sharp one.
intersectRoundExact(field1, field2, iterations) {
  // Start a hair off p: where every point of the edge is equally near (on the
  // axis of a circular edge), a gradient at p may be undefined and no step
  // would pick a direction; from beside p the steps reach one of those points.
  s0 = p + [0.0001, 0.00007, 0.00003];
  s1 = edgeNewtonStep(field1, field2, s0);
  s2 = edgeNewtonStep(field1, field2, s1);
  s3 = edgeNewtonStep(field1, field2, s2);
  s4 = edgeNewtonStep(field1, field2, s3);
  s5 = edgeNewtonStep(field1, field2, s4);
  s6 = edgeNewtonStep(field1, field2, s5);
  s7 = edgeNewtonStep(field1, field2, s6);
  c = iterations >= 8 ? edgeProject(field1, field2, s7)
    : iterations >= 7 ? edgeProject(field1, field2, s6)
    : iterations >= 6 ? edgeProject(field1, field2, s5)
    : iterations >= 5 ? edgeProject(field1, field2, s4)
    : iterations >= 4 ? edgeProject(field1, field2, s3)
    : iterations >= 3 ? edgeProject(field1, field2, s2)
    : iterations >= 2 ? edgeProject(field1, field2, s1)
    : edgeProject(field1, field2, s0);

  // p is nearest the edge where p - c = w1 n1 + w2 n2 with both weights positive.
  n1 = remap(field1().dp, c);
  n2 = remap(field2().dp, c);
  e = p - c;
  a = dot(n1, n1);
  b = dot(n1, n2);
  d = dot(n2, n2);
  det = max(a * d - b * b, 0.000001);
  x1 = dot(e, n1);
  x2 = dot(e, n2);
  w1 = (d * x1 - b * x2) / det;
  w2 = (a * x2 - b * x1) / det;
  // Only outside the intersection can p be nearest its edge; there the
  // distance to it is at least either field's, and at most sharp / sin(φ/2),
  // φ the angle between the faces, |normal1 + normal2| / 2 = sin(φ/2): from a
  // point far from the edge the steps can reach another point of it where the
  // distance along it is stationary (the far side of a circular edge), whose
  // normals also hold p - c, and this bound, with room for curvature, rejects it.
  sharp = max(field1(), field2());
  plausible = length(e) * length(n1 + n2) / 2 <= 1.5 * sharp + 0.001;
  return min(w1, w2, sharp) > 0 && plausible ? max(length(e), sharp) : sharp;
}

/// Exact sharp union of two fields (nullary field1/field2) whose faces may be
/// curved, the De Morgan dual of intersectRoundExact(field1, field2,
/// iterations): inside the union and nearest its seam, minus the distance to
/// the seam's point nearest p. Offset the fields out by r and the result in by
/// r to round the seam with radius r: unionRoundExact(() { return f1() - r; },
/// () { return f2() - r; }, 3) + r.
unionRoundExact(field1, field2, iterations) {
  return neg(intersectRoundExact(
    () { return neg(field1()); },
    () { return neg(field2()); },
    iterations));
}

/// Rvachev R0 intersection of a list of SDFs, gated to a transition band of
/// width `band`. Beyond -band (well inside the sharp solid) it is the sharp
/// intersection; within the band it eases (cubic smoothstep) toward pure R0,
/// sum(d) + sqrt(sum(d*d)). For two inputs R0's zero set is the sharp
/// intersection's, so band shapes the field, not the surface; with three or more
/// the n-ary form is not associative and the boundary shifts near
/// multi-input corners.
intersectRvachev(fields, band) {
  sharp = intersectSharp(fields);
  sum = reduce(0, (runningSum, field) { return runningSum + field; }, fields);
  sumOfSquares = reduce(0, (runningSum, field) { return runningSum + field * field; }, fields);
  rvachev = sum + sqrt(sumOfSquares);
  safeBand = max(band, 0.000001);
  progress = clamp((sharp + safeBand) / safeBand, 0, 1);
  weight = progress * progress * (3 - 2 * progress);
  blended = (1 - weight) * sharp + weight * rvachev;
  return sharp < -safeBand ? sharp : blended;
}

/// Rvachev R0 intersection of two SDFs (see the list form).
intersectRvachev(d1, d2, band) {
  return intersectRvachev([d1, d2], band);
}

/// Rvachev R0 intersection of three SDFs (see the list form).
intersectRvachev(d1, d2, d3, band) {
  return intersectRvachev([d1, d2, d3], band);
}

/// Partial application of intersectRvachev: binds the blend width and returns
/// the operator, ready to hand to a primitive that takes its own blend.
intersectRvachev(band) {
  return (fields) { return intersectRvachev(fields, band); };
}

/// Rvachev R0 union of a list of SDFs (via De Morgan's law).
unionRvachev(fields, band) {
  negated = map((field) { return neg(field); }, fields);
  return neg(intersectRvachev(negated, band));
}

/// Rvachev R0 union of two SDFs (see the list form).
unionRvachev(d1, d2, band) {
  return unionRvachev([d1, d2], band);
}

/// Rvachev R0 union of three SDFs (see the list form).
unionRvachev(d1, d2, d3, band) {
  return unionRvachev([d1, d2, d3], band);
}

/// Partial application of unionRvachev: binds the blend width and returns the
/// operator, ready to hand to a primitive that takes its own blend.
unionRvachev(band) {
  return (fields) { return unionRvachev(fields, band); };
}

/// Rvachev R0 difference: target minus tool.
differenceRvachev(target, tool, band) {
  return intersectRvachev([target, neg(tool)], band);
}

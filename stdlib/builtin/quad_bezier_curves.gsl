// =========================================================
// QUADRATIC BEZIER CURVES
// =========================================================

/// Quadratic Bézier curve from `start` through `control` to `end`. Returns
/// (distance, t, closestPoint) where t is the curve parameter at the
/// closest point on the curve to p, and closestPoint is that point.
//
// Based on Inigo Quilez formulation (the cubic closest-point solve); the locals
// keep his names.
bezierQuadPointRound(start, control, end) {
  e = control - start;
  f = start - 2.0 * control + end;
  g = 2.0 * e;
  d = start - p;

  ff = dot(f, f);
  ef = dot(e, f);
  ee = dot(e, e);
  df = dot(d, f);
  de = dot(d, e);

  // A control point on the chord midpoint makes f vanish and the curve a
  // straight segment. The cubic's leading coefficient is then ~0, and dividing
  // by it overflows f32 (wrong distances, then NaN on longer curves), so the
  // divisor is floored relative to the curve's own size and the straight case
  // takes the segment projection below instead.
  straight = ff < 1e-6 * ee;
  kk = 1.0 / max(ff, 1e-6 * ee + 1e-20);
  kx = kk * ef;
  ky = kk * (2.0 * ee + df) / 3.0;
  kz = kk * de;

  pp = ky - kx * kx;
  qq = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
  h = qq * qq + 4.0 * pp * pp * pp;

  sh = sqrt(max(h, 0.0));
  w1 = (sh - qq) / 2.0;
  w2 = (-sh - qq) / 2.0;
  u1 = sign(w1) * exp(ln(max(abs(w1), 1e-12)) / 3.0);
  u2 = sign(w2) * exp(ln(max(abs(w2), 1e-12)) / 3.0);
  t1 = clamp(u1 + u2 - kx, 0.0, 1.0);
  ev1 = d + (g + f * t1) * t1;
  d1 = dot(ev1, ev1);

  zz = sqrt(max(-pp, 0.0));
  v = acos(clamp(qq / (2.0 * pp * zz - 1e-20), -1.0, 1.0)) / 3.0;
  m = cos(v);
  n = sin(v) * 1.732050808;
  ta = clamp((m + m) * zz - kx, 0.0, 1.0);
  tb = clamp((-n - m) * zz - kx, 0.0, 1.0);
  tc = clamp((n - m) * zz - kx, 0.0, 1.0);
  eva = d + (g + f * ta) * ta;
  da = dot(eva, eva);
  evb = d + (g + f * tb) * tb;
  dbb = dot(evb, evb);
  evc = d + (g + f * tc) * tc;
  dc = dot(evc, evc);

  tBest3 = (da <= dbb) ? ((da <= dc) ? ta : tc) : ((dbb <= dc) ? tb : tc);
  d3 = min(min(da, dbb), dc);

  // Straight: B(t) = start + g t, so t is the projection onto g.
  tLine = clamp(-dot(d, g) / (dot(g, g) + 1e-20), 0.0, 1.0);
  evLine = d + (g + f * tLine) * tLine;
  dLine = dot(evLine, evLine);

  dist2 = straight ? dLine : ((h >= 0.0) ? d1 : d3);
  tBest = straight ? tLine : ((h >= 0.0) ? t1 : tBest3);

  closestPoint = start + g * tBest + f * tBest * tBest;
  distanceToCurve = sqrt(dist2);

  return distanceToCurve, tBest, closestPoint;
}

/// Same as bezierQuadPointRound but also returns the unit tangent at
/// the closest point. Returns (distance, t, closestPoint, tangent).
bezierQuadTanRound(start, control, end) {
  distanceToCurve, tBest, closestPoint = bezierQuadPointRound(start, control, end);

  // Derivative of quadratic bezier at t:
  //   B'(t) = 2(1-t)(control-start) + 2t(end-control)
  //         = 2(control-start) + 2t(start - 2control + end)
  e = control - start;
  f = start - 2.0 * control + end;
  tangentRaw = 2.0 * e + 2.0 * f * tBest;
  tangent = tangentRaw / (length(tangentRaw) + 1e-12);

  return distanceToCurve, tBest, closestPoint, tangent;
}

/// Convenience wrapper around bezierQuadPointRound that returns only the
/// distance to the curve.
bezierQuadRound(start, control, end) {
  distanceToCurve, tBest, closestPoint = bezierQuadPointRound(start, control, end);
  return distanceToCurve;
}

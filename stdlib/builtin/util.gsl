// =========================================================
// UTILITIES
// =========================================================

/// Linear interpolation between a and b by parameter t. t = 0 returns
/// a, t = 1 returns b; values outside [0, 1] extrapolate.
mix(a, b, t) {
  return a + (b - a) * t;
}

/// Mix between a and b by an angle: a*cos(angle) + b*sin(angle). a at
/// angle = 0, b at angle = pi/2.
mixAngle(a, b, angle) {
  return a * cos(angle) + b * sin(angle);
}

/// Linearly remap value from [inMin, inMax] to [outMin, outMax]. Does
/// not clamp — values outside the input range extrapolate. Use ramp()
/// when you want clamping.
linearMap(value, inMin, inMax, outMin, outMax) {
  slope = (outMax - outMin) / (inMax - inMin);
  return (value - inMin) * slope + outMin;
}

/// Like linearMap() but clamps the result to the output range, so
/// values outside [inMin, inMax] saturate instead of extrapolating.
ramp(value, inMin, inMax, outMin, outMax) {
  mapped = linearMap(value, inMin, inMax, outMin, outMax);
  low = min(outMin, outMax);
  high = max(outMin, outMax);
  return clamp(mapped, low, high);
}

/// Like ramp(), but normalizes the ramped offset with the assumption that the modulator 
/// is orthogonal to the field to be offset.
rampOffset(field, modulator, modulatorMin, modulatorMax, offsetMin, offsetMax) {
  fieldBase = field - offsetMin;
  fieldEnd = field - offsetMax;
  
  slope = (offsetMax - offsetMin) / (modulatorMax - modulatorMin);
  ramped = field - ((modulator - modulatorMin) * slope + offsetMin);
  scale = sqrt(1 + slope * slope);
  
  return offsetMin < offsetMax ?
    min(max(ramped / scale, fieldEnd), fieldBase) :
    fieldBase :
    max(min(ramped / scale, fieldEnd), fieldBase);
}

/// Like rampOffset(), but with blend radii.
rampOffset(field, modulator, modulatorMin, modulatorMax, offsetMin, offsetMax, blendMin, blendMax) {
  fieldBase = field - offsetMin;
  fieldEnd = field - offsetMax;
  
  slope = (offsetMax - offsetMin) / (modulatorMax - modulatorMin);
  ramped = field - ((modulator - modulatorMin) * slope + offsetMin);
  scale = sqrt(1 + slope * slope);
  
  return offsetMin < offsetMax ?
    unionRound(intersectRound(ramped / scale, fieldEnd, blendMax), fieldBase, blendMin) :
    fieldBase :
    intersectRound(unionRound(ramped / scale, fieldEnd, blendMax), fieldBase, blendMin);
}

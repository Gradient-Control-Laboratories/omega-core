// =========================================================
// SWEEP LOFT
// =========================================================
/// Distance to a quadratic Bezier tube from `start` through `control` to `end`
/// with `radius`; `orientation` orients the inside/outside sign. Returns
/// (signedDistance, t, arcLength, closestPoint, tangent).
//
// Based on Inigo Quilez formulation (the cubic closest-point solve); the locals
// keep his names.
bezierTubeDir(start, control, end, radius, orientation) {
  e = control - start;
  f = start - 2.0 * control + end;
  g = 2.0 * e;
  d = start - p;

  ff = dot(f, f);
  ef = dot(e, f);
  ee = dot(e, e);
  df = dot(d, f);
  de = dot(d, e);

  kk = 1.0 / (ff + 1e-10);
  kx = kk * ef;
  ky = kk * (2.0 * ee + df) / 3.0;
  kz = kk * de;

  pp = ky - kx * kx;
  qq = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
  h = qq * qq + 4.0 * pp * pp * pp;

  sh = sqrt(max(h, 0.0));
  w1 = (sh - qq) / 2.0;
  w2 = (-sh - qq) / 2.0;
  u1 = sign(w1) * exp(ln(max(abs(w1), 1e-12)) / 3.0);
  u2 = sign(w2) * exp(ln(max(abs(w2), 1e-12)) / 3.0);
  t1 = clamp(u1 + u2 - kx, 0.0, 1.0);
  ev1 = d + (g + f * t1) * t1;
  d1 = dot(ev1, ev1);

  zz = sqrt(max(-pp, 0.0));
  v = acos(clamp(qq / (2.0 * pp * zz - 1e-20), -1.0, 1.0)) / 3.0;
  m = cos(v);
  n = sin(v) * 1.732050808;
  ta = clamp((m + m) * zz - kx, 0.0, 1.0);
  tb = clamp((-n - m) * zz - kx, 0.0, 1.0);
  tc = clamp((n - m) * zz - kx, 0.0, 1.0);
  eva = d + (g + f * ta) * ta;
  da = dot(eva, eva);
  evb = d + (g + f * tb) * tb;
  dbb = dot(evb, evb);
  evc = d + (g + f * tc) * tc;
  dc = dot(evc, evc);

  tBest3 = (da <= dbb) ? ((da <= dc) ? ta : tc) : ((dbb <= dc) ? tb : tc);
  d3 = min(min(da, dbb), dc);

  dist2 = (h >= 0.0) ? d1 : d3;
  tBest = (h >= 0.0) ? t1 : tBest3;

  unsignedDistance = sqrt(dist2) - radius;

  closestPoint = start + g * tBest + f * tBest * tBest;

  tangentRaw = g + 2.0 * f * tBest;
  tangentLength = length(tangentRaw);
  tangent = tangentRaw / (tangentLength + 1e-12);

  offset = p - closestPoint;
  orientationSign = sign(dot(offset, normalize(orientation)));
  signedDistance = (orientationSign != 0) ? orientationSign * unsignedDistance : unsignedDistance;

  chordLength = length(end - start);
  polygonLength = length(control - start) + length(end - control);
  arcLength = (chordLength + polygonLength) * 0.5;

  return signedDistance, tBest, arcLength, closestPoint, tangent;
}

/// Sweep a 2D profile along a quadratic Bezier start -> control -> end, lofting
/// from startProfile at the start to endProfile at the end. The profile
/// arguments are nullary functions returning a 2D field of p.
sweepLoft(startProfile, endProfile, start, control, end, orientation, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  localPoint = [localX, localY, 0];
  startDistance = remap(startProfile(), localPoint);
  endDistance   = remap(endProfile(),   localPoint);

  profileDistance = mix(startDistance, endDistance, curveParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoft, combining the profile with its two end caps sharply.
sweepLoft(startProfile, endProfile, start, control, end, orientation) {
  return sweepLoft(startProfile, endProfile, start, control, end, orientation, intersectSharp);
}

/// Like sweepLoft, but scales the profile linearly from 1 to `scale`
/// along the sweep.
sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, curveParameter);
  endScale = mix(inverseScale, 1.0, curveParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, curveParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoftScale, combining the profile with its two end caps sharply.
sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale) {
  return sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale, intersectSharp);
}

/// Like sweepLoftScale, but eases the scale with a smoothstep along the
/// sweep instead of linearly.
sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  clampedParameter = clamp(curveParameter, 0.0, 1.0);
  easedParameter = clampedParameter * clampedParameter * (3.0 - 2.0 * clampedParameter);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, easedParameter);
  endScale = mix(inverseScale, 1.0, easedParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, easedParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoftScaleSmooth, combining the profile with its two end caps sharply.
sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale) {
  return sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale, intersectSharp);
}

/// Variant of sweepLoftScaleSmooth that returns the swept profile and the
/// two end caps separately as (profileDistance, startCap, endCap).
sweepLoftScaleSmoothSeparateCaps(startProfile, endProfile, start, control, end, orientation, scale) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  clampedParameter = clamp(curveParameter, 0.0, 1.0);
  easedParameter = clampedParameter * clampedParameter * (3.0 - 2.0 * clampedParameter);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, easedParameter);
  endScale = mix(inverseScale, 1.0, easedParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, easedParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return profileDistance, startCap, endCap;
}

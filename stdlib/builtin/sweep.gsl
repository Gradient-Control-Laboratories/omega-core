// =========================================================
// SWEEP LOFT
// =========================================================
/// Distance to a quadratic Bezier tube from `start` through `control` to `end`
/// with `radius`; `orientation` orients the inside/outside sign. Returns
/// (signedDistance, t, arcLength, closestPoint, tangent).
//
// Based on Inigo Quilez formulation (the cubic closest-point solve); the locals
// keep his names.
bezierTubeDir(start, control, end, radius, orientation) {
  e = control - start;
  f = start - 2.0 * control + end;
  g = 2.0 * e;
  d = start - p;

  ff = dot(f, f);
  ef = dot(e, f);
  ee = dot(e, e);
  df = dot(d, f);
  de = dot(d, e);

  kk = 1.0 / (ff + 1e-10);
  kx = kk * ef;
  ky = kk * (2.0 * ee + df) / 3.0;
  kz = kk * de;

  pp = ky - kx * kx;
  qq = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
  h = qq * qq + 4.0 * pp * pp * pp;

  sh = sqrt(max(h, 0.0));
  w1 = (sh - qq) / 2.0;
  w2 = (-sh - qq) / 2.0;
  u1 = sign(w1) * exp(ln(max(abs(w1), 1e-12)) / 3.0);
  u2 = sign(w2) * exp(ln(max(abs(w2), 1e-12)) / 3.0);
  t1 = clamp(u1 + u2 - kx, 0.0, 1.0);
  ev1 = d + (g + f * t1) * t1;
  d1 = dot(ev1, ev1);

  zz = sqrt(max(-pp, 0.0));
  v = acos(clamp(qq / (2.0 * pp * zz - 1e-20), -1.0, 1.0)) / 3.0;
  m = cos(v);
  n = sin(v) * 1.732050808;
  ta = clamp((m + m) * zz - kx, 0.0, 1.0);
  tb = clamp((-n - m) * zz - kx, 0.0, 1.0);
  tc = clamp((n - m) * zz - kx, 0.0, 1.0);
  eva = d + (g + f * ta) * ta;
  da = dot(eva, eva);
  evb = d + (g + f * tb) * tb;
  dbb = dot(evb, evb);
  evc = d + (g + f * tc) * tc;
  dc = dot(evc, evc);

  tBest3 = (da <= dbb) ? ((da <= dc) ? ta : tc) : ((dbb <= dc) ? tb : tc);
  d3 = min(min(da, dbb), dc);

  dist2 = (h >= 0.0) ? d1 : d3;
  tBest = (h >= 0.0) ? t1 : tBest3;

  unsignedDistance = sqrt(dist2) - radius;

  closestPoint = start + g * tBest + f * tBest * tBest;

  tangentRaw = g + 2.0 * f * tBest;
  tangentLength = length(tangentRaw);
  tangent = tangentRaw / (tangentLength + 1e-12);

  offset = p - closestPoint;
  orientationSign = sign(dot(offset, normalize(orientation)));
  signedDistance = (orientationSign != 0) ? orientationSign * unsignedDistance : unsignedDistance;

  chordLength = length(end - start);
  polygonLength = length(control - start) + length(end - control);
  arcLength = (chordLength + polygonLength) * 0.5;

  return signedDistance, tBest, arcLength, closestPoint, tangent;
}

/// Sweep a 2D profile along a quadratic Bezier start -> control -> end, lofting
/// from startProfile at the start to endProfile at the end. The profile
/// arguments are nullary functions returning a 2D field of p.
sweepLoft(startProfile, endProfile, start, control, end, orientation, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  localPoint = [localX, localY, 0];
  startDistance = remap(startProfile(), localPoint);
  endDistance   = remap(endProfile(),   localPoint);

  profileDistance = mix(startDistance, endDistance, curveParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoft, combining the profile with its two end caps sharply.
sweepLoft(startProfile, endProfile, start, control, end, orientation) {
  return sweepLoft(startProfile, endProfile, start, control, end, orientation, intersectSharp);
}

/// Like sweepLoft, but scales the profile linearly from 1 to `scale`
/// along the sweep.
sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, curveParameter);
  endScale = mix(inverseScale, 1.0, curveParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, curveParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoftScale, combining the profile with its two end caps sharply.
sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale) {
  return sweepLoftScale(startProfile, endProfile, start, control, end, orientation, scale, intersectSharp);
}

/// Like sweepLoftScale, but eases the scale with a smoothstep along the
/// sweep instead of linearly.
sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale, blend) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  clampedParameter = clamp(curveParameter, 0.0, 1.0);
  easedParameter = clampedParameter * clampedParameter * (3.0 - 2.0 * clampedParameter);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, easedParameter);
  endScale = mix(inverseScale, 1.0, easedParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, easedParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return blend([profileDistance, startCap, endCap]);
}

/// As sweepLoftScaleSmooth, combining the profile with its two end caps sharply.
sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale) {
  return sweepLoftScaleSmooth(startProfile, endProfile, start, control, end, orientation, scale, intersectSharp);
}

/// Variant of sweepLoftScaleSmooth that returns the swept profile and the
/// two end caps separately as (profileDistance, startCap, endCap).
sweepLoftScaleSmoothSeparateCaps(startProfile, endProfile, start, control, end, orientation, scale) {
  distanceToCurve, curveParameter, arcLength, closestPoint, tangent = bezierTubeDir(start, control, end, 0, orientation);

  unitOrientation = normalize(orientation);
  orientationInPlane = unitOrientation - tangent * dot(unitOrientation, tangent);
  orientationInPlaneLength = length(orientationInPlane);
  binormal = orientationInPlane / (orientationInPlaneLength + 1e-12);
  normal = cross(tangent, binormal);

  offset = p - closestPoint;
  localX = dot(offset, normal);
  localY = dot(offset, binormal);

  clampedParameter = clamp(curveParameter, 0.0, 1.0);
  easedParameter = clampedParameter * clampedParameter * (3.0 - 2.0 * clampedParameter);

  inverseScale = 1.0 / scale;

  startScale = mix(1.0, scale, easedParameter);
  endScale = mix(inverseScale, 1.0, easedParameter);

  startLocalPoint = [localX / startScale, localY / startScale, 0];
  endLocalPoint   = [localX / endScale,   localY / endScale,   0];

  startDistance = remap(startProfile(), startLocalPoint) * startScale;
  endDistance   = remap(endProfile(),   endLocalPoint)   * endScale;

  profileDistance = mix(startDistance, endDistance, easedParameter);

  startTangent = normalize(2.0 * (control - start));
  endTangent = normalize(2.0 * (end - control));
  startCap = neg(dot(p - start, startTangent));
  endCap = dot(p - end, endTangent);

  return profileDistance, startCap, endCap;
}

// =========================================================
// EXTRUDE AND REVOLVE
// =========================================================

/// A profile extruded along Z: `profile`, a 2D field in the XY plane such as
/// profileXY's, kept between the planes z = `low` and z = `high`, using
/// `blend` to combine the profile with the two caps — pass
/// `intersectRound(radius)` to round both rims, or any other operator taking
/// a list of fields, as on cylinderCapped. Its box is the profile's between
/// the two planes. Its frame: .u the profile's own, the distance along its
/// loop where it has one, and .v the height z, both in mm, on the sides and
/// the caps alike.
extrude(profile, low, high, blend) {
  middle = (low + high) / 2;
  halfHeight = abs(high - low) / 2;
  form = blend([profile, abs(p.z - middle) - halfHeight]);
  form.v = extrudeV();
  return form;
}

// An extrusion's v: the height, in mm.
extrudeV() {
  return p.z;
}

/// A profile extruded along Z between z = `low` and z = `high`, with sharp
/// rims. An exact profile gives an exact solid: the caps are square to it.
extrude(profile, low, high) {
  form = extrude(profile, low, high, intersectRound(0));
  form.v = extrudeV();
  return form;
}

/// A profile revolved a full turn about a line in its own plane: the line
/// through `axisPoint` along `axisDirection`, both 2D, in the XY plane where
/// `profile` is drawn. The profile is read at the axis's own distance and v
/// (as axisCylindrical gives them), laid back onto the sketch, so it
/// stays where it was drawn and the solid's section in the XY plane is the
/// profile itself. It is read on the right of the direction; reverse the
/// direction to revolve what lies on the left. Keep the profile to that one
/// side. An exact profile then gives an exact solid, unless it has an edge
/// lying along the axis: that edge is not a surface of the solid, but the
/// distance inside still counts it. Draw the whole section across the axis,
/// symmetric about it, to keep the inside exact as well. Its
/// frame is a surface of revolution's, as the cylinder's and the torus's are:
/// .u the angle round the axis in radians, zero on the sketch plane where the
/// profile is drawn and counterclockwise seen from the tip of the direction,
/// and .v the profile's own .u, the distance along its loop where it has
/// one. Its box is the profile's, turned about the axis.
//
// Internal: the body is one remap, its coordinate written out in scalars of
// p, the parameters and primitives alone: no locals, no call to axis() or
// axisDistance(), whose values these are, and no component taken of a call's
// result. Only such a function is read as the remap it is (property's
// unwrapRemaps), and only then do the profile's colour and material turn
// with it. The frame is written at the call (property's revolveFrame), from
// revolveAngle and this body's coordinate. The first line is the point as far along the axis as p, the
// second term of each the distance from the axis, laid to the right of its
// direction; that distance is taken from the one cross product and z, not
// from a difference of squares, to keep its interval bound.
revolve(profile, axisPoint, axisDirection) {
  return remap(profile, [
    axisPoint.x + axisDirection.x / length(axisDirection) * ((p.x - axisPoint.x) * axisDirection.x + (p.y - axisPoint.y) * axisDirection.y) / length(axisDirection) + axisDirection.y / length(axisDirection) * length([((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection), p.z]),
    axisPoint.y + axisDirection.y / length(axisDirection) * ((p.x - axisPoint.x) * axisDirection.x + (p.y - axisPoint.y) * axisDirection.y) / length(axisDirection) - axisDirection.x / length(axisDirection) * length([((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection), p.z]),
    0]);
}

// revolve's .u: the angle round the line through `axisPoint` along
// `axisDirection`, both 2D in the XY plane, in radians. It is zero on the XY
// plane to the right of the direction, where revolve reads its profile, and
// runs counterclockwise seen from the tip of the direction, so toward -Z.
revolveAngle(axisPoint, axisDirection) {
  return atan(neg(p.z), ((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection));
}

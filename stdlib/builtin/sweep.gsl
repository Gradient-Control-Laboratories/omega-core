// =========================================================
// EXTRUDE AND REVOLVE
// =========================================================

/// A profile extruded along Z: `profile`, a 2D field in the XY plane such as
/// profileXY's, kept between the planes z = `low` and z = `high`, using
/// `blend` to combine the profile with the two caps — pass
/// `intersectRound(radius)` to round both rims, or any other operator taking
/// a list of fields, as on cylinderCapped. Its box is the profile's between
/// the two planes. Its frame: .u the profile's own, the distance along its
/// loop where it has one, and .v the height z, both in mm, on the sides and
/// the caps alike.
extrude(profile, low, high, blend) {
  middle = (low + high) / 2;
  halfHeight = abs(high - low) / 2;
  form = blend([profile, abs(p.z - middle) - halfHeight]);
  form.v = extrudeV();
  return form;
}

// An extrusion's v: the height, in mm.
extrudeV() {
  return p.z;
}

/// A profile extruded along Z between z = `low` and z = `high`, with sharp
/// rims. An exact profile gives an exact solid: the caps are square to it.
extrude(profile, low, high) {
  form = extrude(profile, low, high, intersectRound(0));
  form.v = extrudeV();
  return form;
}

/// A profile revolved a full turn about a line in its own plane: the line
/// through `axisPoint` along `axisDirection`, both 2D, in the XY plane where
/// `profile` is drawn. The profile is read at the axis's own distance and v
/// (as axisCylindrical gives them), laid back onto the sketch, so it
/// stays where it was drawn and the solid's section in the XY plane is the
/// profile itself. It is read on the right of the direction; reverse the
/// direction to revolve what lies on the left. Keep the profile to that one
/// side. An exact profile then gives an exact solid, unless it has an edge
/// lying along the axis: that edge is not a surface of the solid, but the
/// distance inside still counts it. Draw the whole section across the axis,
/// symmetric about it, to keep the inside exact as well. Its
/// frame is a surface of revolution's, as the cylinder's and the torus's are:
/// .u the angle round the axis in radians, zero on the sketch plane where the
/// profile is drawn and counterclockwise seen from the tip of the direction,
/// and .v the profile's own .u, the distance along its loop where it has
/// one. Its box is the profile's, turned about the axis.
//
// Internal: the body is one remap, its coordinate written out in scalars of
// p, the parameters and primitives alone: no locals, no call to axis() or
// axisDistance(), whose values these are, and no component taken of a call's
// result. Only such a function is read as the remap it is (property's
// unwrapRemaps), and only then do the profile's colour and material turn
// with it. The frame is written at the call (property's revolveFrame), from
// revolveAngle and this body's coordinate. The first line is the point as far along the axis as p, the
// second term of each the distance from the axis, laid to the right of its
// direction; that distance is taken from the one cross product and z, not
// from a difference of squares, to keep its interval bound.
revolve(profile, axisPoint, axisDirection) {
  return remap(profile, [
    axisPoint.x + axisDirection.x / length(axisDirection) * ((p.x - axisPoint.x) * axisDirection.x + (p.y - axisPoint.y) * axisDirection.y) / length(axisDirection) + axisDirection.y / length(axisDirection) * length([((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection), p.z]),
    axisPoint.y + axisDirection.y / length(axisDirection) * ((p.x - axisPoint.x) * axisDirection.x + (p.y - axisPoint.y) * axisDirection.y) / length(axisDirection) - axisDirection.x / length(axisDirection) * length([((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection), p.z]),
    0]);
}

// revolve's .u: the angle round the line through `axisPoint` along
// `axisDirection`, both 2D in the XY plane, in radians. It is zero on the XY
// plane to the right of the direction, where revolve reads its profile, and
// runs counterclockwise seen from the tip of the direction, so toward -Z.
revolveAngle(axisPoint, axisDirection) {
  return atan(neg(p.z), ((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection));
}

/// A profile revolved through `angle` about a line in its own plane, as
/// revolve(profile, axisPoint, axisDirection) but only part of the way round,
/// with flat caps. `angle`, in radians, starts at the sketch plane, where the
/// profile is drawn, and runs counterclockwise seen from the tip of the
/// direction, so toward -Z, as the frame's .u does; a negative angle turns
/// the other way. An exact profile gives an exact solid, caps included, under
/// revolve's own conditions: keep the profile to the right of the direction.
/// Its frame and box are revolve's: .u the angle round the axis, .v the
/// profile's own .u, the box the full turn's.
//
// Internal: the distance is the least of three: to the revolved surface,
// within the sweep only; and to each cap, the profile lying flat in its
// half-plane, which from p is sqrt(h^2 + max(d, 0)^2) for p's distance h from
// the cap's plane and the profile's distance d at p's foot in it. The first
// cap is the sketch plane itself, so its d is the profile where it stands.
// The revolved distance is gated by a constant, and the sign is read from the
// revolved distance against the sweep, as profileXY reads its sign, so a cell
// on the surface stays bounded by the distance.
revolve(profile, axisPoint, axisDirection, angle) {
  along = ((p.x - axisPoint.x) * axisDirection.x + (p.y - axisPoint.y) * axisDirection.y) / length(axisDirection);
  right = ((p.x - axisPoint.x) * axisDirection.y - (p.y - axisPoint.y) * axisDirection.x) / length(axisDirection);
  radial = length([right, p.z]);
  revolved = remap(profile, [
    axisPoint.x + (along * axisDirection.x + radial * axisDirection.y) / length(axisDirection),
    axisPoint.y + (along * axisDirection.y - radial * axisDirection.x) / length(axisDirection),
    0]);
  farRight = right * cos(angle) - p.z * sin(angle);
  farDepth = right * sin(angle) + p.z * cos(angle);
  farCap = remap(profile, [
    axisPoint.x + (along * axisDirection.x + farRight * axisDirection.y) / length(axisDirection),
    axisPoint.y + (along * axisDirection.y - farRight * axisDirection.x) / length(axisDirection),
    0]);
  // The sweep as a field, negative inside it: on the swept side of both cap
  // planes (of either, for more than half a turn). Two planes, not an angle,
  // so a box near the axis or a cap is bounded tightly.
  turn = angle >= 0 ? 1 : neg(1);
  wedge = abs(angle) <= pi ? max(turn * p.z, neg(turn) * farDepth) : min(turn * p.z, neg(turn) * farDepth);
  reach = min(max(abs(revolved), wedge <= 0 ? 0 : nothing),
              length([p.z, max(profile, 0)]),
              length([farDepth, max(farCap, 0)]));
  return max(revolved, wedge) < 0 ? neg(reach) : reach;
}

/// A 2D section swept along a closed path in the XY plane. `path` is any
/// exact 2D field whose zero line is the path: a profileXY loop, a nested()
/// of loops, a circle. `section` is a 2D profile drawn with x across the path,
/// positive outside it, and y up, which becomes the height z. The section is
/// read at the path's signed distance and the height, so its x = 0 line rides
/// the path. The distance is never more than the true distance anywhere. It
/// is exact while the whole section stays inside the path's tube: on the
/// inside of every bend no farther across than the bend's radius, and nowhere
/// past the middle of the shape the path encloses. A sharp corner is a bend of
/// no radius: there the section sweeps round the outside and meets itself in a
/// mitre on the inside, and near the corner the distance is a bound, short of
/// the true one. Fillet the path's corners, wider than the section reaches,
/// for a smooth sweep and an exact distance. Its frame: .u the
/// path's own .u, the distance along it, and .v the section's .u, the
/// distance round the section. Its box is the path's grown by the section's
/// reach across it, between the section's lowest and highest.
//
// Internal: the body is one remap of the section, its coordinate in p and
// the parameters alone, so the section's colour and material move with it
// (property's unwrapRemaps); the frame is written at the call (property's
// sweepFrame) and the box by property's swept rule.
sweep(section, path) {
  return remap(section, [path, p.z, 0]);
}

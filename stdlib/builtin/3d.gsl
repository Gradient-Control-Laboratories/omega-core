// =========================================================
// 3D PRIMITIVES
// =========================================================

// --- Spheres ---

/// Sphere centered at the origin with the given radius. Use remap() to
/// place it elsewhere or to project it into a different dimension.
//
// Internal: built from length(p), so it degenerates cleanly to circles /
// hyperspheres when p is first projected to a lower or higher dimension
// via remap. Library functions that need a sphere should call sphere()
// rather than reimplementing length(p) - r so behavior stays consistent.
sphere(radius) {
  form = length(p) - radius;
  form.u = sphereAzimuth([0.0, 0.0, 0.0], vector.dirZ, vector.dirX);
  form.v = spherePolar([0.0, 0.0, 0.0], vector.dirZ);
  return form;
}

/// Sphere of the given radius centered at `center`.
sphere(center, radius) {
  form = length(p - center) - radius;
  form.u = sphereAzimuth(center, vector.dirZ, vector.dirX);
  form.v = spherePolar(center, vector.dirZ);
  return form;
}

/// Sphere of the given radius centered at `center`, its frame (.u, .v) measured
/// about `pole` from `reference`: .u the azimuth round the pole from the
/// reference and .v the angle down from the pole, both in radians. Without the
/// two directions the pole is +Z and the reference +X. `reference` need not be
/// perpendicular to `pole`, only not parallel to it.
sphere(center, radius, pole, reference) {
  form = length(p - center) - radius;
  form.u = sphereAzimuth(center, pole, reference);
  form.v = spherePolar(center, pole);
  return form;
}

// A sphere's frame: the azimuth round `pole` from `reference`, in (-pi, pi],
// and the polar angle down from the pole, in [0, pi], both radians. The
// azimuth wraps across one half-plane and is singular at the poles; the polar
// angle never wraps.
sphereAzimuth(center, pole, reference) {
  n = normalize(pole);
  e1 = normalize(reference - n * dot(reference, n));
  e2 = cross(n, e1);
  d = p - center;
  return atan(dot(d, e2), dot(d, e1));
}

spherePolar(center, pole) {
  n = normalize(pole);
  d = p - center;
  along = dot(d, n);
  return atan(length(d - n * along), along);
}

// --- Axes (infinite lines) ---

/// Distance to an infinite line through `center` along `direction`.
/// `direction` does not need to be normalized. Its frame: .u the angle round
/// the line in radians, .v the signed distance along it from `center` in mm.
axis(center, direction) {
  offset = p - center;
  unitDirection = normalize(direction);
  along = dot(offset, unitDirection);
  perp = offset - unitDirection * along;
  form = length(perp);
  form.u = axisAngle(center, direction);
  form.v = axisDistance(center, direction);
  return form;
}

// THE PRIMITIVES' FRAMES. Each primitive declares .u and .v, the coordinates
// a material reads to know where it sits on the surface: lengths in mm, angles
// in radians, u the coordinate that wraps where one does. A program that reads
// no frame never evaluates them — the declarations are erased before it is
// compiled (property/carry.go) — so they are written in these helpers, never
// as locals of a primitive, which would outlive the erasure.

// The orthonormal pair perpendicular to `direction` that map.axisAt uses (Duff
// et al., "Building an Orthonormal Basis, Revisited"): well conditioned at
// every axis, and right-handed with it, so an angle measured in it runs
// counterclockwise seen from the tip of `direction`. Written out rather than
// called so builtin does not depend on map.
axisBasis(direction) {
  n = normalize(direction);
  sz = sign(n.z);
  s = sz + (1.0 - abs(sz));
  a = -1.0 / (s + n.z);
  b = n.x * n.y * a;
  return [1.0 + s * n.x * n.x * a, s * b, neg(s * n.x)], [b, s + n.y * n.y * a, neg(n.y)];
}

// The angle round the axis through `center` along `direction`, in radians.
// Its value wraps by 2 pi across one half-plane; its gradient does not, so a
// lay read from .u.dp is smooth everywhere off the axis.
axisAngle(center, direction) {
  t1, t2 = axisBasis(direction);
  d = p - center;
  return atan(dot(d, t2), dot(d, t1));
}

// The signed distance along the axis from `center`, in mm.
axisDistance(center, direction) {
  return dot(p - center, normalize(direction));
}

/// Distance to an infinite line through `center` parallel to the X axis.
axisX(center) {
  form = axis(center, vector.dirX);
  form.u = axisAngle(center, vector.dirX);
  form.v = axisDistance(center, vector.dirX);
  return form;
}

/// Distance to an infinite line through `center` parallel to the Y axis.
axisY(center) {
  form = axis(center, vector.dirY);
  form.u = axisAngle(center, vector.dirY);
  form.v = axisDistance(center, vector.dirY);
  return form;
}

/// Distance to an infinite line through `center` parallel to the Z axis.
axisZ(center) {
  form = axis(center, vector.dirZ);
  form.u = axisAngle(center, vector.dirZ);
  form.v = axisDistance(center, vector.dirZ);
  return form;
}

// --- Cylinders ---

/// Infinite cylinder along `direction` through `center`, with given
/// radius. `direction` does not need to be normalized. Its frame: .u the angle
/// round the axis in radians, .v the signed distance along it from `center`
/// in mm.
cylinder(center, direction, radius) {
  form = axis(center, direction) - radius;
  form.u = axisAngle(center, direction);
  form.v = axisDistance(center, direction);
  return form;
}

/// Infinite cylinder along the X axis through `center`, with given
/// radius.
cylinderX(center, radius) {
  form = cylinder(center, vector.dirX, radius);
  form.u = axisAngle(center, vector.dirX);
  form.v = axisDistance(center, vector.dirX);
  return form;
}

/// Infinite cylinder along the Y axis through `center`, with given
/// radius.
cylinderY(center, radius) {
  form = cylinder(center, vector.dirY, radius);
  form.u = axisAngle(center, vector.dirY);
  form.v = axisDistance(center, vector.dirY);
  return form;
}

/// Infinite cylinder along the Z axis through `center`, with given
/// radius.
cylinderZ(center, radius) {
  form = cylinder(center, vector.dirZ, radius);
  form.u = axisAngle(center, vector.dirZ);
  form.v = axisDistance(center, vector.dirZ);
  return form;
}

/// Finite cylinder between pointA and pointB, with flat caps, using `blend`
/// to combine the radial and axial fields — pass `intersectRound(radius)` to fillet
/// the rim, or any other operator taking a list of fields. It must be at least
/// the sharp max of its fields, as boxCentered's blend must: the box is
/// declared to hold it. Its frame: .u the
/// angle round the axis in radians, on the side and the caps alike; .v the
/// signed distance along the axis from the middle on the side, and the
/// distance from the axis on a cap, in mm — so across the rim .u runs on and
/// .v turns from along the axis to across it.
//
// Adapted from Inigo Quilez's capped cylinder; the locals keep his names.
cylinderCapped(pointA, pointB, radius, blend) {
  ba = pointB - pointA;
  pa = p - pointA;
  baba = dot(ba, ba);
  paba = dot(pa, ba);
  t = clamp(paba / baba, 0, 1);
  radialDistance = length(pa - ba * t) - radius;
  axialDistance = (abs(paba - baba * 0.5) - baba * 0.5) / sqrt(baba);
  form = blend([radialDistance, axialDistance]);
  form.box = [min(pointA, pointB) - radius, max(pointA, pointB) + radius];
  form.u = axisAngle(pointA, ba);
  form.v = cappedCylinderV(pointA, pointB, radius);
  return form;
}

/// Finite cylinder between pointA and pointB, with flat caps.
cylinderCapped(pointA, pointB, radius) {
  form = cylinderCapped(pointA, pointB, radius, intersectRound(0));
  form.u = axisAngle(pointA, pointB - pointA);
  form.v = cappedCylinderV(pointA, pointB, radius);
  return form;
}

// A capped cylinder's v: on the side, which binds where the radial distance
// is the larger, the signed distance along the axis from the middle; on a
// cap, the distance from the axis. The same terms as the cylinder, so the
// frame changes face exactly where the distance does.
cappedCylinderV(pointA, pointB, radius) {
  ba = pointB - pointA;
  pa = p - pointA;
  baba = dot(ba, ba);
  paba = dot(pa, ba);
  t = clamp(paba / baba, 0, 1);
  radialDistance = length(pa - ba * t) - radius;
  axialDistance = (abs(paba - baba * 0.5) - baba * 0.5) / sqrt(baba);
  along = (paba - baba * 0.5) / sqrt(baba);
  across = length(pa - ba * (paba / baba));
  return radialDistance >= axialDistance ? along : across;
}

/// Infinitely thin line segment: unsigned distance from p to the segment
/// pointA -> pointB.
/// Subtract a radius to get a capsule (same as cylinderRounded). The building
/// block for beam and foam lattices.
//
// Based on Inigo Quilez formulation.
lineSegment(pointA, pointB) {
  pa = p - pointA;
  ba = pointB - pointA;
  h = clamp(dot(pa, ba) / dot(ba, ba), 0, 1);
  return length(pa - ba * h);
}

/// Capsule between pointA and pointB: cylinder with hemispherical caps of
/// the given radius.
//
// Based on Inigo Quilez formulation.
cylinderRounded(pointA, pointB, radius) {
  pa = p - pointA;
  ba = pointB - pointA;
  h = clamp(dot(pa, ba) / dot(ba, ba), 0, 1);
  return length(pa - ba * h) - radius;
}

/// Torus centered at the origin, lying in the XY plane. `majorRadius` is the
/// ring radius (center to tube center); `minorRadius` is the tube radius. Its
/// frame is a sphere's bent round the ring: .u the azimuth round +Z from +X,
/// and .v the angle round the tube from its top, as a sphere's polar angle is
/// from its pole — 0 on top, pi/2 on the outer equator, pi underneath, -pi/2
/// on the inner equator — both in radians. Unlike a sphere's, .v wraps, along
/// the bottom of the tube.
torus(majorRadius, minorRadius) {
  radial = length(p.xy) - majorRadius;
  form = length([radial, p.z]) - minorRadius;
  form.u = sphereAzimuth([0.0, 0.0, 0.0], vector.dirZ, vector.dirX);
  form.v = torusTubeAngle(majorRadius);
  return form;
}

// A torus's v: the angle round the tube, from its top toward the outside.
torusTubeAngle(majorRadius) {
  return atan(length(p.xy) - majorRadius, p.z);
}

// --- Cones ---

/// Infinite cone with apex at `origin`, opening along `direction`, with
/// given half-angle (in radians). Its frame: .u the angle round the axis in
/// radians, .v the signed distance along it from the apex in mm.
cone(origin, direction, angle) {
  unitDirection = normalize(direction);
  offset = p - origin;
  along = dot(offset, unitDirection);
  perp = length(offset - unitDirection * along);
  // distance is distance from p to the cone surface
  form = perp * cos(angle) - along * sin(angle);
  form.u = axisAngle(origin, direction);
  form.v = axisDistance(origin, direction);
  return form;
}

/// Capped cone between pointA (radius radiusA) and pointB (radius radiusB).
//
// Based on Inigo Quilez formulation.
coneCapped(pointA, pointB, radiusA, radiusB) {
  rba = radiusB - radiusA;
  baba = dot(pointB - pointA, pointB - pointA);
  papa = dot(p - pointA, p - pointA);
  paba = dot(p - pointA, pointB - pointA) / baba;
  x = sqrt(papa - paba * paba * baba);
  cax = max(0, x - ((paba < 0.5) ? radiusA : radiusB));
  cay = abs(paba - 0.5) - 0.5;
  k = rba * rba + baba;
  f = clamp((rba * (x - radiusA) + paba * baba) / k, 0, 1);
  cbx = x - radiusA - f * rba;
  cby = paba - f;
  s = (cbx < 0 && cay < 0) ? -1 : 1;
  return s * sqrt(min(cax * cax + cay * cay * baba,
                      cbx * cbx + cby * cby * baba));
}

/// Rounded cone: sphere at pointA (radius radiusA), sphere at pointB (radius radiusB),
/// blended with a tangent cone — like a tapered capsule.
//
// Based on Inigo Quilez formulation.
coneRounded(pointA, pointB, radiusA, radiusB) {
  ba = pointB - pointA;
  l2 = dot(ba, ba);
  rr = radiusA - radiusB;
  a2 = l2 - rr * rr;
  il2 = 1.0 / l2;
  pa = p - pointA;
  y = dot(pa, ba);
  z = y - l2;
  xp = pa * l2 - ba * y;
  x2 = dot(xp, xp);
  y2 = y * y * l2;
  z2 = z * z * l2;
  k = sign(rr) * rr * rr * x2;
  capA = sqrt(x2 + y2) * il2 - radiusA;
  capB = sqrt(x2 + z2) * il2 - radiusB;
  side = (sqrt(x2 * a2 * il2) + y * rr) * il2 - radiusA;
  cond1 = (sign(z) * a2 * z2 > k);
  cond2 = (sign(y) * a2 * y2 < k);
  return cond1 ? capB : (cond2 ? capA : side);
}

// --- Planes and boxes ---

/// Plane through `point` with `normal`. Returns signed distance:
/// negative on the side the normal points away from. The normal does not need to be
/// normalized. Its frame: .u and .v the signed distances from `point` along
/// two perpendicular directions in the plane, in mm, right-handed with the
/// normal.
plane(point, normal) {
  form = dot(p - point, normalize(normal));
  form.u = planeU(point, normal);
  form.v = planeV(point, normal);
  return form;
}

// A plane's frame: the offset from `point` along each of the pair axisBasis
// takes perpendicular to the normal.
planeU(point, normal) {
  t1, t2 = axisBasis(normal);
  return dot(p - point, t1);
}

planeV(point, normal) {
  t1, t2 = axisBasis(normal);
  return dot(p - point, t2);
}

/// Axis-aligned box centered at `center` (3D point) with given `size`
/// (3D extent), using `blend` to combine the three slab fields — pass
/// `intersectRound(radius)` to round every edge, or any other operator taking a
/// list of fields. It must be at least the sharp max of its fields, so that it
/// only rounds or cuts the box, as every intersect in booleans does: the box
/// is declared to hold it. Its frame, on each face, is the signed distance from the
/// center along the face's two in-plane axes, in mm, taken in turn — (y, z) on
/// the x faces, (z, x) on the y faces, (x, y) on the z faces — so across every
/// edge .u and .v each turn a right angle rather than running on.
boxCentered(center, size, blend) {
  halfSize = size * 0.5;
  d = abs(p - center) - halfSize;
  solid = blend([d.x, d.y, d.z]);
  solid.box = [center - halfSize, center + halfSize];
  solid.u = boxU(center, size);
  solid.v = boxV(center, size);
  return solid;
}

/// Axis-aligned box centered at `center` (3D point) with given `size`
/// (3D extent).
boxCentered(center, size) {
  form = boxCentered(center, size, intersectRound(0));
  form.u = boxU(center, size);
  form.v = boxV(center, size);
  return form;
}

/// Axis-aligned box defined by two opposite corners, using `blend` to
/// combine the three slab fields — pass `intersectRound(radius)` to round every
/// edge, or any other operator taking a list of fields; see boxCentered. Its
/// frame is boxCentered's.
box(pointA, pointB, blend) {
  center = (pointA + pointB) * 0.5;
  size = abs(pointB - pointA);
  form = boxCentered(center, size, blend);
  form.u = boxU(center, size);
  form.v = boxV(center, size);
  return form;
}

/// Axis-aligned box defined by two opposite corners.
box(pointA, pointB) {
  form = box(pointA, pointB, intersectRound(0));
  form.u = boxU((pointA + pointB) * 0.5, abs(pointB - pointA));
  form.v = boxV((pointA + pointB) * 0.5, abs(pointB - pointA));
  return form;
}

// A box's frame: each slab carries the offset from the center along its own
// face's two in-plane axes, cycled so that no axis is u on two faces that
// meet, and the slab that binds — the largest of the three distances, as the
// box is their intersection — gives its frame to the point.
boxU(center, size) {
  q = p - center;
  d = abs(q) - size * 0.5;
  return d.x >= max(d.y, d.z) ? q.y : (d.y >= d.z ? q.z : q.x);
}

boxV(center, size) {
  q = p - center;
  d = abs(q) - size * 0.5;
  return d.x >= max(d.y, d.z) ? q.z : (d.y >= d.z ? q.x : q.y);
}

/// `shape` capped by the box between corners `low` and `high`, grown by boxPad:
/// the closed solid that export meshes. A declaration's name.box = [low, high] applies
/// this. The viewer draws it cut open instead, so where the box crosses the
/// part its inside shows through, the way the scene's bounds cut unbounded
/// geometry.
//
// Internal: the box distance is written out rather than calling box(), whose
// intersectRound(0) is a closure. A declared box is applied after closures are
// specialized, so this body must not need one. The WGSL codegen derives the
// viewer's cut from this return value (agent/wgsl/internal/codegen/box_cut.go),
// so it must stay max(shape, the box's distance).
cropToBox(shape, low, high) {
  lowCorner = min(low, high) - boxPad;
  highCorner = max(low, high) + boxPad;
  d = abs(p - (lowCorner + highCorner) * 0.5) - (highCorner - lowCorner) * 0.5;
  outside = length([max(d.x, 0), max(d.y, 0), max(d.z, 0)]);
  inside = min(max(d.x, max(d.y, d.z)), 0);
  return max(shape, outside + inside);
}

// Internal: a standard library part whose solid lies in the box [low, high]. A
// library's name.box = [low, high] applies this rather than cropToBox: its boxes
// are proven against the parts they bound (agent/fidget/gsleval
// library_box_test.go), so there is nothing to crop, and the declaration is
// only what .box reads. Once the boxes have been read, the assembler replaces
// every call with its shape (property.DropDeclaredBoxes).
declaredBox(shape, low, high) {
  return shape;
}

// Internal: a part of a document, whose surface lies in the box [low, high], and
// its solid too when `solid` is 1. The assembler wraps each part in this
// (property.MarkParts): a named value that only a min or a return reads. The
// viewer shrinks the part to nothing as its box falls under a few pixels on
// screen, so it costs nothing zoomed out, and while it marches it reads a part
// whose solid is in its box as the box itself wherever the ray is not near it;
// the WGSL codegen writes that guard in place of every call
// (agent/wgsl/internal/codegen/vanish.go), and everything else, fidget, the
// mesher and export, keeps the part whole, which is this body.
shrinkToVanish(shape, low, high, solid) {
  return shape;
}

// Internal: a part with a simpler stand-in, its name.simple = proxy, whose
// box is [low, high]. The assembler writes this inside the part's shrinkToVanish
// (property.MarkParts), and the part's colour and material fields write it
// again over the part's and the stand-in's (property.resolveField). The
// viewer draws the stand-in, the shape cropped to the box, once the part
// falls under the Detail slider's Simple rung on screen, blending across the
// octave below it; the WGSL codegen writes that switch in place of every call
// (agent/wgsl/internal/codegen/simple.go). Everything else keeps the part,
// which is this body.
simplified(shape, proxy, low, high) {
  return shape;
}

// Internal: a stand-in carried out of the function that declared it, name.simple
// = carriedSimple(proxy) (property.CarryReturnProperties). MarkParts makes it a
// part's stand-in when the name is a part and drops it otherwise, so nothing
// past MarkParts calls this.
carriedSimple(proxy) {
  return proxy;
}

/// Regular octahedron at the origin, with vertices at (±size, 0, 0),
/// (0, ±size, 0), (0, 0, ±size).
//
// Internal: built by evaluating a single plane with normal [1, 1, 1] at
// abs(p): the plane passes through the averaged center
// [size, size, size] / 3 so that its zero-set matches |x|+|y|+|z| = size.
octahedron(size) {
  center = [size, size, size] / 3;
  return remap(plane(center, [1, 1, 1]), abs(p));
}

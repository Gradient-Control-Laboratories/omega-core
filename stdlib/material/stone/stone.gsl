
// Stone Materials (material/stone)
//
// Marble, granite, and flagstone: color-only presets (no displacement — see
// each function's doc for the manufactured-relief alternative where one
// exists). Marble follows what photographs of real slabs show: veins that
// run along a direction, bend at every scale, taper, gather in zones and
// carry smoky halos, over a clouded, grainy ground (calacatta, statuario,
// carrara, or the directionless marble). Granite is a mosaic of crystals, one
// mineral and one tone per Voronoi cell (Worley's cellular texture). Flagstone
// darkens the joints between cells.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "noise";
import "color";
import "material";
import "texture";

/// stoneFinish(rough): shared non-metallic stone material — roughness
/// `rough`, not metallic, ior 1.55 (typical for polished stone/mineral).
stoneFinish(@range(0, 1) rough) {
  return material.make(rough, 0, 1.55);
}

// Gradient noise at an explicit point rather than at p through remap: the
// marble below samples several noise fields at one warped point, and keeping
// the point an argument lets the compiler evaluate the warp once instead of
// once per octave.
gradientAt(q, size) {
  return noise.gradientLattice(q / size);
}

// Three-octave fractal noise at q (noise.fbm3 at an explicit point).
fbm3At(q, size, gain, lacunarity) {
  return gradientAt(q, size) + gain * gradientAt(q, size / lacunarity) + gain * gain * gradientAt(q, size / (lacunarity * lacunarity));
}

// q moved by gradient noise size across and strength deep (texture.domainWarp
// at an explicit point, with the same decorrelating offsets).
warpAt(q, size, strength) {
  return q + [gradientAt(q, size), gradientAt(q + [37.0, 0.0, 0.0], size), gradientAt(q + [0.0, 59.0, 0.0], size)] * strength;
}

// Veined marble, the model behind marble() and the named stones below. It
// follows what photographs of real slabs show (Calacatta, Statuarietto,
// Carrara), measured for vein cover, width, direction and clustering:
//
//   - Veins are either long sheets (Calacatta, Carrara), where fractal noise
//     stretched along the vein direction crosses zero, or cracks (Statuario):
//     the walls between Voronoi cells, straight runs that meet at angles,
//     only some of them cracked and only those facing across the vein sheet,
//     so they branch and end rather than outlining every cell.
//   - They run along a direction: q is the point in a frame whose z axis is
//     the vein direction, stretched so cells are longer along it.
//   - A vein bends at every scale: large folds, then a fine jagged wander,
//     warp the point before the cells are found.
//   - A vein tapers and fades along its length, and veins gather in zones
//     with clean stone between them.
//   - Beside a vein is a soft smoky band, and cells a third the size give a
//     finer, fainter network between the main veins.
//   - The ground clouds faintly and has the sugary grain of the crystals.
//
// Widths and sizes are mm on the cut face; veinScale is the cell size.
// `sheets` picks the vein kind: 1 for long continuous sheets (Calacatta,
// Carrara), 0 for crack walls (Statuario's crazing). For crack walls,
// crackShare is the share of walls that are veins; `facing` keeps only walls
// whose normal lies within that cosine of the frame's x axis (-1 keeps all).
// `sharpness` sets how crisp
// a vein's edge is (1 crisp, lower softer, for feathery veins). clusterLevel
// sets how much of the stone carries veins (about -0.4 all of it, 0 half, 0.4
// a tenth). Mixed once in Oklab. Returns color.
veinedMarble(q, sheets, foldSize, foldDepth, veinScale, veinWidth, sharpness, crackShare, facing, clusterSize, clusterLevel, haloStrength, fineStrength, groundColor, cloudColor, veinColor, accentColor) {
  folded = warpAt(q, foldSize, foldDepth);
  jagged = warpAt(folded, veinScale * 0.06, veinScale * 0.02);

  // Main veins, as crack walls: f2 - f1 is about twice the distance to the
  // wall, in cells.
  f1, f2, nearCell, farCell = noise.cellularF1F2PairLattice(jagged / veinScale);
  crackWall = (f2 - f1) * veinScale * 0.5;
  // A wall's normal runs from one cell's feature point to the other's. Only
  // walls facing across the sheet (q's x axis) by at least `facing` crack:
  // a wall lying in the cut face would smear into a blotch, not a vein.
  nearFeature = nearCell + noiseHash3(nearCell);
  farFeature = farCell + noiseHash3(farCell);
  wallNormal = normalize(farFeature - nearFeature);
  sheetLike = texture.mask(abs(wallNormal.x), facing, 0.1);
  // Whether the wall cracked comes from smooth noise read at the wall's own
  // midpoint, so neighbouring walls decide alike and cracks chain into long
  // veins instead of breaking into separate strokes; crackShare of the walls
  // crack.
  crackNoise = gradientAt((nearFeature + farFeature) * 0.5 * veinScale + [3, 11, 7], veinScale * 1.5);
  crackGate = sheetLike * texture.mask(crackNoise, (0.5 - crackShare) * 0.6, 0.04);
  // Or as sheets: where fractal noise crosses zero, long and continuous once
  // the frame stretches it along the vein direction; |noise| grows at about
  // 1.4 per veinScale across a surface, so this is the distance in mm.
  // A gentle gain: where the broadest octave's slope flattens, strong finer
  // octaves would take over and kink the vein into a zigzag.
  sheetWall = abs(fbm3At(jagged, veinScale, 0.4, 2.1)) * veinScale / 1.4;
  wall = sheets > 0.5 ? sheetWall : crackWall;
  cracked = sheets > 0.5 ? 1 : crackGate;
  // Width along the vein, from a fifth to about one and a half times
  // veinWidth; the same noise shifts the vein's tint toward the accent.
  along = gradientAt(q + [71, 13, 29], veinScale * 0.7);
  halfWidth = 0.5 * veinWidth * (0.2 + 1.3 * texture.mask(along, -0.1, 0.5));
  zone = texture.mask(gradientAt(q + [5, 101, 37], clusterSize), clusterLevel, 0.06);
  vein = zone * cracked * (1 - texture.mask(wall, halfWidth, max(halfWidth / sharpness, pixelSize())));
  // Kept close to the wall, where the pair of cells either side is still
  // the pair that names it, so the band never ends at a hard edge.
  halo = haloStrength * zone * cracked * (1 - texture.mask(wall, 2.5 * halfWidth, 1.5 * halfWidth));

  // The finer network: cells a third the size, half their walls cracked,
  // facing the same way a little more loosely, and strongest in the zones.
  g1, g2, nearFine, farFine = noise.cellularF1F2PairLattice((jagged + [31, 17, 5]) / (veinScale / 3));
  fineWall = (g2 - g1) * veinScale / 6;
  fineNormal = normalize(farFine + noiseHash3(farFine) - nearFine - noiseHash3(nearFine));
  fineCracked = (0.3 + 0.7 * zone) * texture.mask(abs(fineNormal.x), facing * 0.7, 0.1) * (noiseHash3(nearFine + farFine + [5, 2, 13]).x < 0.5 ? 1 : 0);
  fineHalf = 0.3 * halfWidth;
  fine = fineStrength * fineCracked * (1 - texture.mask(fineWall, fineHalf, max(fineHalf / sharpness, pixelSize())));

  cloud = texture.mask(gradientAt(folded + [19, 3, 47], veinScale * 1.5) + 0.5 * gradientAt(folded + [19, 3, 47], veinScale * 0.75), 0.15, 0.35);
  grain = (noiseHash3(floor(p / 0.35) + [9, 0, 0]).x - 0.5) * 0.025 * texture.fadeDetail(0.35);

  groundLab = color.rgb2oklab(groundColor);
  ground = groundLab + (color.rgb2oklab(cloudColor) - groundLab) * clamp(0.5 * cloud + halo, 0, 1) + [grain, 0, 0];
  veinLab = color.rgb2oklab(veinColor);
  tinted = veinLab + (color.rgb2oklab(accentColor) - veinLab) * texture.mask(along, 0.3, 0.25);
  return color.oklab2rgb(ground + (tinted - ground) * max(vein, 0.7 * fine));
}

// The frame veined marble is read in: veins are sheets that contain
// `direction` and the vertical (or, for a vertical direction, x), so on a
// flat slab they cut the face as crisp traces along `direction` instead of
// smearing where a sheet would lie nearly in the face. Cells are stretched
// `stretch` times along both axes of the sheet.
marbleFrame(direction, stretch) {
  along = normalize(direction);
  up = abs(along.z) > 0.9 ? [1, 0, 0] : [0, 0, 1];
  across = normalize(cross(along, up));
  sheet = cross(across, along);
  return [dot(p, across), dot(p, sheet) / stretch, dot(p, along) / stretch];
}

/// marble(scale, veinScale, veinThickness, warpStrength, baseColor,
/// veinColor): veined marble with no preferred direction. Folds `scale`
/// across and `warpStrength` mm deep bend veins that sit `veinScale` apart and
/// are about `veinThickness` mm wide, tapering and fading along their length,
/// with a finer network between them, gathered in zones over a faintly
/// clouded, grainy baseColor ground. See calacatta, statuario and carrara for
/// real stones, with a vein direction. Color only.
marble(scale, veinScale, veinThickness, warpStrength, @color baseColor, @color veinColor) {
  // Stand-in: the ground takes 16.3% of its cloud colour on average and the
  // veins cover 1 - exp(-1.9 veinThickness / veinScale) of it (sampled).
  groundLab = color.rgb2oklab(baseColor);
  meanGround = groundLab + (color.rgb2oklab(baseColor * 0.9) - groundLab) * 0.163;
  veined = veinedMarble(p, 0, scale, warpStrength, veinScale, veinThickness, 0.8, 0.45, -1, veinScale * 3, -0.2, 0.25, 0.5, baseColor, baseColor * 0.9, veinColor, veinColor);
  veined.simple = color.oklab2rgb(meanGround + (color.rgb2oklab(veinColor) - meanGround) * (1 - exp(-1.9 * veinThickness / veinScale)));
  return veined;
}

/// calacatta(direction): Calacatta marble: warm white with sparse, long grey
/// veins 2 to 14 mm wide running along `direction`, gold where they thin, with
/// soft smoky bands beside them, gathered in zones about 300 mm across with
/// clean stone between (about two thirds of the stone carries veins). Sized for slabs a
/// metre or more across. Color only; pair it with physical.marble.
calacatta(@direction direction) {
  // The stand-in is its mean in Oklab, sampled.
  slab = veinedMarble(marbleFrame(direction, 4), 1, 400, 35, 220, 9, 0.7, 0.6, 0.6, 300, -0.2, 0.7, 0.15, [0.94, 0.93, 0.91], [0.84, 0.83, 0.81], [0.45, 0.45, 0.46], [0.70, 0.58, 0.40]);
  slab.simple = color.oklab2rgb([0.9265, 0.0007, 0.0069]);
  return slab;
}

/// statuario(direction): Statuario-type marble (after Statuarietto tiles):
/// bright cool white crazed by a dense network of thin, sharp, jagged dark
/// grey veins, 0.3 to 1.5 mm wide, some thickening into seams, loosely
/// following `direction`, with a finer network between them. Sized for tiles
/// and slabs from 300 mm up. Color only; pair it with physical.marble.
statuario(@direction direction) {
  // The stand-in is its mean in Oklab, sampled.
  slab = veinedMarble(marbleFrame(direction, 1.5), 0, 150, 25, 45, 0.9, 1, 0.45, 0.5, 200, -0.3, 0.12, 0.8, [0.93, 0.93, 0.94], [0.86, 0.87, 0.89], [0.22, 0.23, 0.25], [0.35, 0.36, 0.38]);
  slab.simple = color.oklab2rgb([0.9207, 0.0006, -0.0041]);
  return slab;
}

/// carrara(direction): Carrara marble: grey-white with soft, feathery grey
/// veins and smudges drawn out along `direction`, low in contrast, over the
/// stone's fine sugary grain. Color only; pair it with physical.marble.
carrara(@direction direction) {
  // The stand-in is its mean in Oklab, sampled.
  slab = veinedMarble(marbleFrame(direction, 3), 1, 200, 40, 90, 6, 0.5, 0.5, 0.6, 300, -0.3, 1, 0.5, [0.89, 0.90, 0.91], [0.78, 0.79, 0.81], [0.58, 0.60, 0.63], [0.54, 0.56, 0.60]);
  slab.simple = color.oklab2rgb([0.863, -0.0015, -0.0063]);
  return slab;
}

/// granite(cellSize, baseColor, fleckColorA, fleckColorB): a mosaic of
/// interlocking crystals about cellSize mm across (noise.cellularCell), each
/// one mineral with one tone: about 55% feldspar (baseColor), 30% quartz
/// (fleckColorB, greyed toward smoky glass) and 15% dark mica and hornblende
/// (fleckColorA), every crystal shifted lighter or darker by its own hash, with
/// thin dark seams where crystals meet. The quartz reads as translucent: each
/// grain is darker and cooler toward its core than at its rim, as a glassy
/// crystal looks when you see into it, with a few tiny dark inclusions. Color
/// only; pair it with graniteFinish for glassier quartz and shinier mica.
granite(cellSize, @color baseColor, @color fleckColorA, @color fleckColorB) {
  f1, f2, cell = noise.cellularCell(cellSize);
  pick = noiseHash3(cell + [101, 0, 0]);
  tone = (pick.y - 0.5) * 0.14;
  // Chosen and shaded in Oklab, where lightening is adding to L, and converted
  // back once (see marble).
  feldspar = color.rgb2oklab(baseColor) + [tone, 0, 0];
  quartzLab = color.rgb2oklab(fleckColorB);
  // Translucent quartz: depth toward the core (f1 is the distance to the
  // grain's own centre), a cool shift, and sparse fine inclusions.
  core = 1 - texture.mask(f1 / cellSize, 0.35, 0.25);
  inclusion = (noiseHash3(floor(p / (0.06 * cellSize)) + [313, 0, 0]).x > 0.96 ? 1 : 0) * texture.fadeDetail(0.06 * cellSize);
  quartz = quartzLab + (color.rgb2oklab([0.42, 0.42, 0.44]) - quartzLab) * 0.45 + [tone * 0.5 - 0.12 * core - 0.15 * inclusion, -0.004 * core, -0.012 * core];
  dark = color.rgb2oklab(fleckColorA) + [tone * 0.4, 0, 0];
  crystal = pick.x > 0.85 ? dark : (pick.x > 0.55 ? quartz : feldspar);
  // Too small to resolve, the crystals fade to the mosaic's average color and
  // the seams (a tenth of a crystal) fade out first. The average is the
  // mosaic's mean in Oklab: the three minerals in their shares, the quartz
  // greyed and shaded as above, its core 0.208 deep on average and 4% of it
  // inclusions, less the seams, which cover 0.18 of it; the tones average out.
  // Those two shares are the mosaic's, sampled (libflattest checks the mean).
  quartzMean = quartzLab + (color.rgb2oklab([0.42, 0.42, 0.44]) - quartzLab) * 0.45 + [-0.12 * 0.208 - 0.15 * 0.04, -0.004 * 0.208, -0.012 * 0.208];
  average = color.rgb2oklab(baseColor) * 0.55 + quartzMean * 0.3 + color.rgb2oklab(fleckColorA) * 0.15 - [0.14 * 0.18, 0, 0];
  resolved = average + (crystal - average) * texture.fadeDetail(0.65 * cellSize);
  seam = (1 - texture.mask(f2 - f1, 0.05 * cellSize, 0.03 * cellSize)) * texture.fadeDetail(0.1 * cellSize);
  // Fine detail (name.detail): the mosaic is only searched where it shows,
  // and has faded to its average by then.
  crystals = color.oklab2rgb(average);
  crystals.detail = color.oklab2rgb(resolved - [0.14 * seam, 0, 0]);
  crystals.detailSize = 0.65 * cellSize;
  crystals.simple = color.oklab2rgb(average);
  return crystals;
}

/// graniteFinish(cellSize, rough): the material to go with granite(cellSize,
/// ...): the polished stone finish at roughness `rough` on the feldspar, with
/// each quartz crystal glassier (a third of the roughness) and each mica flake
/// shinier (half of it), crystal by crystal from the same mosaic.
graniteFinish(cellSize, @range(0, 1) rough) {
  f1, f2, cell = noise.cellularCell(cellSize);
  pick = noiseHash3(cell + [101, 0, 0]);
  finish = stoneFinish(pick.x > 0.85 ? rough * 0.5 : (pick.x > 0.55 ? rough * 0.33 : rough));
  // Stand-in: feldspar, quartz and the dark minerals in their shares, 0.55,
  // 0.3 and 0.15.
  finish.simple = stoneFinish(rough * 0.724);
  return finish;
}

/// graniteFacetFinish(cellSize, rough, tilt, gleam): graniteFinish for a
/// granite whose quartz throws light back: each quartz crystal is a small
/// mirror tilted its own way (render-only displacement, rising `tilt` mm per
/// mm across the crystal), as a cleavage plane just under the polish catches
/// the light, so the chunks glint one by one as the view moves; the quartz is
/// glassy (a fifth of `rough`) with a reflection strengthened by `gleam` (0 to
/// 1, the metallic weight standing in for light reflected back from inside
/// the crystal). Feldspar and mica as in graniteFinish.
graniteFacetFinish(cellSize, @range(0, 1) rough, tilt, @range(0, 1) gleam) {
  f1, f2, cell = noise.cellularCell(cellSize);
  pick = noiseHash3(cell + [101, 0, 0]);
  quartz = pick.x > 0.55 ? (pick.x > 0.85 ? 0 : 1) : 0;
  facet = (noiseHash3(cell + [17, 53, 0]) - 0.5) * 2;
  lean = dot(p - (cell + noiseHash3(cell)) * cellSize, facet) * tilt;
  base = stoneFinish(pick.x > 0.85 ? rough * 0.5 : rough);
  // Too small to resolve, the facets fade flat and their tilts, 0.816 tilt
  // root mean square in the surface, widen the quartz's lobe instead.
  glassy = sqrt(texture.reliefRoughness(rough * rough * 0.04, 0.816 * tilt, cellSize));
  facets = material.withDisplacement(material.blend(base, material.make(glassy, gleam, 1.55), quartz), quartz * lean * texture.fadeDetail(cellSize));
  // Stand-in: the minerals in their shares, 0.55, 0.3 and 0.15, the quartz's
  // facets too small to see, their tilts in its lobe.
  facets.simple = material.make(rough * 0.625 + 0.3 * sqrt(sqrt(0.0016 * rough * rough * rough * rough + 0.666 * tilt * tilt)), gleam * 0.3, 1.55);
  return facets;
}

/// flagstone(cellSize, baseColor, jointColor): cellularEdges-driven joint
/// darkening between flagstone/cobblestone slabs — color only, the joints
/// are a paint job, not relief. For MANUFACTURED joint relief (visible to
/// the mesher, not just the renderer), subtract the same field directly from
/// your slab's geometry instead, e.g.
/// `slab - jointDepth * noise.cellularEdges(cellSize)` — that is the
/// caller's own Lipschitz responsibility, the same as any other direct SDF
/// noise subtraction (Displacement.gsl's pebble example does this
/// uncertified today; a fresh certify pass is only worth it for aggressive
/// depths).
flagstone(cellSize, @color baseColor, @color jointColor) {
  joints = noise.cellularEdges(cellSize) / cellSize;
  paving = texture.paint(joints, 0.08, 0.05, jointColor, baseColor);
  // Stand-in: the joints cover 28.9% of it (sampled).
  paving.simple = color.mixOklab(baseColor, jointColor, 0.289);
  return paving;
}

// ===========================================================================
// Ready-made
// ===========================================================================

// One surface from each constructor above, with the arguments the examples
// use, so the material browser can show it. The constructors stay the way to
// set the parameters; see doc/material_composition.md for the plan to adjust
// them from the browser.

/// Grey granite: 4 mm grains of grey, black and white, matte polished.
/// Returns material and colour.
@material greyGranite() {
  return stoneFinish(0.6), granite(4, color.gray, color.black, color.white);
}

/// White marble with grey veins 25 mm across, honed. Returns material and
/// colour.
@material whiteMarble() {
  return stoneFinish(0.15), marble(25, 10, 0.4, 10, color.white, color.gray);
}

/// Carrara marble, veins along +Z, honed. Returns material and colour.
@material carrara() {
  return stoneFinish(0.15), carrara([0, 0, 1]);
}

/// Statuario marble, veins along +Z, honed. Returns material and colour.
@material statuario() {
  return stoneFinish(0.15), statuario([0, 0, 1]);
}

/// Calacatta marble, veins along +Z, honed. Returns material and colour.
@material calacatta() {
  return stoneFinish(0.15), calacatta([0, 0, 1]);
}

/// Grey granite whose quartz glints, 4 mm grains, polished. Returns material
/// and colour.
@material glintingGranite() {
  return graniteFacetFinish(4, 0.12, 0.05, 0.35), granite(4, color.gray, color.black, color.white);
}

/// Flagstone paving, 250 mm warm grey slabs with dark joints. Returns
/// material and colour.
@material flagstone() {
  return stoneFinish(0.8), flagstone(250, [0.45, 0.42, 0.38], [0.2, 0.19, 0.18]);
}

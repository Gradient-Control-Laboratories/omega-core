
// Playful Materials (material/playful)
//
// Confetti, dots, checkerboards, glitter, a spatial rainbow sweep, and a
// scutoid-inspired organic "skin" pattern. Color/material fun built on the
// same noise + texture.paint/paintMaterial idioms as the rest of the
// family.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "noise";
import "map";
import "color";
import "material";
import "texture";

/// checkerboard(cellSize, colorA, colorB): a sharp 3D checkerboard, colorA on
/// the cells of map.checker's even parity. Each axis's squares are averaged
/// over the pixel (texture.squareWave) and the three combined as the chance
/// their parity is odd, so the edges blur by what a pixel sees and a board
/// too fine to resolve settles to the two colours' even mix.
checkerboard(cellSize, @color colorA, @color colorB) {
  x = texture.squareWave(p.x, 2 * cellSize);
  y = texture.squareWave(p.y, 2 * cellSize);
  z = texture.squareWave(p.z, 2 * cellSize);
  xy = x + y - 2 * x * y;
  odd = xy + z - 2 * xy * z;
  board = color.mixOklab(colorA, colorB, odd);
  // Half the cells are each colour, so seen too small to resolve, it is
  // their even mix.
  board.simple = color.mixOklab(colorA, colorB, 0.5);
  return board;
}

// The share of the honeycomb the dots cover: each owns 3 sqrt(3) / 4
// spacing^2 and covers pi r^2 of it.
polkaShare(spacing, dotRadius) {
  return min(3.14159265 * dotRadius * dotRadius / (1.299038 * spacing * spacing), 1);
}

/// polkaDot(spacing, dotRadius, baseColor, dotColor): a hexagonally-packed
/// dot pattern — map.patternHexagonalXY gives the offset to the nearest dot
/// center, and texture.coverageDisc draws the dot there, a pixel soft at its
/// edge. Dots too small or too close to resolve settle to their share of the
/// honeycomb, pi r^2 over 3 sqrt(3) / 4 spacing^2.
polkaDot(spacing, dotRadius, @color baseColor, @color dotColor) {
  cellP = map.patternHexagonalXY(spacing);
  disc = texture.coverageDisc(length(cellP.xy), dotRadius);
  share = polkaShare(spacing, dotRadius);
  dots = color.mixOklab(baseColor, dotColor, texture.fadeTo(disc, share, spacing));
  dots.simple = color.mixOklab(baseColor, dotColor, share);
  return dots;
}

/// confetti(cellSize, paletteFn): a scattered per-region color sweep —
/// combines noise.cellular and noise.gradient at the same p into a pseudo-id
/// fed through paletteFn (e.g. color.cyclicRainbow). An honest
/// approximation, not a true per-cell constant (the per-cell hash itself
/// isn't public) — the id drifts smoothly within a region rather than
/// jumping cleanly at cell walls, which reads as confetti-scatter rather
/// than flat-per-cell color, and is arguably the more festive result anyway.
confetti(cellSize, paletteFn) {
  regionId = fract(noise.cellular(cellSize) * 3.7 + noise.gradient(cellSize) * 1.3 + 0.5);
  // Taken into a local first: a property's value is not searched for calls
  // that pass a function, so paletteMean would not be specialized there.
  mean = paletteMean(paletteFn);
  scatter = paletteFn(regionId);
  scatter.simple = mean;
  return scatter;
}

// The average colour of a palette over [0, 1), taken in Oklab from eight
// evenly spaced samples, for the stand-in of a pattern that sweeps it evenly.
paletteMean(paletteFn) {
  sum = color.rgb2oklab(paletteFn(0.0625)) + color.rgb2oklab(paletteFn(0.1875))
      + color.rgb2oklab(paletteFn(0.3125)) + color.rgb2oklab(paletteFn(0.4375))
      + color.rgb2oklab(paletteFn(0.5625)) + color.rgb2oklab(paletteFn(0.6875))
      + color.rgb2oklab(paletteFn(0.8125)) + color.rgb2oklab(paletteFn(0.9375));
  return color.oklab2rgb(sum / 8);
}

/// glitter(baseMaterial, baseColor, flakeCellSize, flakeColor, density):
/// sparse bright metallic flecks, one candidate per Voronoi cell — uses
/// cellularF1F2's F1 channel (distance to the nearest feature point, NOT
/// F2-F1 edges) tightly thresholded near 0, since F1 alone is the right
/// primitive for "a bright dot per cell" (edges is for cracks/joints
/// between cells, not points within them). `density` is the flake radius as
/// a fraction of flakeCellSize, so the look holds at any cell size. Returns
/// material, color.
glitter(baseMaterial, @color baseColor, flakeCellSize, @color flakeColor, @range(0, 1) density) {
  f1, f2 = noise.cellularF1F2(flakeCellSize);
  flakes = glitterFlakes(f1, flakeCellSize, density);
  flakeMaterial = material.withRoughness(material.withMetallic(baseMaterial, 1), 0.08);
  share = glitterShare(density);
  mat = material.blend(baseMaterial, flakeMaterial, flakes);
  col = color.mixOklab(baseColor, flakeColor, flakes);
  mat.simple = material.blend(baseMaterial, flakeMaterial, share);
  col.simple = color.mixOklab(baseColor, flakeColor, share);
  return mat, col;
}

// The share of the surface flakes `density` of a cell across cover, 1 -
// exp(-4/3 pi density^3): the share of a slice through balls one to a cell.
glitterShare(density) {
  return 1 - exp(-4.18879 * density * density * density);
}

// How much of a point is flake, 0 to 1, a distance f1 from the nearest flake's
// centre: a disc `density` of a cell across (texture.coverageDisc), settling
// to the share of the surface flakes cover once they are too small to resolve,
// 1 - exp(-4/3 pi density^3), the share of a slice through balls one to a cell.
glitterFlakes(f1, flakeCellSize, density) {
  return texture.fadeTo(texture.coverageDisc(f1, density * flakeCellSize), glitterShare(density), flakeCellSize);
}

/// rainbowSheen(scale, cmapFn): a rainbow swept along Z, one period every
/// `scale` — explicitly "rainbow-in-space," not true angle-dependent
/// iridescence: material/color fields see only p and time, never a normal
/// or view direction, so real iridescence isn't achievable here.
rainbowSheen(scale, cmapFn) {
  t = fract(p.z / scale);
  mean = paletteMean(cmapFn);
  sheen = cmapFn(t);
  sheen.simple = mean;
  return sheen;
}

/// cellSkin(size, zBandSize, colorA, colorB): colors
/// noise.cellularEdgesZBlend — an organic "dragon scale / epithelial
/// tissue" surface pattern whose cell-wall topology visibly reorganizes
/// through depth, evoking (not reproducing — see noise.gsl's doc comment on
/// cellularEdgesZBlend) the topology-changing mechanism behind real
/// scutoids.
cellSkin(size, zBandSize, @color colorA, @color colorB) {
  edges = noise.cellularEdgesZBlend(size, zBandSize);
  // The walls, colorA, as lines a fifth of a cell wide, settling to the 22.8%
  // of the skin they cover, measured, once the cells are too small to resolve.
  wall = texture.fadeTo(texture.coverageLine(edges, 0.2 * size), 0.228, size);
  skin = color.mixOklab(colorB, colorA, wall);
  skin.simple = color.mixOklab(colorB, colorA, 0.228);
  return skin;
}

/// glitterTwinkle(baseMaterial, baseColor, flakeCellSize, flakeColor, density,
/// sparkle): glitter whose flakes glint as they would under a moving light.
/// Each flake of glitter() is a tiny mirror at an angle of its own, and it
/// glints only while the half-way vector between the light and the eye lies
/// within a few degrees of its normal, the discrete microfacet picture of
/// glints (Jakob et al. 2014). A colour field sees neither the light nor the
/// eye, so a half-way vector of its own turns slowly through every direction
/// in time instead: flakes facing alike flash together and the share of them
/// alight at once is the real one, about 0.5% for a 8 degree glint. Each
/// glint is emitted at `sparkle` times white paper. Returns material, color.
glitterTwinkle(baseMaterial, @color baseColor, flakeCellSize, @color flakeColor, @range(0, 1) density, sparkle) {
  f1, f2, cell = noise.cellularCell(flakeCellSize);
  flake = glitterFlakes(f1, flakeCellSize, density);
  facing = normalize(noiseHash3(cell + [17, 5, 3]) * 2 - 1);
  halfway = normalize([sin(0.7 * time), cos(0.49 * time), sin(0.91 * time + 1)]);
  // A glint averages 1/402 over every way a flake can face, which is what the
  // flakes under a pixel too coarse to single them out add up to.
  glint = texture.fadeTo(pow(max(dot(facing, halfway), 0), 200), 1 / 402, flakeCellSize) * flake;
  flakeMaterial = material.withRoughness(material.withMetallic(baseMaterial, 1), 0.08);
  share = glitterShare(density);
  mat = material.withEmissive(material.blend(baseMaterial, flakeMaterial, flake), flakeColor, sparkle * glint);
  col = color.mixOklab(baseColor, flakeColor, flake);
  mat.simple = material.withEmissive(material.blend(baseMaterial, flakeMaterial, share), flakeColor, sparkle * share / 402);
  col.simple = color.mixOklab(baseColor, flakeColor, share);
  return mat, col;
}

/// rainbowCycle(scale, period, cmapFn): rainbowSheen that runs along Z, one
/// band every `scale`, moving up one band every `period` seconds.
rainbowCycle(scale, period, cmapFn) {
  mean = paletteMean(cmapFn);
  bands = cmapFn(fract(p.z / scale - time / period));
  bands.simple = mean;
  return bands;
}

/// polkaDotDrift(spacing, dotRadius, baseColor, dotColor, velocity): polkaDot
/// carried along at `velocity`, in world units per second.
polkaDotDrift(spacing, dotRadius, @color baseColor, @color dotColor, velocity) {
  dots = remap(polkaDot(spacing, dotRadius, baseColor, dotColor), p - velocity * time);
  dots.simple = color.mixOklab(baseColor, dotColor, polkaShare(spacing, dotRadius));
  return dots;
}

// ===========================================================================
// Ready-made
// ===========================================================================

// One surface from each constructor above, with the arguments the examples
// use, so the material browser can show it. The constructors stay the way to
// set the parameters; see doc/material_composition.md for the plan to adjust
// them from the browser.

/// A black and white checkerboard of 10 mm squares, matte. Returns material
/// and colour.
@material blackWhiteChecker() {
  return material.matte, checkerboard(10, color.white, color.black);
}

/// White polka dots 4 mm across every 8 mm on blue plastic. Returns material
/// and colour.
@material bluePolkaDot() {
  return material.plastic, polkaDot(8, 2, [0.25, 0.55, 0.75], color.white);
}

/// Teal cell walls on white, 5 mm cells, matte. Returns material and colour.
@material tealCellSkin() {
  return material.matte, cellSkin(5, 2.5, color.teal, color.white);
}

/// White polka dots 4 mm across every 8 mm on blue plastic, drifting 2 mm/s
/// along +X. Returns material and colour.
@material polkaDotDrift() {
  return material.plastic, polkaDotDrift(8, 2, [0.25, 0.55, 0.75], color.white, [2, 0, 0]);
}

// One @surface overload per operator above, for the Bodies panel to wrap a
// surface with: the slots a document supplies (the part's surface and its
// colour) and the arguments the examples use for the rest. Adjust opens one
// back into the full form; see doc/material_composition.md, "Design:
// operators as presets".

/// glitter(baseMaterial, baseColor): white flakes in 1 mm cells, a quarter
/// of a cell across. Returns material and colour.
@surface glitter(baseMaterial, @color baseColor) {
  m, c = glitter(baseMaterial, baseColor, 1.0, color.white, 0.25);
  return m, c;
}

/// glitterTwinkle(baseMaterial, baseColor): the same flakes, each glint 8
/// times white paper. Returns material and colour.
@surface glitterTwinkle(baseMaterial, @color baseColor) {
  m, c = glitterTwinkle(baseMaterial, baseColor, 1.0, color.white, 0.25, 8);
  return m, c;
}

// References
//   Jakob, W., Hasan, M., Yan, L.-Q., Lawrence, J., Ramamoorthi, R., Marschner,
//     S. (2014). Discrete stochastic microfacet models. ACM Transactions on
//     Graphics, 33(4).

speciesColor(number, @point axisOrigin, @direction(axisOrigin) axisDir, look) {
  return speciesColor(number, axisOrigin, axisDir, look, -1, -1);
}

// The same with the knots' whorl spacing in mm, -1 for the species' own, and
// the stem's radius to the bark in mm, 0 or less for no sapwood: the sapwood

  stand = woodStandIn(finishedColor(early.xyz, aging, earlyChar, stainGain, earlyTaken, wetting, tint), finishedColor(late.xyz, aging, lateChar, stainGain, taken * uptake.y, wetting, tint), rings.y, look.z);

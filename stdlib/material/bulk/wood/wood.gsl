/// diffuse-porous, rings barely there, and faint greenish heartwood streaks.
/// The colour is The Wood Database's; the structure and aging are judged.
poplar(@point axisOrigin, @direction(axisOrigin) axisDir, look) {
  return species(poplarNumber, axisOrigin, axisDir, look);
}

/// poplar(axisOrigin, axisDir, look, mineral): poplar with `mineral` of the
/// mineral stain it takes up from the soil, 0 to 1: 0 is plain poplar, 0.5
/// darkPoplar, the olive-cream heartwood streaked purple-grey, and 1 the
/// heaviest, greenish grey with purple-black streaks. Returns material, color.
poplar(@point axisOrigin, @direction(axisOrigin) axisDir, look, mineral) {
  return speciesMaterial(poplarNumber, axisOrigin, axisDir, look, -1), poplarColor(axisOrigin, axisDir, look, mineral);
}

// Row i of poplar with `mineral` of stain: plain poplar's rows blended toward
// darkPoplar's up to 0.5, then toward mineralPoplarData's.
mineralRow(i, mineral) {
  t = clamp(2 * mineral, 0, 2);
  return t < 1 ? poplarData[i] + (darkPoplarData[i] - poplarData[i]) * t : darkPoplarData[i] + (mineralPoplarData[i] - darkPoplarData[i]) * (t - 1);
}

/// poplarColor(axisOrigin, axisDir, look, mineral): the colour alone of poplar
/// with `mineral` of stain; see poplar. Use it, with
/// speciesMaterial(poplarNumber, ...), where the mineral or the look varies
/// from point to point.
poplarColor(@point axisOrigin, @direction(axisOrigin) axisDir, look, mineral) {
  return colorFromRows(mineralRow(0, mineral), mineralRow(1, mineral), mineralRow(2, mineral), mineralRow(3, mineral), mineralRow(4, mineral), mineralRow(5, mineral), mineralRow(6, mineral), mineralRow(7, mineral), mineralRow(8, mineral), mineralRow(9, mineral), mineralRow(10, mineral), mineralRow(11, mineral), axisOrigin, axisDir, look, -1, speciesKnotStyle(poplarNumber), -1);
}

/// poplarColor(axisOrigin, axisDir, look, mineral, normal, prep, stain,
/// topcoat): the same finished; see Finishes.
poplarColor(@point axisOrigin, @direction(axisOrigin) axisDir, look, mineral, normal, prep, stain, topcoat) {
  return colorFromRowsFinished(mineralRow(0, mineral), mineralRow(1, mineral), mineralRow(2, mineral), mineralRow(3, mineral), mineralRow(4, mineral), mineralRow(5, mineral), mineralRow(6, mineral), mineralRow(7, mineral), mineralRow(8, mineral), mineralRow(9, mineral), mineralRow(10, mineral), mineralRow(11, mineral), speciesStainRow(poplarNumber), axisOrigin, axisDir, look, -1, speciesKnotStyle(poplarNumber), -1, normal, prep, stain, topcoat);
}
poplar(@point axisOrigin, @direction(axisOrigin) axisDir) {
  return poplar(axisOrigin, axisDir, defaultLook);
}


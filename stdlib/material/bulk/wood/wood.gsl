  aged = clamp(look.y, 0, 1);
  aging = ([1, 1, 1] + (weeks.xyz - [1, 1, 1]) * (1 - pow(1 - aged, 37))) * ([1, 1, 1] + (age.xyz - [1, 1, 1]) * aged);
  // The weeks stage is the heartwood's extractives reacting; sapwood, which
  // has none, takes only the slow change light makes.
  sapAging = [1, 1, 1] + (age.xyz - [1, 1, 1]) * aged;

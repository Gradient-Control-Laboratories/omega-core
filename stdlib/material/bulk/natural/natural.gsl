/// Animated water and lava, fog, clouds, sand and terrain.


// Natural Materials (material/bulk/natural)
//
// Water, lava, fog, and clouds — the animated set, built on gradient4/
// gradientBump4 (time as a genuine 4th lattice axis, so ripples/flow/puffs
// actually morph rather than slide). Fog and clouds are honest surface
// approximations of volumetric phenomena draped over a caller-supplied shape
// — this renderer has no true volumetric path, only surface hits plus a
// second "glass" march for transmissive material. Fog is transmissive and
// flat; a cloud is opaque, because a rough transmissive surface that is also
// displaced and animated marches four refracted rays through the displaced
// field at every pixel and hangs the GPU, for a blur of what lies behind
// that no cloud shows. Terrain paints a continent-and-ocean map with
// mountain chains onto any shape.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "noise";
import "color";
import "material";
import "material/bulk/glass";
import "material/bulk/physical";
import "texture";
import "material/bulk/stone";

/// water(rippleScale, rippleTimeScale, rippleAmount): glass.water with an
/// animated ripple, via a SINGLE noise.gradientBump4 tap. Water is
/// transmissive, so it is already marched twice (the primary
/// gradient-corrected march plus the secondary refraction march) — keep the
/// ripple to one tap, not a multi-octave stack, or the double-march cost
/// compounds. For water that moves by its own physics, with waves that run
/// at the speed their length gives them, see animated.ocean. rippleScale is
/// the ripples' size and rippleAmount their height, both in mm. Returns
/// material, color.
water(@range(1, 50) rippleScale, rippleTimeScale, @range(0.02, 1) rippleAmount) {
  still, tint = glass.water();
  // Too small to resolve, the ripples fade flat and their slopes, 0.06
  // rippleAmount root mean square (measured), widen the lobe instead.
  height = rippleAmount * noise.gradientBump4(rippleScale, rippleTimeScale) * texture.fadeDetail(rippleScale);
  calm = material.roughness(still);
  mat = material.withDisplacement(material.withRoughness(still, sqrt(texture.reliefRoughness(calm * calm, 0.06 * rippleAmount, rippleScale))), height);
  // Stand-in: the ripples too small to see, their slopes in the lobe.
  mat.simple = material.withRoughness(still, sqrt(sqrt(calm * calm * calm * calm + 0.0036 * rippleAmount * rippleAmount)));
  return mat, tint;
}

/// lava(crackScale, crustColor, glowColor, glowStrength, flowTimeScale): a
/// dark rocky crust in plates about `crackScale` mm across (noise.cellularWalls
/// crack network) with glowing molten cracks (material.glowing) — primarily a
/// material/color effect, no
/// geometric relief by design. glowStrength is modulated by a slow
/// noise.gradient4 time-morph so the glow seems to pulse and flow along the
/// crack network. For a lava lake whose plates drift and tear open, with
/// seams that glow by a Planck fit, see animated.lavaLake. Returns material,
/// color.
lava(@range(2, 60) crackScale, @color crustColor, @color glowColor, glowStrength, flowTimeScale) {
  cracks = noise.cellularWalls(crackScale);
  flow = noise.gradient4(crackScale * 2.0, flowTimeScale) * 0.5 + 0.5;
  crustMat = material.make(0.9, 0, 1.5);
  glowMat = material.glowing(glowColor, glowStrength * flow);
  // The cracks as lines 0.06 of a cell wide, keeping their share of a pixel.
  // cracks is the exact distance to the wall, so every crack is that wide.
  crack = texture.coverageLine(cracks, crackScale * 0.06);
  mat = material.blend(crustMat, glowMat, crack);
  col = color.mixOklab(crustColor, glowColor, crack);
  mat.simple = lavaStandMaterial(glowColor, glowStrength);
  col.simple = lavaStandColor(crustColor, glowColor);
  return mat, col;
}

// lava's stand-ins: its cracks cover 16.3% of the crust (measured over 60000
// random points), glowing at half their strength on average.
lavaStandMaterial(glowColor, glowStrength) {
  return material.blend(material.make(0.9, 0, 1.5), material.glowing(glowColor, 0.5 * glowStrength), 0.163);
}

lavaStandColor(crustColor, glowColor) {
  return color.mixOklab(crustColor, glowColor, 0.163);
}

/// lava(crackScale, crustColor, glowColor, glowStrength, flowTimeScale,
/// crustDepth): lava(), plus one cheap noise.gradientBump crust-roughness
/// displacement `crustDepth` mm high — the displaced tier of lava, real
/// geometric relief on top of the already-animated color/material effect, so
/// the viewer marches the displaced band for it. See animated.lavaLake for
/// the lake's physics. Returns material, color.
lava(@range(2, 60) crackScale, @color crustColor, @color glowColor, glowStrength, flowTimeScale, @range(0.02, 1) crustDepth) {
  mat, col = lava(crackScale, crustColor, glowColor, glowStrength, flowTimeScale);
  // Too small to resolve, the crust fades flat; its slopes, 0.17 crustDepth
  // root mean square (measured), would barely widen a lobe already 0.9 rough.
  height = crustDepth * noise.gradientBump(crackScale * 0.5) * texture.fadeDetail(crackScale * 0.5);
  relief = material.withDisplacement(mat, height);
  relief.simple = lavaStandMaterial(glowColor, glowStrength);
  crust = col;
  crust.simple = lavaStandColor(crustColor, glowColor);
  return relief, crust;
}

/// fogMaterial(density, tintColor): a pure material-row (no noise, free)
/// surface approximation of fog — transmission and absorptionDistance eased
/// by `density` in [0,1]. Drape it over a caller-supplied soft blob-union or
/// slab shape; generating that geometry is out of scope here. Returns
/// material, color.
fogMaterial(@range(0, 1) density, @color tintColor) {
  d = clamp(density, 0, 1);
  transmission = 1.0 - d * 0.6;
  absorptionDist = 80.0 - d * 70.0;
  mat = material.translucent(material.make(0.9, 0, 1.4), transmission, absorptionDist);
  return mat, tintColor;
}

/// cloudMaterial(density, tintColor, puffScale, puffTimeScale, puffAmount):
/// an opaque, matte surface with one cheap noise.gradientBump4 puff
/// displacement, puffs `puffScale` mm across and `puffAmount` mm high, so it
/// visibly billows over time; `density` in [0,1] is how
/// soft it looks, roughness 0.7 for a thin wisp up to 1 for a dense cumulus.
/// It passes no light: see the package note. Drape over a caller-supplied
/// soft blob-union or slab shape. Returns material, color.
cloudMaterial(@range(0, 1) density, @color tintColor, @range(3, 60) puffScale, puffTimeScale, @range(0.1, 4) puffAmount) {
  matte = 0.7 + 0.3 * clamp(density, 0, 1);
  // Too small to resolve, the puffs fade flat and their slopes, 0.06
  // puffAmount root mean square (measured), widen the lobe instead.
  height = puffAmount * noise.gradientBump4(puffScale, puffTimeScale) * texture.fadeDetail(puffScale);
  puffed = sqrt(texture.reliefRoughness(matte * matte, 0.06 * puffAmount, puffScale));
  mat = material.withDisplacement(material.make(puffed, 0, 1.35), height);
  // Stand-in: the puffs too small to see, their slopes in the lobe.
  mat.simple = material.make(sqrt(sqrt(matte * matte * matte * matte + 0.0036 * puffAmount * puffAmount)), 0, 1.35);
  return mat, tintColor;
}

/// sand(grain): dry sand, its grains `grain` mm across (0.1 to 2; beach sand
/// is 0.3): the measured sand's rough matte and colour, with its grains as
/// fine relief 0.4 grain high at their crowns and one grain in twelve a dark
/// heavy mineral, both fine detail the viewer draws only up close. Too small
/// to resolve, the grains are no relief and the sand its mean colour, the
/// measured colour a twelfth of the way to the minerals'; the grains' slopes
/// add nothing to a roughness already 1. Returns material and colour.
sand(@range(0.1, 2) grain) {
  // Not named sandMat, sandColor: terrain receives this function's values
  // under those names, and multi-return inlining merges a caller's names
  // with the callee's locals of the same name.
  measured, measuredColor = physical.sand();
  mat = material.withDisplacement(measured, texture.grainRelief(grain, 0.4 * grain));
  minerals = [0.30, 0.26, 0.22];
  col = color.mixOklab(measuredColor, minerals, texture.grainSpecks(grain, 0.083));
  // Stand-ins: physical.sand's own record and colour, written out.
  mat.simple = material.make(1, 0, 1.5);
  col.simple = color.mixOklab([0.6944, 0.6546, 0.5176], minerals, 0.083);
  return mat, col;
}

/// terrain(scale, snowBias): a world map painted on any shape — continents
/// about `scale` mm across, with mountain chains raised along ridges, coloured
/// by height through sea, beach sand, grass and forest, granite rock and snow
/// (sand with its 0.3 mm grain, the measured grass and snow presets). Returns material, color and
/// height: the land's height in mm above sea level (negative out at sea,
/// where the colour deepens), proportional to scale, for relief. Subtract
/// max(height, 0) from a shape for real mountains, as Terrain Planet does, or
/// pass it to material.withDisplacement for render-only relief, as
/// raisedTerrain does to a stated peak height. The terrain bands sit at fixed
/// heights in units of scale / 12: grass from 0.2, rock
/// from 1.2 and snow from 2. snowBias is added to the height, in those units,
/// before the snow line only: 0 for none, or a field that grows toward the
/// poles (up to about 3) for polar caps.
terrain(@range(2, 200) scale, snowBias) {
  // Proportions of Terrain Planet, whose continents are 12 mm across.
  unit = scale / 12;
  continents = noise.fbmBump4(scale, 0.5, 2.0) - 0.25 * unit;
  ridges = noise.turbulenceBump2(scale / 4, 0.5, 2.0);
  height = 1.2 * continents + 2.2 * (0.45 * unit - ridges) * clamp(continents / unit, 0, 1);

  // Height with a little noise, so the bands between terrain types wander.
  band = (height + 0.25 * unit * noise.gradient(scale / 4)) / unit;
  seaLevel = height / unit;

  // Mixed once in Oklab and converted back once (see material/bulk/stone).
  shallowSea = color.rgb2oklab([0.10, 0.42, 0.52]);
  sea = shallowSea + (color.rgb2oklab([0.02, 0.07, 0.20]) - shallowSea) * clamp(-seaLevel / 1.2, 0, 1);
  sandMat, sandColor = sand(0.3);
  grassMat, grassColor = physical.grass();
  snowMat, snowColor = physical.snow();
  // Not named `grass`: a local sharing its name with a referenced package
  // member (physical.grass, used just above) hides that member from the WGSL
  // backend's capture of package values.
  grassLab = color.rgb2oklab(grassColor);
  meadow = grassLab + (color.rgb2oklab([0.13, 0.26, 0.09]) - grassLab) * texture.mask(noise.gradient(scale / 3), 0, 0.3);
  rock = color.rgb2oklab(stone.granite(0.6 * unit, [0.42, 0.40, 0.38], [0.22, 0.21, 0.20], [0.62, 0.60, 0.58]));
  coast = sea + (color.rgb2oklab(sandColor) - sea) * texture.mask(seaLevel, 0.0, 0.02);
  green = coast + (meadow - coast) * texture.mask(band, 0.2, 0.12);
  rocky = green + (rock - green) * texture.mask(band, 1.2, 0.25);
  land = rocky + (color.rgb2oklab(snowColor) - rocky) * texture.mask(band + snowBias, 2.0, 0.2);
  landColor = color.oklab2rgb(land);
  landColor.simple = terrainStandColor(snowBias);

  sandy = texture.paintMaterial(seaLevel, 0.0, 0.02, material.make(0.08, 0, 1.33), sandMat);
  grassy = texture.paintMaterial(band, 0.2, 0.12, sandy, grassMat);
  stony = texture.paintMaterial(band, 1.2, 0.25, grassy, stone.stoneFinish(0.8));
  landMat = texture.paintMaterial(band + snowBias, 2.0, 0.2, stony, snowMat);
  landMat.simple = terrainStandMaterial(snowBias);
  return landMat, landColor, height;
}

/// raisedTerrain(scale, peakHeight, snowBias): terrain with its land raised as
/// render-only relief, the highest summits about `peakHeight` mm, at any
/// exaggeration a raised-relief globe wants. The height field's summits reach
/// 0.207 scale (measured over a 50 mm sphere at scales 3, 24 and 40), so the
/// land is scaled by peakHeight / (0.207 scale). The viewer resolves relief to
/// about 3 mm high, three quarters of its 4 mm band; keep the peak under that.
/// Returns material and color.
raisedTerrain(@range(2, 200) scale, @range(0.1, 4) peakHeight, snowBias) {
  land, tint, height = terrain(scale, snowBias);
  rise = peakHeight / (0.207 * scale);
  // The land's own fine relief, the beach's grain, rides on the raised land.
  relief = material.withDisplacement(land, rise * max(height, 0) + material.displacement(land));
  // Stand-in: raised by the mean of the land's height above the sea, 0.112 of
  // the peak (0.925 mm against 8.28 at scale 40, measured), so the surface
  // stays where it was.
  relief.simple = material.withDisplacement(terrainStandMaterial(snowBias), 0.112 * peakHeight);
  return relief, tint;
}

// terrain's stand-ins: the painted colour's mean, Oklab [0.3796, -0.0065,
// -0.0341], and the material's, roughness 0.274 and index 1.39, measured over
// 12,288 points at scale 3 and no snow bias, where the sea covers 0.65 of the
// map, the sand 0.06, the grass 0.22, the rock 0.06 and the snow 0.01; the
// shares are scale-free. The snow's share grows as 0.01 + 0.09 snowBias^2
// (measured from 0 to 3), so both go toward the snow by what the bias adds.
terrainSnowShare(snowBias) {
  snow = clamp(0.01 + 0.09 * snowBias * snowBias, 0, 1);
  return clamp((snow - 0.01) / 0.99, 0, 1);
}

terrainStandColor(snowBias) {
  snowMat, snowColor = physical.snow();
  meanLab = [0.3796, -0.0065, -0.0341];
  return color.oklab2rgb(meanLab + (color.rgb2oklab(snowColor) - meanLab) * terrainSnowShare(snowBias));
}

terrainStandMaterial(snowBias) {
  snowMat, snowColor = physical.snow();
  return material.blend(material.make(0.274, 0, 1.39), snowMat, terrainSnowShare(snowBias));
}

// ===========================================================================
// Ready-made
// ===========================================================================

// One surface from each constructor above, with the arguments the examples
// use, so the material browser can show it. The constructors stay the way to
// set the parameters; see doc/material_composition.md for the plan to adjust
// them from the browser.

/// Water rippled by a light breeze, 8 mm ripples. Returns material and colour.
@material rippledWater() {
  mat, tint = water(8, 3.0, 0.15);
  return mat, tint;
}

/// Dry beach sand, 0.3 mm grains. Returns material and colour.
@material sand() {
  mat, col = sand(0.3);
  return mat, col;
}

/// Glowing lava under a cracked crust, 15 mm plates. Returns material and
/// colour.
@material glowingLava() {
  relief, crust = lava(15, [0.12, 0.09, 0.08], [1.0, 0.4, 0.05], 4.0, 5.0, 0.1);
  return relief, crust;
}

/// Fog at half density, a cool white. Returns material and colour.
@material fogMaterial() {
  fog, tint = fogMaterial(0.5, [0.9, 0.92, 0.95]);
  return fog, tint;
}

/// Cloud at six tenths density, white and opaque, 15 mm puffs billowing over
/// 10 s, 3 mm high. Returns material and colour.
@material cloudMaterial() {
  cloud, tint = cloudMaterial(0.6, [1, 1, 1], 15, 10, 3);
  return cloud, tint;
}

/// Terrain as a globe: continents 40 mm across, two or three across the face
/// of the 100 mm swatch, sea to snow, no polar bias, its land raised as
/// displacement to summits 2.5 mm high, as a raised-relief globe exaggerates.
/// Returns material and colour.
@material terrain() {
  land, tint = raisedTerrain(40, 2.5, 0);
  return land, tint;
}

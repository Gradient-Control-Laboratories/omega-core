/// A drum kit: kick, snare, clap, closed and open hi-hat, cymbal, toms, rim
/// and cowbell, each synthesized in closed form (pitch sweeps, decaying modes,
/// filtered noise, a cluster of inharmonic square waves for metal). Every
/// voice takes a hit from synth/seq ([age, vel, ...]: it plays from h.x = 0
/// and scales by h.y) plus optional tuning, and returns a mono signal of about
/// +-1 at full velocity. Use with seq.play, e.g.
///   seq.play(clk, pattern, (h) { return drum.snare(h); })
/// or call with any hand-made hit, such as [time - 1.5, 1, 0, 0, 1e9].

import "synth";

/// Kick: a sine whose pitch drops from 3.5x to tune Hz in a few tens of
/// milliseconds, a short noise click on the attack, and a little saturation
/// for punch. tune is the settled pitch in Hz (40-70), decayTime the body's
/// decay time constant in seconds (0.2-0.8).
kick(h, tune, decayTime) {
  body = sin(synth.glide(tune * 3.5, tune, 0.035, h.x)) * synth.decay(h.x, decayTime);
  click = synth.noiseHP(h.x) * synth.decay(h.x, 0.002) * 0.6;
  return synth.softclip((body + click) * 1.5, 1) * h.y;
}

/// Kick at 50 Hz with a 0.3 s decay.
kick(h) {
  return kick(h, 50, 0.3);
}

/// Snare: two damped drum-head modes (about 180 and 330 Hz, times tune) with a
/// slight pitch drop, plus high-passed noise for the wires. snappy (0-1) is the
/// balance of wires to head.
snare(h, tune, snappy) {
  head = (0.7 * sin(synth.glide(270 * tune, 180 * tune, 0.012, h.x)) + 0.4 * sin(synth.glide(430 * tune, 330 * tune, 0.012, h.x))) * synth.decay(h.x, 0.09);
  wires = (synth.noiseBP(h.x, 4500) * 1.6 + synth.noiseHP(h.x) * 0.3) * synth.decay(h.x, 0.14);
  return ((1 - snappy) * head + snappy * wires) * h.y;
}

/// Snare at standard tuning, a little more wires than head.
snare(h) {
  return snare(h, 1, 0.55);
}

/// Hand clap: three quick bursts of band-passed noise 11 ms apart, then a
/// longer tail, as several hands landing slightly out of time.
clap(h) {
  env = synth.decay(h.x, 0.006) + synth.decay(h.x - 0.011, 0.006) + synth.decay(h.x - 0.022, 0.006) + 0.7 * synth.decay(h.x - 0.033, 0.13);
  return synth.noiseBP(h.x, 1100) * env * 0.9 * h.y;
}

/// Six square waves at inharmonic frequencies (times tune), averaged: the
/// classic metallic cluster under hats, cymbals and cowbell.
metalFreqs = [205.3, 304.4, 369.6, 522.7, 540, 800];

/// The metal cluster at time t, in [-1, 1]. Unfiltered, it is a dull buzz;
/// metalHP is the bright version.
metal(t, tune) {
  return synth.sum(map((f) {
    return sign(sin(tau * f * tune * t));
  }, metalFreqs)) / 6;
}

/// The metal cluster high-passed (first difference at the noise rate), which
/// leaves the edges of the square waves: a bright, ringing hiss.
metalHP(t, tune) {
  return (metal(t, tune) - metal(t - 1 / synth.noiseRate, tune)) * 2;
}

// hat is the shared hi-hat body: metal plus a little noise, decaying with
// time constant d.
hat(h, tune, d) {
  return (0.3 * metalHP(h.x, tune) + 0.45 * synth.noiseHP(h.x)) * synth.decay(h.x, d) * h.y;
}

/// Closed hi-hat: short and tight. tune scales the metal cluster (1 = stock).
hatClosed(h, tune) {
  return hat(h, tune, 0.03);
}

/// Closed hi-hat at stock tuning.
hatClosed(h) {
  return hatClosed(h, 1);
}

/// Open hi-hat ringing for decayTime seconds (0.2-0.6). Choke it with the
/// closed-hat pattern: drum.hatOpen(h) * seq.choke(clk, closedPattern, h, 0.01).
hatOpen(h, tune, decayTime) {
  return hat(h, tune, decayTime);
}

/// Open hi-hat at stock tuning with a 0.35 s ring.
hatOpen(h) {
  return hatOpen(h, 1, 0.35);
}

/// Cymbal: the metal cluster tuned up and spread with more noise, with a long
/// decay (decayTime seconds, 1-3 for a crash).
cymbal(h, decayTime) {
  shimmer = 0.2 * metalHP(h.x, 1.47) + 0.2 * metalHP(h.x, 2.13) + 0.5 * synth.noiseHP(h.x);
  return shimmer * synth.ad(h.x, 0.002, decayTime) * 0.8 * h.y;
}

/// Crash cymbal with a 1.6 s decay.
cymbal(h) {
  return cymbal(h, 1.6);
}

/// Tom: a sine dropping from 1.8x to tune Hz, with a soft noise attack.
/// tune 80-200 Hz; decayTime 0.2-0.6 s.
tom(h, tune, decayTime) {
  body = sin(synth.glide(tune * 1.8, tune, 0.05, h.x)) * synth.decay(h.x, decayTime);
  stick = synth.noiseHP(h.x) * synth.decay(h.x, 0.006) * 0.3;
  return synth.softclip(body + stick, 1.2) * h.y;
}

/// Low, mid and high toms.
tomLow(h) {
  return tom(h, 90, 0.3);
}

tomMid(h) {
  return tom(h, 130, 0.25);
}

tomHigh(h) {
  return tom(h, 185, 0.2);
}

/// Rimshot: two bright, very short modes and a stick click.
rim(h) {
  body = (0.6 * sin(tau * 1720 * h.x) + sin(tau * 485 * h.x)) * synth.decay(h.x, 0.011);
  click = synth.noiseHP(h.x) * synth.decay(h.x, 0.003);
  return (body * 0.7 + click * 0.3) * h.y;
}

/// Cowbell: two band-limited square waves a fifth-ish apart (545 and 815 Hz,
/// times tune) through a band-pass at 900 Hz, with a fast drop to a short ring.
cowbell(h, tune) {
  tone = (synth.filtered(545 * tune, h.x, synth.squarePartials, synth.bandpass(900 * tune, 1.5)) + synth.filtered(815 * tune, h.x, synth.squarePartials, synth.bandpass(900 * tune, 1.5))) * 0.45;
  return tone * (0.65 * synth.decay(h.x, 0.025) + 0.35 * synth.decay(h.x, 0.22)) * h.y;
}

/// Cowbell at stock tuning.
cowbell(h) {
  return cowbell(h, 1);
}

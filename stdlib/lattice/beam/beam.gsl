/// Periodic 3D strut lattices (octet, fcc, kelvin and more) as the unsigned
/// distance to the strut skeleton.


// Beam Lattice Library (lattice/beam)
//
// Periodic strut lattices — 3D networks of infinitely thin beams that tile a
// scalar or vec3 `size` cell. Each returns the unsigned distance field to the strut
// skeleton; give the beams width with `lattice.solidify(field, bias)`, then
// intersect with a body to infill it.
//
// Translated from the Gradient Control Labs script-editor stdlib (GCL v1). The
// cubic-symmetry lattices fold the cell into its positive octant and reflect a
// representative set of struts (remap through map.patternRepeatMirror, GCL
// LineSegmentRepeatMirror); a few tile by plain translation
// (map.patternRepeat, GCL LineSegmentRepeat).
//
// NOTE: the symmetry remap must wrap the struts inline (in the same scope) — a
// list of struts passed through a helper is evaluated at the original point, and
// remap can no longer fold it. So each lattice inlines its own remap.
//
// Uses builtin's lineSegment primitive and booleans, and map for the
// symmetry patterns.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "map";

// --- public lattices ---

/// Octet truss: the stretch-dominated FCC strut lattice (cell corners to face
/// centers). scalar or vec3 `size` cell.
octet(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  return remap(unionSharp([
    lineSegment([0, h.y, 0], [0, 0, h.z]),
    lineSegment([h.x, 0, 0], [0, 0, h.z]),
    lineSegment([h.x, 0, 0], [0, h.y, 0]),
    lineSegment(h, [0, 0, h.z]),
    lineSegment(h, [0, h.y, 0]),
    lineSegment(h, [h.x, 0, 0])
  ]), map.patternRepeatMirror(size));
}

/// Truncated-octahedral (Kelvin-adjacent) strut lattice. scalar or vec3 `size` cell.
truncatedOctahedral(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  q = size * 0.25;
  third = size * (1.0 / 3.0);
  sixth = size * (1.0 / 6.0);
  c = [third.x, third.y, q.z];
  return remap(unionSharp([
    lineSegment(c, [sixth.x, sixth.y, h.z]),
    lineSegment(c, [sixth.x, h.y, 0]),
    lineSegment([h.x, sixth.y, 0], c),
    lineSegment(h, c),
    lineSegment([h.x, -sixth.y, 0], [h.x, sixth.y, 0]),
    lineSegment([-sixth.x, h.y, 0], [sixth.x, h.y, 0]),
    lineSegment([-sixth.x, sixth.y, h.z], [sixth.x, sixth.y, h.z]),
    lineSegment([sixth.x, -sixth.y, h.z], [sixth.x, sixth.y, h.z])
  ]), map.patternRepeatMirror(size));
}

/// Body-centered-cubic strut lattice: the cell-center-to-corner diagonal,
/// mirrored to all eight corners. scalar or vec3 `size` cell. (The new GCL-derived BCC;
/// the legacy lattice.bcc remains for substitution.)
bcc(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  return remap(lineSegment(h, -h), map.patternRepeatMirror(size));
}

/// Face-centered-cubic strut lattice: cell corner to the three near face
/// centers, mirrored. scalar or vec3 `size` cell.
fcc(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  return remap(unionSharp([
    lineSegment(h, [0, 0, h.z]),
    lineSegment(h, [0, h.y, 0]),
    lineSegment(h, [h.x, 0, 0])
  ]), map.patternRepeatMirror(size));
}

/// Truncated-cubic strut lattice. `setback` in [0, 1] pulls the strut endpoints
/// in from the cell edges (truncating the corners). scalar or vec3 `size` cell.
truncatedCubic(sizeIn, setback) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  s = 1 - setback;
  return remap(unionSharp([
    lineSegment([h.x, s * h.y, h.z], [s * h.x, h.y, h.z]),
    lineSegment([h.x, h.y, s * h.z], [s * h.x, h.y, h.z]),
    lineSegment([h.x, h.y, s * h.z], [h.x, s * h.y, h.z]),
    lineSegment([s * h.x, h.y, h.z], [0, h.y, h.z]),
    lineSegment([h.x, s * h.y, h.z], [h.x, 0, h.z]),
    lineSegment([h.x, h.y, s * h.z], [h.x, h.y, 0])
  ]), map.patternRepeatMirror(size));
}

/// Kelvin cell (tetrakaidecahedron) strut lattice. `setback` in [0, 1] sets the
/// hexagon/square truncation. scalar or vec3 `size` cell.
kelvinCell(sizeIn, setback) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  return remap(unionSharp([
    lineSegment([0, h.y, setback * h.z], [0, setback * h.y, h.z]),
    lineSegment([setback * h.x, 0, h.z], [0, setback * h.y, h.z]),
    lineSegment([setback * h.x, h.y, 0], [0, h.y, setback * h.z]),
    lineSegment([h.x, 0, setback * h.z], [setback * h.x, 0, h.z]),
    lineSegment([h.x, setback * h.y, 0], [setback * h.x, h.y, 0]),
    lineSegment([h.x, setback * h.y, 0], [h.x, 0, setback * h.z])
  ]), map.patternRepeatMirror(size));
}

/// Fluorite (CaF2-type) strut lattice. scalar or vec3 `size` cell.
fluorite(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  q = size * 0.25;
  return remap(unionSharp([
    lineSegment(q, [0, 0, h.z]),
    lineSegment(q, [0, h.y, 0]),
    lineSegment([h.x, 0, 0], q),
    lineSegment(h, q)
  ]), map.patternRepeatMirror(size));
}

/// Isotruss: orthogonal axis struts (translational) plus corner-to-face
/// diagonals (mirrored). scalar or vec3 `size` cell.
isotruss(sizeIn, combine) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  axes = remap(unionSharp([
    lineSegment([-h.x, 0, 0], [h.x, 0, 0]),
    lineSegment([0, -h.y, 0], [0, h.y, 0]),
    lineSegment([0, 0, -h.z], [0, 0, h.z])
  ]), map.patternRepeat(size));
  diags = remap(unionSharp([
    lineSegment(h, [0, h.y, h.z]),
    lineSegment(h, [h.x, 0, h.z]),
    lineSegment(h, [h.x, h.y, 0]),
    lineSegment(h, [0, 0, 0])
  ]), map.patternRepeatMirror(size));
  return combine([axes, diags]);
}

/// As isotruss, with its strut families unioned sharply. Pass a blend to
/// `isotruss(sizeIn, combine)` to fillet where they meet.
isotruss(sizeIn) {
  return isotruss(sizeIn, unionSharp);
}

/// Re-entrant (auxetic) strut lattice — inward-folded cell walls plus a central
/// Z column. `setback` in [0, 1] sets the fold depth. scalar or vec3 `size` cell.
reentrant(sizeIn, setback, combine) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  setbackZ = setback * h.z;
  recessedZ = 0.8 * h.z;
  walls = remap(unionSharp([
    lineSegment([0, h.y, setbackZ], [0, 0, recessedZ]),
    lineSegment([0, h.y, h.z], [0, h.y, setbackZ]),
    lineSegment([h.x, 0, setbackZ], [0, 0, recessedZ]),
    lineSegment([h.x, 0, h.z], [h.x, 0, setbackZ]),
    lineSegment([h.x, h.y, recessedZ], [0, h.y, setbackZ]),
    lineSegment([h.x, h.y, recessedZ], [h.x, 0, setbackZ]),
    lineSegment([h.x, h.y, recessedZ], [h.x, h.y, 0])
  ]), map.patternRepeatMirror(size));
  column = remap(lineSegment([0, 0, -recessedZ], [0, 0, recessedZ]), map.patternRepeat(size));
  return combine([walls, column]);
}

/// As reentrant, with its strut families unioned sharply. Pass a blend to
/// `reentrant(sizeIn, setback, combine)` to fillet where they meet.
reentrant(sizeIn, setback) {
  return reentrant(sizeIn, setback, unionSharp);
}

/// Simple cubic lattice: three orthogonal axis struts per cell, joined by
/// `combine`, tiled across the scalar or vec3 `size` grid.
cubic(sizeIn, combine) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  return remap(combine([
    lineSegment([-h.x, 0, 0], [h.x, 0, 0]),
    lineSegment([0, -h.y, 0], [0, h.y, 0]),
    lineSegment([0, 0, -h.z], [0, 0, h.z])
  ]), map.patternRepeat(size));
}

/// Simple cubic lattice with the three struts joined sharply.
cubic(sizeIn) {
  return cubic(sizeIn, unionSharp);
}

/// Grid of infinite vertical columns (z cylinders) on a rectangular XY lattice
/// `cell` ([cellX, cellY]). The thin field is the distance to the nearest column
/// axis; lattice.solidify turns it into cylinders. z passes through, so the
/// columns run the full height.
columnRectangular(cell) {
  o = map.patternRepeatXY(cell);
  return length(o.xy);
}

/// Infinite vertical columns on a triangular (6-neighbor close-packed) lattice
/// with nearest-neighbor `spacing`.
columnTriangular(spacing) {
  o = map.patternTriangularXY(spacing);
  return length(o.xy);
}

/// Infinite vertical columns on a hexagonal (honeycomb, 3-neighbor) lattice with
/// bond length `spacing`.
columnHexagonal(spacing) {
  o = map.patternHexagonalXY(spacing);
  return length(o.xy);
}

/// Double cubic: orthogonal axis struts (translational) plus corner-to-face
/// diagonals (mirrored) — a stiffer cubic variant. scalar or vec3 `size` cell.
cubicDouble(sizeIn) {
  size = sizeIn * [1, 1, 1];
  h = size * 0.5;
  axes = remap(unionSharp([
    lineSegment([-h.x, 0, 0], [h.x, 0, 0]),
    lineSegment([0, -h.y, 0], [0, h.y, 0]),
    lineSegment([0, 0, -h.z], [0, 0, h.z])
  ]), map.patternRepeat(size));
  diags = remap(unionSharp([
    lineSegment(h, [0, h.y, h.z]),
    lineSegment(h, [h.x, 0, h.z]),
    lineSegment(h, [h.x, h.y, 0])
  ]), map.patternRepeatMirror(size));
  return min(axes, diags);
}

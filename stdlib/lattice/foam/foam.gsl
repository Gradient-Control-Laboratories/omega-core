
// Foam Lattice Library (lattice/foam)
//
// Periodic wall (plate) lattices — space-filling networks of infinitely thin
// surfaces that tile a vec3 `size` cell. Each returns the unsigned distance to
// the wall skeleton; give the walls thickness with
// `lattice.thicken(field, thickness)`, then intersect with a body to infill it.
//
// `combine` is the operator that joins the wall families where they meet —
// `unionRound(k)` for a Euclidean fillet of k, or any other operator over a
// list of fields. Each lattice has a form without it that joins them sharply.
// Translated from the Gradient Control Labs script-editor stdlib
// (GCL v1): GridXYZ / GridXYDiagonal / Plane.
//
// Uses builtin's plane / unionRound and map for the symmetry patterns and
// triangle waves.
//
// Doc convention follows builtin/base.gsl: `///` lines are public docs.

import "map";

// --- internal: plane-family grids ---

// Rounded union of the three orthogonal triangle-wave plane families spaced by
// the vec3 `size`. GCL GridXYZ (UnionEuclideanVec of TriangleWaveEvenPositive).
gridXYZ(size, combine) {
  return combine([
    map.triangleWaveEvenPositive(p.x, size.x),
    map.triangleWaveEvenPositive(p.y, size.y),
    map.triangleWaveEvenPositive(p.z, size.z)
  ]);
}

// The two in-plane diagonal wall families of a cell (normals along the XY
// diagonals of `size`), joined by `combine`. GCL GridXYDiagonalCentered.
// Remap through a repeat pattern to tile. Uses plane(center, normal).
gridXYDiagonalCentered(size, combine) {
  return combine([
    abs(plane([0, 0, 0], [size.y, size.x, 0])),
    abs(plane([0, 0, 0], [size.y, -size.x, 0]))
  ]);
}

// --- public lattices ---

/// Cubic foam: the three orthogonal wall families of a vec3 `size` cell, with
/// junctions joined by `combine`. Boundary-phased (walls on cell boundaries).
cubic(size, combine) {
  return gridXYZ(size, combine);
}

/// Cubic foam with the three wall families joined sharply.
cubic(size) {
  return cubic(size, unionSharp);
}

/// Cubic foam, center-phased: the same three orthogonal wall families spaced by
/// the vec3 `size`, but with the walls on cell centers (the odd-phase sibling of
/// cubic, via triangleWaveOddPositive). Migrated from the flat lattice package's
/// cubicGrid; `combine` joins the plane families.
cubicGrid(size, combine) {
  dx = map.triangleWaveOddPositive(p.x, size.x);
  dy = map.triangleWaveOddPositive(p.y, size.y);
  dz = map.triangleWaveOddPositive(p.z, size.z);
  return combine([dx, dy, dz]);
}

/// Center-phased cubic foam with the three wall families joined sharply.
cubicGrid(size) {
  return cubicGrid(size, unionSharp);
}

/// Body-centered-cubic foam: the three sets of diagonal wall families (one per
/// coordinate plane), each tiled by translation, then joined. vec3 `size` cell;
/// `combine` joins the junctions.
bcc(size, combine) {
  m = map.patternRepeat(size);
  xy = remap(gridXYDiagonalCentered(size, combine), m);
  yz = remap(gridXYDiagonalCentered([size.y, size.z, 0], combine), [m.y, m.z, m.x]);
  zx = remap(gridXYDiagonalCentered([size.z, size.x, 0], combine), [m.z, m.x, m.y]);
  return combine([xy, yz, zx]);
}

/// Body-centered-cubic foam with the wall families joined sharply.
bcc(size) {
  return bcc(size, unionSharp);
}

/// Face-centered-cubic foam: the four {111}-type wall families (three corner
/// planes plus the cell cap), mirror-folded into the cell. vec3 `size` cell;
/// `combine` joins the junctions.
fcc(size, combine) {
  h = size * 0.5;
  return remap(combine([
    combine([
      abs(plane([0, 0, 0], [1, -1, -1])),
      abs(plane([0, 0, 0], [-1, 1, -1])),
      abs(plane([0, 0, 0], [-1, -1, 1]))
    ]),
    abs(plane([0, h.y, h.z], [1, 1, 1]))
  ]), map.patternRepeatMirror(size));
}

/// Face-centered-cubic foam with the wall families joined sharply.
fcc(size) {
  return fcc(size, unionSharp);
}
